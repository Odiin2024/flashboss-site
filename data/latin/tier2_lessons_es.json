        "total_pages": 4,
        "content": [
          "Dos grafías que van por un solo camino:",
          "",
          "ch = k de 'kilo'              Presiona 1",
          "   pulcher — PUL-ker, 'hermoso'",
          "",
          "ae = ai de 'aire', oe = oi    Presiona 2",
          "   aetās — AI-tas, 'edad'",
          "   foedus — FOI-dus, 'pacto'",
          "",
