          "في لغة Toki Pona نظامان للعدد.",
          "",
          "النظام التقريبي (وهو الأشيع):",
          "\u200ewan = واحد          tu = اثنان",
          "\u200emute = كثير، عدة     ale = كل",
          "",
          "نظام العد التقليدي (دقيق، تجمع فيه",
          "الأعداد بعضها إلى بعض):",
          "\u200eluka = خمسة      tu wan = 3 (2+1)",
          "tu tu = 4 (2+2)    luka luka = 10",
          "",
          "وللأعداد الترتيبية توضع nanpa قبل العدد:",
          "\u200enanpa wan = الأول",
          "\u200enanpa tu  = الثاني",
          "",
          "والاسم لا يتغير مع العدد، فلا مثنى ولا جمع:",
          "\u200ejan tu = شخصان    jan mute = ناس كثيرون"
        ],
        "pronunciation": "nanpa wan"
      },
      {
        "page": 2,
        "total_pages": 2,
        "content": [
          "الألوان، وفكرة الأدوات القليلة:",
          "",
          "لا تسمي لغة Toki Pona إلا خمسة ألوان:",
          "\u200eloje = أحمر        jelo = أصفر",
          "\u200elaso = أزرق أو أخضر   walo = أبيض",
          "\u200epimeja = أسود",
          "",
          "والكلمة kule تعني «لون» أو «نوع» عموما،",
          "ولا كلمة مستقلة للبنفسجي أو البرتقالي.",
          "",
          "وهذا هو التصميم كله: أدوات قليلة لا قاموس",
          "كبير، والسياق والتركيب يصنعان كل الدرجات",
          "التي تفرقها العربية بأسماء كثيرة."
        ],
        "pronunciation": "kule"
      }
    ]
