    "lesson_id": "007",
    "trigger_word": "wile",
    "title": "LEKTION 7: PRÄVERBEN FÄRBEN",
    "header_color": "green",
    "pages": [
      {
        "page": 1,
        "total_pages": 1,
        "content": [
          "Ein Präverb steht VOR dem Hauptverb",
          "und färbt seine Bedeutung:",
          "",
          "wile = wollen/müssen   ken = können",
          "kama = werden, dazu kommen",
          "sona = wissen wie",
          "alasa = versuchen     awen = weiter",
          "",
          "mi wile moku.  = Ich will essen.",
          "",
          "mi wile e ni: sina kama pona.",
          "= Ich will dies: dass du gesund wirst.",
          "",
          "Reihe das schlichte Verb direkt hinter",
          "das Präverb - keine eigene Konjugation,",
          "nur ein Extrawort erledigt es."
        ],
        "pronunciation": "mi wile moku"
      }
    ]
  }
