    "title": "LEKTION 7: DER IMPÉRATIF",
    "header_color": "green",
    "pages": [
      {
        "page": 1,
        "total_pages": 2,
        "content": [
          "L'IMPÉRATIF drückt Befehle aus — lass",
          "einfach das Subjektpronomen des Präsens",
          "weg. Drei Formen: tu, nous, vous.",
          "",
          "-ER-Verben VERLIEREN -s bei tu:     Drücke 1",
          "tu parles → Parle ! (Sprich!)",
          "nous parlons → Parlons ! (Sprechen wir!)",
          "vous parlez → Parlez ! (Sprecht!)",
          "",
          "-IR/-RE-Verben BEHALTEN das -s:     Drücke 2",
          "tu finis → Finis ! (Mach fertig!)",
          "tu vends → Vends ! (Verkauf!)"
        ],
        "pronunciation": "Leçon sept",
        "pronunciation_mappings": {
          "1": "parle, parlons, parlez",
          "2": "finis, vends"
        }
      },
      {
        "page": 2,
        "total_pages": 2,
        "content": [
          "VIER UNREGELMÄSSIGE IMPERATIVE zum",
          "Auswendiglernen — sie lassen nicht",
          "nur das Pronomen weg:",
          "",
          "ÊTRE:                               Drücke 1",
          "sois, soyons, soyez",
          "",
          "AVOIR:                              Drücke 2",
          "aie, ayons, ayez",
          "",
          "SAVOIR:                             Drücke 3",
          "sache, sachons, sachez",
          "",
          "ALLER:                              Drücke 4",
          "va, allons, allez",
          "",
          "Ferme la porte ! (Mach die Tür zu!)",
          "Écoute ! (Hör zu!)"
        ],
        "pronunciation_mappings": {
          "1": "sois, soyons, soyez",
          "2": "aie, ayons, ayez",
          "3": "sache, sachons, sachez",
          "4": "va, allons, allez"
        }
      }
    ]
  },
