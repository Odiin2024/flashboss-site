    "header_color": "green",
    "pages": [
      {
        "page": 1,
        "total_pages": 1,
        "content": [
          "FUTUR PROCHE — der einfachste Weg, über",
          "die Zukunft zu sprechen: wörtlich 'ich",
          "gehe ... machen', wie im Englischen.",
          "",
          "aller (Präsens) + Infinitiv:",
          "",
          "Je vais commander.                  Drücke 1",
          "(Ich werde bestellen.)",
          "Tu vas payer.                       Drücke 2",
          "(Du wirst zahlen.)",
          "Nous allons acheter des légumes.    Drücke 3",
          "(Wir werden Gemüse kaufen.)",
          "",
          "VERNEINUNG — ne...pas umschließt",
          "nur 'aller':",
          "Je ne vais pas commander.           Drücke 4",
          "(Ich werde nicht bestellen.)"
        ],
        "pronunciation": "Leçon neuf",
        "pronunciation_mappings": {
          "1": "je vais commander",
          "2": "tu vas payer",
          "3": "nous allons acheter des légumes",
          "4": "je ne vais pas commander"
        }
      }
    ]
  },
