    "trigger_card_number": 2001,
    "title": "\u0627\u0644\u062f\u0631\u0633 30: TU \u0648 VOUS \u0648\u0627\u0644\u0645\u0642\u0627\u0645",
    "header_color": "green",
    "pages": [
      {
        "page": 1,
        "total_pages": 2,
        "content": [
          "\u0623\u0647\u0644\u0627 \u0628\u0643 \u0641\u064a French Pareto 2\u060c \u062d\u0632\u0645\u0629 \u0627\u0644\u0625\u062a\u0642\u0627\u0646\u060c",
          "\u0648\u0645\u062d\u0648\u0631\u0647\u0627 \u0627\u0644\u062a\u0646\u0642\u0644 \u0628\u064a\u0646 \u0627\u0644\u0645\u0642\u0627\u0645\u0627\u062a (\u0627\u0644\u0623\u0633\u0627\u0644\u064a\u0628).",
          "",
          "\u0627\u0644\u0641\u0643\u0631\u0629 \u0627\u0644\u0648\u0627\u062d\u062f\u0629 \u0641\u064a \u062b\u0644\u0627\u062b\u0629 \u0645\u0642\u0627\u0645\u0627\u062a:",
          "",
          "\u200eTU: \u0628\u0644\u0627 \u0643\u0644\u0641\u0629\u060c \u0644\u0644\u0645\u0642\u0631\u0628\u064a\u0646\u060c \u064a\u0648\u0645\u064a\u200f\u200e       \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 1",
          "\u200eTu en penses quoi ?\u200e",
          "\u200e   = \u0645\u0627 \u0631\u0623\u064a\u0643\u061f",
          "",
          "\u200eVOUS: \u0631\u0633\u0645\u064a\u060c \u0644\u0644\u063a\u0631\u0628\u0627\u0621 \u0648\u0641\u064a \u0627\u0644\u0639\u0645\u0644\u200f\u200e      \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 2",
          "\u0648\u0645\u0639 \u0627\u0644\u0645\u0624\u0633\u0633\u0627\u062a\u060c \u0648\u0647\u064a \u00ab\u0623\u0646\u062a\u0645\u00bb \u0644\u0644\u0627\u062d\u062a\u0631\u0627\u0645:",
          "\u200eQu'en pensez-vous ?\u200e",
          "\u200e   = \u0645\u0627 \u0631\u0623\u064a\u0643\u0645\u061f (\u0627\u0644\u0645\u0639\u0646\u0649 \u0646\u0641\u0633\u0647 \u0628\u0623\u062f\u0628)",
          "",
          "\u200eSOUTENU: \u0627\u0644\u0623\u0633\u0644\u0648\u0628 \u0627\u0644\u0631\u0641\u064a\u0639\u200f\u200e            \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 3",
          "\u0644\u0644\u0645\u0642\u0627\u0644\u0627\u062a \u0648\u0627\u0644\u0642\u0627\u0646\u0648\u0646 \u0648\u0627\u0644\u062e\u0637\u0628 \u0627\u0644\u0631\u0633\u0645\u064a\u0629:",
          "\u200eQuel est votre avis \u00e0 cet \u00e9gard ?\u200e",
          "\u200e   = \u0645\u0627 \u0631\u0623\u064a\u0643\u0645 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0634\u0623\u0646\u061f"
        ],
        "pronunciation": "Le\u00e7on trente",
        "pronunciation_mappings": {
          "1": "tu en penses quoi",
          "2": "qu'en pensez-vous",
          "3": "quel est votre avis \u00e0 cet \u00e9gard"
        }
      },
      {
        "page": 2,
        "total_pages": 2,
        "content": [
          "\u0627\u0644\u0631\u0633\u0627\u0644\u0629 \u0646\u0641\u0633\u0647\u0627 \u0641\u064a \u0645\u062b\u0627\u0644 \u0622\u062e\u0631\u060c",
          "\u0648\u0647\u0648 \u0637\u0644\u0628 \u0627\u0644\u0645\u0633\u0627\u0639\u062f\u0629:",
          "",
          "\u200eTU:                                \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 1",
          "\u200eTu peux m'aider ?\u200e = \u0647\u0644 \u064a\u0645\u0643\u0646\u0643 \u0645\u0633\u0627\u0639\u062f\u062a\u064a\u061f",
          "",
          "\u200eVOUS:                              \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 2",
          "\u200ePourriez-vous m'aider ?\u200e = \u0647\u0644 \u064a\u0645\u0643\u0646\u0643\u0645 \u0645\u0633\u0627\u0639\u062f\u062a\u064a\u061f",
          "",
          "\u200eSOUTENU:                           \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 3",
          "\u200eAuriez-vous l'amabilit\u00e9 de m'aider ?\u200e",
          "\u200e   = \u0647\u0644 \u062a\u062a\u0643\u0631\u0645\u0648\u0646 \u0628\u0645\u0633\u0627\u0639\u062f\u062a\u064a\u061f",
          "\u0648\u0644\u0644\u0639\u0631\u0628\u064a\u0629 \u0633\u0644\u0645 \u0645\u0634\u0627\u0628\u0647: \u00ab\u0647\u0644 \u064a\u0645\u0643\u0646\u0643\u00bb \u0644\u0644\u0642\u0631\u064a\u0628\u060c",
          "\u0648\u00ab\u0647\u0644 \u062a\u062a\u0643\u0631\u0645\u0648\u0646\u00bb \u0641\u064a \u0627\u0644\u0645\u062e\u0627\u0637\u0628\u0627\u062a \u0627\u0644\u0631\u0633\u0645\u064a\u0629.",
          "\u0648\u064a\u0645\u064a\u0644 \u0627\u0644\u0623\u0633\u0644\u0648\u0628 \u0627\u0644\u0631\u0641\u064a\u0639 \u0625\u0644\u0649 \u062a\u0642\u062f\u064a\u0645 \u0627\u0644\u0641\u0639\u0644 \u0639\u0644\u0649",
          "\u0627\u0644\u0636\u0645\u064a\u0631 (\u0627\u0644\u062f\u0631\u0633 25)\u060c \u0648\u0625\u0644\u0649 ne...pas \u0643\u0627\u0645\u0644\u0629\u060c",
          "\u0648\u0625\u0644\u0649 \u0627\u0644\u062c\u0645\u0644 \u0627\u0644\u062a\u0627\u0628\u0639\u0629 \u0627\u0644\u0637\u0648\u064a\u0644\u0629. \u0648\u0633\u062a\u0646\u0628\u0647 \u0627\u0644\u0645\u0644\u0627\u062d\u0638\u0627\u062a",
          "\u0639\u0644\u0649 \u0623\u0632\u0648\u0627\u062c \u0627\u0644\u0645\u0642\u0627\u0645\u0627\u062a \u0645\u0646 \u0627\u0644\u0622\u0646 \u0641\u0635\u0627\u0639\u062f\u0627."
        ],
        "pronunciation_mappings": {
          "1": "tu peux m'aider",
          "2": "pourriez-vous m'aider",
          "3": "auriez-vous l'amabilit\u00e9 de m'aider"
        }
      }
    ]
  },
  {
    "lesson_id": "031",
    "trigger_word": "diff\u00e9remment",
    "trigger_card_number": 2197,
    "title": "\u0627\u0644\u062f\u0631\u0633 31: \u0641\u0643\u0631\u0629 \u0648\u0627\u062d\u062f\u0629 \u0628\u062b\u0644\u0627\u062b \u0635\u064a\u063a",
    "header_color": "green",
    "pages": [
      {
        "page": 1,
        "total_pages": 2,
        "content": [
          "\u0645\u0631\u0627\u062c\u0639\u0629 \u0627\u0644\u0645\u0642\u0627\u0645\u0627\u062a: \u0641\u0643\u0631\u0629 \u0648\u0627\u062d\u062f\u0629 \u0641\u064a \u062b\u0644\u0627\u062b \u062d\u0644\u0644\u060c",
          "\u0628\u0635\u064a\u063a\u0629 \u0627\u0644\u0634\u0631\u0637 \u0627\u0644\u0645\u0627\u0636\u064a\u0629 (\u0627\u0644\u062f\u0631\u0633 28):",
          "",
          "\u200eTU: \u0628\u064a\u0646 \u0627\u0644\u0623\u0635\u062f\u0642\u0627\u0621\u060c \u0628\u0644\u0627 \u0643\u0644\u0641\u0629\u200f\u200e         \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 1",
          "\u200eOn aurait d\u00fb s'y prendre autrement, non ?\u200e",
          "\u200e   = \u0643\u0627\u0646 \u0639\u0644\u064a\u0646\u0627 \u0623\u0646 \u0646\u0641\u0639\u0644\u0647\u0627 \u0628\u0637\u0631\u064a\u0642\u0629 \u0623\u062e\u0631\u0649\u060c \u0635\u062d\u064a\u062d\u061f",
          "",
          "\u200eVOUS: \u0628\u064a\u0646 \u0627\u0644\u0632\u0645\u0644\u0627\u0621 \u0648\u0627\u0644\u0645\u0639\u0627\u0631\u0641\u200f\u200e         \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 2",
          "\u200eNous aurions d\u00fb nous y prendre",
          "\u200ediff\u00e9remment, n'est-ce pas ?\u200e",
          "\u200e   = \u0643\u0627\u0646 \u064a\u0646\u0628\u063a\u064a \u0623\u0646 \u0646\u0639\u0627\u0644\u062c \u0627\u0644\u0623\u0645\u0631 \u0628\u0637\u0631\u064a\u0642\u0629",
          "\u200e     \u0645\u062e\u062a\u0644\u0641\u0629\u060c \u0623\u0644\u064a\u0633 \u0643\u0630\u0644\u0643\u061f",
          "",
          "\u200eSOUTENU: \u0644\u0644\u0643\u062a\u0627\u0628\u0629 \u0648\u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631\u200f\u200e         \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 3",
          "\u200eIl aurait \u00e9t\u00e9 pr\u00e9f\u00e9rable de",
          "\u200eproc\u00e9der diff\u00e9remment.\u200e",
          "\u200e   = \u0643\u0627\u0646 \u0645\u0646 \u0627\u0644\u0623\u0641\u0636\u0644 \u0627\u062a\u0628\u0627\u0639 \u0646\u0647\u062c \u0645\u062e\u062a\u0644\u0641"
        ],
        "pronunciation": "Le\u00e7on trente et un",
        "pronunciation_mappings": {
          "1": "on aurait d\u00fb s'y prendre autrement, non",
          "2": "nous aurions d\u00fb nous y prendre diff\u00e9remment, n'est-ce pas",
          "3": "il aurait \u00e9t\u00e9 pr\u00e9f\u00e9rable de proc\u00e9der diff\u00e9remment"
        }
      },
      {
        "page": 2,
        "total_pages": 2,
        "content": [
          "\u0639\u0644\u0627\u0645\u0627\u062a \u0633\u0631\u064a\u0639\u0629 \u062a\u0643\u0634\u0641 \u0627\u0644\u0645\u0642\u0627\u0645:",
          "",
          "\u200eTU:                                \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 1",
          "\u0627\u0633\u062a\u0639\u0645\u0627\u0644 on \u0628\u062f\u0644 nous\u060c \u0648\u0645\u0641\u0631\u062f\u0627\u062a \u0639\u0641\u0648\u064a\u0629\u060c",
          "\u0648\u0623\u0633\u0626\u0644\u0629 \u0642\u0635\u064a\u0631\u0629\u060c \u0648\u0645\u0646\u0627\u062f\u0627\u0629 \u0628\u0627\u0644\u0627\u0633\u0645 \u0627\u0644\u0623\u0648\u0644.",
          "\u200eVOUS:                              \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 2",
          "\u0636\u0645\u064a\u0631 nous \u0635\u0631\u064a\u062d\u0627\u060c \u0648\u0623\u0644\u0642\u0627\u0628 \u0631\u0633\u0645\u064a\u0629\u060c",
          "\u0648\u0635\u064a\u063a\u0629 \u0627\u0644\u0634\u0631\u0637 (conditionnel) \u0644\u0644\u062a\u0623\u062f\u0628.",
          "\u200eSOUTENU:                           \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 3",
          "\u062a\u0642\u062f\u064a\u0645 \u0627\u0644\u0641\u0639\u0644 \u0639\u0644\u0649 \u0627\u0644\u0636\u0645\u064a\u0631\u060c \u0648\u062c\u0645\u0644 \u062a\u0627\u0628\u0639\u0629\u060c",
          "\u0648\u0644\u0627 \u064a\u0633\u062a\u0639\u0645\u0644 \u0641\u064a\u0647 on \u0628\u0645\u0639\u0646\u0649 nous \u0623\u0628\u062f\u0627.",
          "",
          "\u0627\u0644\u0645\u0636\u0645\u0648\u0646 \u0648\u0627\u062d\u062f \u0648\u0627\u0644\u062d\u0644\u0629 \u0645\u062e\u062a\u0644\u0641\u0629\u060c \u0648\u0647\u0630\u0627 \u0627\u0644\u0646\u0645\u0637",
          "\u064a\u0631\u0627\u0641\u0642\u0643 \u0641\u064a \u0643\u0644 \u0645\u0631\u062d\u0644\u0629 \u0645\u0646 \u0647\u0646\u0627 \u0625\u0644\u0649 \u0627\u0644\u0642\u0645\u0629.",
          "",
          "\u0648\u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u062a\u0639\u0631\u0641 \u0647\u0630\u0627 \u062c\u064a\u062f\u0627: \u0641\u062d\u062f\u064a\u062b \u0627\u0644\u0623\u0635\u062f\u0642\u0627\u0621 \u063a\u064a\u0631",
          "\u0644\u063a\u0629 \u0627\u0644\u0631\u0633\u0627\u0644\u0629 \u0627\u0644\u0631\u0633\u0645\u064a\u0629\u060c \u0648\u0627\u0644\u0641\u0631\u0646\u0633\u064a\u0629 \u0643\u0630\u0644\u0643."
        ],
        "pronunciation_mappings": {
          "1": "on, tu penses quoi",
          "2": "vous, nous aurions d\u00fb",
          "3": "l'inversion, la subordination"
        }
      }
    ]
  }
