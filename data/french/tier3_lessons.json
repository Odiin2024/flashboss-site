    "title": "LESSON 14: EST — A HOMOGRAPH",
    "header_color": "green",
    "pages": [
      {
        "page": 1,
        "total_pages": 1,
        "content": [
          "EST — one spelling, TWO different",
          "words, and they even SOUND",
          "different:",
          "",
          "il est (verb 'to be') = [ɛ]         Press 1",
          "— the final -st is SILENT",
          "   Il est ici. (He is here.)",
          "",
          "l'est (noun, 'east') = [ɛst]        Press 2",
          "— the final -st IS pronounced",
          "   Il habite à l'est. (He lives",
          "in the east.)",
          "",
          "Context always tells them apart —",
          "the noun never follows a subject",
          "pronoun the way the verb does."
        ],
        "pronunciation": "Leçon quatorze",
        "pronunciation_mappings": {
          "1": "il est ici",
          "2": "il habite à l'est"
        }
      }
    ]
  }
]
