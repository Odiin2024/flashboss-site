[
  {
    "lesson_id": "017",
    "trigger_word": "remplir",
    "trigger_card_number": 803,
    "title": "\u0627\u0644\u062f\u0631\u0633 17: \u0645\u062f\u062e\u0644 \u0625\u0644\u0649 subjonctif",
    "header_color": "green",
    "pages": [
      {
        "page": 1,
        "total_pages": 2,
        "content": [
          "\u0635\u064a\u063a\u0629 subjonctif (\u0635\u064a\u063a\u0629 \u0627\u0644\u0627\u062d\u062a\u0645\u0627\u0644) \u0635\u064a\u063a\u0629 \u0644\u0627 \u0632\u0645\u0646\u060c",
          "\u0644\u0644\u0648\u062c\u0648\u0628 \u0648\u0627\u0644\u0631\u063a\u0628\u0629 \u0648\u0627\u0644\u0634\u0643\u060c \u0648\u0623\u0642\u0631\u0628 \u0645\u0627 \u064a\u0642\u0627\u0628\u0644\u0647\u0627",
          "\u0627\u0644\u0645\u0636\u0627\u0631\u0639 \u0627\u0644\u0645\u0646\u0635\u0648\u0628 \u0628\u0639\u062f \u00ab\u0623\u0646\u00bb. \u0648\u064a\u0643\u0641\u064a \u0627\u0644\u0622\u0646",
          "\u0623\u0634\u064a\u0639 \u0645\u0641\u0627\u062a\u064a\u062d\u0647\u0627: il faut que (\u064a\u062c\u0628 \u0623\u0646).",
          "",
          "\u200e\u200f\u0627\u0644\u062a\u0643\u0648\u064a\u0646:\u200f\u200e                         \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 1",
          "\u0645\u0646 \u0635\u064a\u063a\u0629 ils \u0641\u064a \u0627\u0644\u0645\u0636\u0627\u0631\u0639 \u062a\u062d\u0630\u0641 -ent\u060c \u062b\u0645 \u062a\u0636\u0627\u0641:",
          "\u200e-e, -es, -e, -ions, -iez, -ent",
          "\u0623\u0645\u0627 nous \u0648 vous \u0641\u0645\u0646 \u062c\u0630\u0631 nous \u0641\u064a \u0627\u0644\u0645\u0636\u0627\u0631\u0639:",
          "\u200e(nous prenons \u2192) que nous prenions",
          "",
          "\u200eremplir \u2192 ils remplissent \u2192",
          "\u200eil faut que je remplisse         \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 2",
          "\u200e   = \u064a\u062c\u0628 \u0623\u0646 \u0623\u0645\u0644\u0623",
          "\u200eil faut que vous remplissiez la fiche.",
          "\u200e   = \u064a\u062c\u0628 \u0623\u0646 \u062a\u0645\u0644\u0624\u0648\u0627 \u0627\u0644\u0627\u0633\u062a\u0645\u0627\u0631\u0629",
          "\u0648\u0647\u0630\u0627 \u0642\u0631\u064a\u0628 \u0645\u0646 \u0646\u0635\u0628 \u0627\u0644\u0645\u0636\u0627\u0631\u0639 \u0628\u0639\u062f \u00ab\u0623\u0646\u00bb \u0641\u064a \u0627\u0644\u0639\u0631\u0628\u064a\u0629."
        ],
        "pronunciation": "Le\u00e7on dix-sept",
        "pronunciation_mappings": {
          "1": "-e, -es, -e, -ions, -iez, -ent",
          "2": "il faut que je remplisse, il faut que vous remplissiez la fiche"
        }
      },
      {
        "page": 2,
        "total_pages": 2,
        "content": [
          "\u0645\u0641\u0627\u062a\u064a\u062d \u0623\u062e\u0631\u0649 \u0634\u0627\u0626\u0639\u0629:",
          "",
          "\u200evouloir que (\u064a\u0631\u064a\u062f \u0623\u0646)\u200f\u200e             \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 1",
          "\u200eJe veux que tu viennes.",
          "\u200e   = \u0623\u0631\u064a\u062f \u0623\u0646 \u062a\u0623\u062a\u064a",
          "",
          "\u200eavant que (\u0642\u0628\u0644 \u0623\u0646)\u200f\u200e                \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 2",
          "\u200eSignez avant que le bureau ferme.",
          "\u200e   = \u064a\u0631\u062c\u0649 \u0627\u0644\u062a\u0648\u0642\u064a\u0639 \u0642\u0628\u0644 \u0623\u0646 \u064a\u063a\u0644\u0642 \u0627\u0644\u0645\u0643\u062a\u0628",
          "",
          "\u200e\u200f\u0635\u064a\u063a \u063a\u064a\u0631 \u0642\u064a\u0627\u0633\u064a\u0629 \u062a\u0644\u0632\u0645 \u0645\u0639\u0631\u0641\u062a\u0647\u0627:\u200f\u200e      \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 3",
          "\u200e\u00eatre \u2192 sois, soit, soyons...",
          "\u200eavoir \u2192 aie, ait, ayons...",
          "\u200ealler \u2192 aille, allions...",
          "\u200efaire \u2192 fasse, fassions...",
          "",
          "\u0627\u0644\u062a\u0639\u0631\u0641 \u0639\u0644\u064a\u0647\u0627 \u0623\u0648\u0644\u0627\u060c \u0623\u0645\u0627 \u0627\u0633\u062a\u0639\u0645\u0627\u0644\u0647\u0627 \u0628\u0637\u0644\u0627\u0642\u0629",
          "\u0641\u064a\u0623\u062a\u064a \u0645\u0639 \u0643\u062b\u0631\u0629 \u0627\u0644\u0633\u0645\u0627\u0639 \u0648\u0627\u0644\u0642\u0631\u0627\u0621\u0629."
        ],
        "pronunciation_mappings": {
          "1": "je veux que tu viennes",
          "2": "signez avant que le bureau ferme",
          "3": "que je sois, que j'aie, que j'aille, que je fasse"
        }
      }
    ]
  },
  {
    "lesson_id": "018",
    "trigger_word": "h\u00e9ros",
    "trigger_card_number": 841,
    "title": "\u0627\u0644\u062f\u0631\u0633 18: h\u00e9ros \u0623\u0645 h\u00e9ro\u00efne",
    "header_color": "green",
    "pages": [
      {
        "page": 1,
        "total_pages": 1,
        "content": [
          "\u0623\u0648\u0636\u062d \u0645\u062b\u0627\u0644 \u0639\u0644\u0649 h aspir\u00e9: \u062c\u0630\u0631 \u0648\u0627\u062d\u062f",
          "\u0648\u0633\u0644\u0648\u0643\u0627\u0646 \u0645\u062a\u0639\u0627\u0643\u0633\u0627\u0646.",
          "",
          "\u200ele h\u00e9ros, h aspir\u00e9 (\u0628\u0637\u0644)\u200f\u200e         \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 1",
          "\u0644\u0627 \u062d\u0630\u0641: \u064a\u0642\u0627\u0644 le h\u00e9ros\u060c \u0644\u0627 l'h\u00e9ros",
          "\u0648\u0644\u0627 \u0648\u0635\u0644 (liaison) \u0641\u064a\u0642\u0627\u0644: les h\u00e9ros [le e\u0281o]",
          "\u200el'h\u00e9ro\u00efne, h muet (\u0628\u0637\u0644\u0629)\u200f\u200e         \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 2",
          "\u062d\u0630\u0641 \u0639\u0627\u062f\u064a\u060c \u0643\u0623\u064a \u0643\u0644\u0645\u0629 \u062a\u0628\u062f\u0623 \u0628\u062d\u0631\u0641 \u0639\u0644\u0629:",
          "\u200el'h\u00e9ro\u00efne, les h\u00e9ro\u00efnes [le.z\u203fe.\u0281\u0254.in]",
          "",
          "\u0639\u0627\u0626\u0644\u0629 \u0648\u0627\u062d\u062f\u0629 \u0648\u062d\u0631\u0641 h \u0645\u062e\u062a\u0644\u0641\u060c \u0648\u0644\u0627 \u0633\u0628\u064a\u0644",
          "\u0625\u0644\u0649 \u0645\u0639\u0631\u0641\u062a\u0647 \u0645\u0646 \u0627\u0644\u0643\u062a\u0627\u0628\u0629\u060c \u0628\u0644 \u064a\u062d\u0641\u0638 \u0645\u0639 \u0643\u0644",
          "\u0643\u0644\u0645\u0629\u060c \u0643\u0645\u0627 \u0645\u0631 \u0645\u0639 honte \u0641\u064a \u0627\u0644\u0645\u0631\u062d\u0644\u0629 3.",
          "\u0641\u062d\u0631\u0641 h aspir\u00e9 \u0644\u0627 \u064a\u0644\u0641\u0638\u060c \u0644\u0643\u0646\u0647 \u064a\u0645\u0646\u0639 \u0627\u0644\u062d\u0630\u0641 \u0648\u0627\u0644\u0648\u0635\u0644."
        ],
        "pronunciation": "Le\u00e7on dix-huit",
        "pronunciation_mappings": {
          "1": "le h\u00e9ros",
          "2": "l'h\u00e9ro\u00efne"
        }
      }
    ]
  },
  {
    "lesson_id": "019",
    "trigger_word": "charger",
    "trigger_card_number": 851,
    "title": "\u0627\u0644\u062f\u0631\u0633 19: \u0627\u0644\u0645\u0633\u062a\u0642\u0628\u0644 \u0627\u0644\u0628\u0633\u064a\u0637",
    "header_color": "green",
    "pages": [
      {
        "page": 1,
        "total_pages": 2,
        "content": [
          "\u0627\u0644\u0645\u0633\u062a\u0642\u0628\u0644 \u0627\u0644\u0628\u0633\u064a\u0637 (futur simple) \u064a\u0642\u0627\u0628\u0644 \u062a\u0642\u0631\u064a\u0628\u0627",
          "\u00ab\u0633\u0640\u00bb \u0648\u00ab\u0633\u0648\u0641\u00bb \u0641\u064a \u0627\u0644\u0639\u0631\u0628\u064a\u0629. \u0648\u0646\u0647\u0627\u064a\u0627\u062a\u0647 \u0648\u0627\u062d\u062f\u0629",
          "\u0641\u064a \u0643\u0644 \u0627\u0644\u0623\u0641\u0639\u0627\u0644\u060c \u0648\u062a\u0636\u0627\u0641 \u0625\u0644\u0649 \u0627\u0644\u0645\u0635\u062f\u0631",
          "\u0645\u0628\u0627\u0634\u0631\u0629:",
          "",
          "\u200eje charger-ai   = \u0633\u0623\u0634\u062d\u0646\u200f\u200e          \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 1",
          "\u200etu chargeras    = \u0633\u062a\u0634\u062d\u0646",
          "\u200eil/elle chargera = \u0633\u064a\u0634\u062d\u0646/\u0633\u062a\u0634\u062d\u0646",
          "\u200enous chargerons = \u0633\u0646\u0634\u062d\u0646",
          "\u200evous chargerez  = \u0633\u062a\u0634\u062d\u0646\u0648\u0646",
          "\u200eils chargeront  = \u0633\u064a\u0634\u062d\u0646\u0648\u0646",
          "",
          "\u0648\u0623\u0641\u0639\u0627\u0644 -re \u062a\u062d\u0630\u0641 e \u0627\u0644\u0623\u062e\u064a\u0631\u0629 \u0623\u0648\u0644\u0627:",
          "\u200evendre \u2192 je vendrai",
          "",
          "\u0627\u0644\u062c\u0630\u0648\u0631 \u063a\u064a\u0631 \u0627\u0644\u0642\u064a\u0627\u0633\u064a\u0629 \u0643\u0645\u0627 \u0641\u064a \u0627\u0644\u0634\u0631\u0637 (\u0627\u0644\u0645\u0631\u062d\u0644\u0629 4):",
          "\u200e\u00eatre: ser-   avoir: aur-   aller: ir-",
          "\u200efaire: fer-   venir: viendr-"
        ],
        "pronunciation": "Le\u00e7on dix-neuf",
        "pronunciation_mappings": {
          "1": "je chargerai, tu chargeras, il chargera, nous chargerons, ils chargeront"
        }
      },
      {
        "page": 2,
        "total_pages": 2,
        "content": [
          "\u0627\u0644\u0645\u0633\u062a\u0642\u0628\u0644 \u0627\u0644\u0628\u0633\u064a\u0637 \u0623\u0645 \u0627\u0644\u0645\u0633\u062a\u0642\u0628\u0644 \u0627\u0644\u0642\u0631\u064a\u0628\u061f",
          "",
          "\u200efutur proche: aller + \u0627\u0644\u0645\u0635\u062f\u0631\u200f\u200e      \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 1",
          "\u0642\u0631\u064a\u0628 \u0648\u0645\u062e\u0637\u0637 \u0644\u0647\u060c \u0648\u0647\u0648 \u0644\u063a\u0629 \u0627\u0644\u0643\u0644\u0627\u0645:",
          "\u200eJe vais charger le t\u00e9l\u00e9phone.",
          "\u200e   = \u0633\u0623\u0634\u062d\u0646 \u0627\u0644\u0647\u0627\u062a\u0641",
          "",
          "\u0648\u0627\u0644\u0645\u0633\u062a\u0642\u0628\u0644 \u0627\u0644\u0628\u0633\u064a\u0637 \u0623\u0628\u0639\u062f \u0648\u0623\u0643\u062b\u0631 \u0631\u0633\u0645\u064a\u0629\u060c \u0644\u0644\u0643\u062a\u0627\u0628\u0629",
          "\u200e\u200f\u0648\u0627\u0644\u062a\u0639\u0644\u064a\u0645\u0627\u062a \u0648\u0627\u0644\u0625\u062c\u0631\u0627\u0621\u0627\u062a:\u200f\u200e            \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 2",
          "\u200eL'application se chargera automatiquement.",
          "\u200e   = \u0633\u064a\u062a\u0645 \u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u062a\u0644\u0642\u0627\u0626\u064a\u0627",
          "",
          "\u0643\u0644\u0627\u0647\u0645\u0627 \u0635\u062d\u064a\u062d\u060c \u0648\u0627\u0644\u0645\u0633\u062a\u0642\u0628\u0644 \u0627\u0644\u0642\u0631\u064a\u0628 \u0623\u0634\u064a\u0639 \u0641\u064a",
          "\u0627\u0644\u0643\u0644\u0627\u0645 \u0627\u0644\u064a\u0648\u0645\u064a. \u0648\u0627\u0644\u0641\u0631\u0642 \u0628\u064a\u0646\u0647\u0645\u0627 \u0642\u0631\u064a\u0628 \u0645\u0645\u0627 \u064a\u0630\u0643\u0631\u0647",
          "\u0627\u0644\u0646\u062d\u0627\u0629: \u00ab\u0633\u0640\u00bb \u0644\u0644\u0642\u0631\u064a\u0628 \u0648\u00ab\u0633\u0648\u0641\u00bb \u0644\u0644\u0628\u0639\u064a\u062f."
        ],
        "pronunciation_mappings": {
          "1": "je vais charger le t\u00e9l\u00e9phone",
          "2": "l'application se chargera automatiquement"
        }
      }
    ]
  },
  {
    "lesson_id": "020",
    "trigger_word": "tout",
    "trigger_card_number": 1000,
    "title": "\u0627\u0644\u062f\u0631\u0633 20: \u0627\u0644\u0644\u063a\u0629 \u0635\u0627\u0631\u062a \u0644\u0643!",
    "header_color": "gold",
    "pages": [
      {
        "page": 1,
        "total_pages": 2,
        "content": [
          "\u0647\u0646\u0627 \u062a\u0646\u062a\u0647\u064a \u0628\u0637\u0627\u0642\u0627\u062a French Core: \u0647\u0630\u0647 \u0622\u062e\u0631\u0647\u0627!",
          "",
          "1,000 \u0643\u0644\u0645\u0629 \u064820 \u062f\u0631\u0633\u0627 \u0641\u064a \u0627\u0644\u0642\u0648\u0627\u0639\u062f",
          "\u062a\u0645\u0646\u062d\u0643 \u0623\u0633\u0627\u0633\u0627 \u0645\u062a\u064a\u0646\u0627.",
          "",
          "\u0645\u0627 \u0635\u0627\u0631 \u0641\u064a \u0645\u062a\u0646\u0627\u0648\u0644\u0643 \u0627\u0644\u0622\u0646:",
          "",
          "\u2022 \u0642\u0631\u0627\u0621\u0629 \u0646\u0635\u0648\u0635 \u0641\u0631\u0646\u0633\u064a\u0629 \u0628\u0633\u064a\u0637\u0629 \u0648\u0641\u0647\u0645",
          "  \u0645\u0636\u0645\u0648\u0646 \u0623\u063a\u0644\u0628\u0647\u0627",
          "\u2022 \u0625\u062c\u0631\u0627\u0621 \u0645\u062d\u0627\u062f\u062b\u0627\u062a \u0628\u0633\u064a\u0637\u0629 \u0641\u064a",
          "  \u0645\u0648\u0636\u0648\u0639\u0627\u062a \u0627\u0644\u062d\u064a\u0627\u0629 \u0627\u0644\u064a\u0648\u0645\u064a\u0629",
          "\u2022 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 pr\u00e9sent \u0648 pass\u00e9 compos\u00e9",
          "  \u0648 imparfait \u0648 conditionnel \u0648 futur",
          "\u2022 \u062a\u0645\u064a\u064a\u0632 \u0627\u0644\u062c\u0646\u0633 \u0627\u0644\u0646\u062d\u0648\u064a \u0648\u0627\u0644\u062d\u0630\u0641 (\u00e9lision)",
          "  \u0648\u0627\u0644\u0648\u0635\u0644 (liaison) \u0641\u064a \u0622\u0644\u0627\u0641 \u0627\u0644\u0643\u0644\u0645\u0627\u062a",
          "  \u0627\u0644\u0645\u062a\u0631\u0627\u0628\u0637\u0629",
          "",
          "\u062a\u0647\u0627\u0646\u064a\u0646\u0627 \u0645\u0646 \u0623\u0643\u0627\u062f\u064a\u0645\u064a\u0629 FlashBoss: F\u00e9licitations !\u200e"
        ],
        "pronunciation": "F\u00e9licitations !",
        "pronunciation_mappings": {}
      },
      {
        "page": 2,
        "total_pages": 2,
        "content": [
          "\u0627\u0644\u062e\u0637\u0648\u0629 \u0627\u0644\u062a\u0627\u0644\u064a\u0629:",
          "",
          "\u062a\u0648\u0627\u0635\u0644 \u062d\u0632\u0645\u0629 Pareto 1 \u0645\u0627 \u0628\u062f\u0623\u062a\u0647 French Core",
          "\u0628\u0627\u0644\u0623\u0644\u0641 \u0627\u0644\u062a\u0627\u0644\u064a\u0629 \u0645\u0646 \u0623\u0634\u064a\u0639 \u0627\u0644\u0643\u0644\u0645\u0627\u062a.",
          "",
          "\u0648\u0642\u062f \u0627\u0643\u062a\u0633\u0628\u062a \u0623\u064a\u0636\u0627 \u0645\u0647\u0627\u0631\u0627\u062a \u062a\u062a\u064a\u062d:",
          "",
          "\u2022 \u0645\u0634\u0627\u0647\u062f\u0629 \u0627\u0644\u0628\u0631\u0627\u0645\u062c \u0627\u0644\u0641\u0631\u0646\u0633\u064a\u0629 \u0628\u062a\u0631\u062c\u0645\u0629 \u0645\u0643\u062a\u0648\u0628\u0629",
