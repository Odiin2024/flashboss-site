        "pronunciation_mappings": {
          "1": "France. Enfant. Dans.",
          "2": "Vin. Pain. Main.",
          "3": "Bon. Maison. Non.",
          "4": "Un. Lundi. Parfum."
        }
      },
      {
        "page": 3,
        "total_pages": 4,
        "content": [
          "与英语不同的辅音：",
          "",
          "h = 始终不发音                    按 1",
          "   habiter, homme, heure",
          "",
          "c 在 e/i/y 前 = 软音「s」          按 2",
          "   ici, cinéma, merci",
          "c 在 a/o/u 前 = 硬音「k」          按 3",
          "   café, comme, cousin",
          "ç = 始终发软音「s」（任何元音前）  按 4",
          "   ça, français, garçon",
          "",
          "g 在 e/i/y 前 = 软音（类似「zh」） 按 5",
          "   âge, manger, gilet",
          "g 在 a/o/u 前 = 硬音如「go」中的 g 按 6",
          "   gauche, gomme, légume",
          "gn = 如 canyon 中的「ny」         按 7",
          "   montagne, gagner, ligne"
