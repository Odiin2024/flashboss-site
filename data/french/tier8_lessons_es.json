    "header_color": "green",
    "pages": [
      {
        "page": 1,
        "total_pages": 2,
        "content": [
          "INVERSIÓN FORMAL — el periodismo y la",
          "escritura formal invierten verbo y",
          "sujeto en vez de usar est-ce que:",
          "",
          "EST-CE QUE (común, todo registro):    Presiona 1",
          "Est-ce que vous êtes sûr ?",
          "",
          "INVERSIÓN (culta, prensa escrita):    Presiona 2",
          "Êtes-vous sûr ?",
          "(¿Está seguro?)",
          "",
          "Que pensez-vous de cette réforme ?    Presiona 3",
          "(¿Qué opina de esta reforma?)",
          "",
          "Pourquoi la source est-elle           Presiona 4",
          "fiable ?",
          "(¿Por qué la fuente es confiable?)"
        ],
        "pronunciation": "Leçon vingt-cinq",
        "pronunciation_mappings": {
          "1": "est-ce que vous êtes sûr",
          "2": "êtes-vous sûr",
          "3": "que pensez-vous de cette réforme",
          "4": "pourquoi la source est-elle fiable"
        }
      },
      {
        "page": 2,
        "total_pages": 2,
        "content": [
          "LA -T- DE ENLACE — cuando el verbo",
          "termina en vocal y sigue 'il/elle/on',",
          "se inserta una -t- para pronunciarlo:",
          "",
          "parle → parle-t-il ?               Presiona 1",
          "(¿él habla?)",
          "a → a-t-elle ?",
          "(¿ella tiene?)",
          "",
          "CON SUJETO SUSTANTIVO, deja el nombre",
          "y AGREGA el pronombre que concuerda:",
          "",
          "Le journaliste a-t-il vérifié      Presiona 2",
          "la source ?",
          "(¿El periodista verificó la fuente?)",
          "",
          "La inversión marca registro FORMAL —",
          "usa est-ce que en el habla diaria."
        ],
        "pronunciation_mappings": {
          "1": "parle-t-il, a-t-elle",
          "2": "le journaliste a-t-il vérifié la source"
        }
      }
