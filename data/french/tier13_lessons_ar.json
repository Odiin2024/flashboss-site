[
  {
    "lesson_id": "033",
    "trigger_word": "r\u00e9v\u00e9ler",
    "trigger_card_number": 2411,
    "title": "\u0627\u0644\u062f\u0631\u0633 33: \u0627\u0644\u0643\u0644\u0627\u0645 \u0627\u0644\u0645\u0646\u0642\u0648\u0644",
    "header_color": "green",
    "pages": [
      {
        "page": 1,
        "total_pages": 3,
        "content": [
          "\u0627\u0644\u0643\u0644\u0627\u0645 \u0627\u0644\u0645\u0646\u0642\u0648\u0644 (discours indirect) \u0647\u0648 \u0646\u0642\u0644",
          "\u0645\u0627 \u0642\u0627\u0644\u0647 \u063a\u064a\u0631\u0646\u0627. \u0648\u0625\u0630\u0627 \u062c\u0627\u0621 \u0641\u0639\u0644 \u0627\u0644\u0642\u0648\u0644 \u0641\u064a \u0627\u0644\u0645\u0627\u0636\u064a\u060c",
          "\u0631\u062c\u0639 \u0627\u0644\u0641\u0639\u0644 \u0627\u0644\u0645\u0646\u0642\u0648\u0644 \u062e\u0637\u0648\u0629 \u0641\u064a \u0627\u0644\u0632\u0645\u0646\u060c \u0648\u0647\u0630\u0627 \u0645\u0627",
          "\u064a\u0633\u0645\u0649 \u062a\u0648\u0627\u0641\u0642 \u0627\u0644\u0623\u0632\u0645\u0646\u0629.",
          "",
          "\u200epr\u00e9sent \u2192 imparfait                \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 1",
          "\u0627\u0644\u0645\u0636\u0627\u0631\u0639 \u064a\u0635\u064a\u0631 \u0627\u0644\u0645\u0627\u0636\u064a \u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631\u064a (imparfait):",
          "",
          "\u200e\u00ab Le gouvernement agit. \u00bb",
          "\u200eLe journal a r\u00e9v\u00e9l\u00e9 que le",
          "\u200egouvernement agissait.\u200e",
          "\u200e   = \u0643\u0634\u0641\u062a \u0627\u0644\u0635\u062d\u064a\u0641\u0629 \u0623\u0646 \u0627\u0644\u062d\u0643\u0648\u0645\u0629",
          "\u200e     \u062a\u062a\u062e\u0630 \u0625\u062c\u0631\u0627\u0621\u0627\u062a",
          "",
          "\u200ea r\u00e9v\u00e9l\u00e9: \u0641\u0639\u0644 \u0627\u0644\u0642\u0648\u0644\u200f\u200e                \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 2",
          "\u0641\u064a \u0627\u0644\u0645\u0627\u0636\u064a \u0627\u0644\u0645\u0631\u0643\u0628\u060c \u062b\u0645 \u062a\u0641\u062a\u062a\u062d que \u0627\u0644\u062c\u0645\u0644\u0629",
          "\u0627\u0644\u0645\u0646\u0642\u0648\u0644\u0629\u060c \u0648\u064a\u0631\u062c\u0639 \u0641\u0639\u0644\u0647\u0627 \u062e\u0637\u0648\u0629 \u0648\u0627\u062d\u062f\u0629 \u0641\u064a \u0627\u0644\u0632\u0645\u0646."
        ],
        "pronunciation": "Le\u00e7on trente-trois",
        "pronunciation_mappings": {
          "1": "le gouvernement agit, le gouvernement agissait",
          "2": "le journal a r\u00e9v\u00e9l\u00e9 que le gouvernement agissait"
        }
      },
      {
        "page": 2,
        "total_pages": 3,
        "content": [
          "\u200efutur \u2192 conditionnel pr\u00e9sent       \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 1",
          "\u0627\u0644\u0645\u0633\u062a\u0642\u0628\u0644 \u064a\u0635\u064a\u0631 \u0635\u064a\u063a\u0629 \u0627\u0644\u0634\u0631\u0637 (conditionnel):",
          "",
          "\u200e\u00ab Le ministre d\u00e9missionnera. \u00bb",
          "\u200eLa source a affirm\u00e9 que le ministre",
          "\u200ed\u00e9missionnerait.\u200e",
          "\u200e   = \u0623\u0643\u062f \u0627\u0644\u0645\u0635\u062f\u0631 \u0623\u0646 \u0627\u0644\u0648\u0632\u064a\u0631 \u0633\u064a\u0633\u062a\u0642\u064a\u0644",
          "\u0641\u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u062a\u0628\u0642\u064a \u0647\u0646\u0627 \u0627\u0644\u0645\u0633\u062a\u0642\u0628\u0644 \u00ab\u0633\u064a\u0633\u062a\u0642\u064a\u0644\u00bb\u060c \u0623\u0645\u0627",
          "\u0627\u0644\u0641\u0631\u0646\u0633\u064a\u0629 \u0641\u062a\u0646\u0642\u0644\u0647 \u0625\u0644\u0649 \u0635\u064a\u063a\u0629 \u0627\u0644\u0634\u0631\u0637.",
          "\u200epass\u00e9 compos\u00e9 \u2192 plus-que-parfait   \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 2",
          "\u0627\u0644\u0645\u0627\u0636\u064a \u0627\u0644\u0645\u0631\u0643\u0628 \u064a\u0635\u064a\u0631 \u0627\u0644\u0645\u0627\u0636\u064a \u0627\u0644\u0623\u0633\u0628\u0642:",
          "",
          "\u200e\u00ab J'ai v\u00e9rifi\u00e9 les faits. \u00bb",
          "\u200eElle a affirm\u00e9 qu'elle avait v\u00e9rifi\u00e9",
          "\u200eles faits.\u200e",
          "\u200e   = \u0623\u0643\u062f\u062a \u0623\u0646\u0647\u0627 \u0643\u0627\u0646\u062a \u0642\u062f \u062a\u062d\u0642\u0642\u062a \u0645\u0646 \u0627\u0644\u0648\u0642\u0627\u0626\u0639",
          "\u0648\u0635\u064a\u063a\u0629 plus-que-parfait \u0642\u0631\u064a\u0628\u0629 \u0645\u0646 \u00ab\u0643\u0627\u0646 \u0642\u062f \u0641\u0639\u0644\u00bb."
        ],
        "pronunciation_mappings": {
          "1": "le ministre d\u00e9missionnera, le ministre d\u00e9missionnerait",
          "2": "j'ai v\u00e9rifi\u00e9 les faits, elle avait v\u00e9rifi\u00e9 les faits"
        }
      },
      {
        "page": 3,
        "total_pages": 3,
        "content": [
          "\u0648\u062a\u062a\u063a\u064a\u0631 \u0643\u0630\u0644\u0643 \u0643\u0644\u0645\u0627\u062a \u0627\u0644\u0632\u0645\u0627\u0646 \u0648\u0627\u0644\u0645\u0643\u0627\u0646:",
          "",
          "\u200eaujourd'hui \u2192 ce jour-l\u00e0           \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 1",
          "\u200ehier \u2192 la veille",
          "\u200edemain \u2192 le lendemain",
          "\u200eici \u2192 l\u00e0",
          "\u0623\u064a: \u0630\u0644\u0643 \u0627\u0644\u064a\u0648\u0645\u060c \u0642\u0628\u0644\u0647 \u0628\u064a\u0648\u0645\u060c \u0628\u0639\u062f\u0647 \u0628\u064a\u0648\u0645\u060c \u0647\u0646\u0627\u0643.",
          "\u200e\u00ab Je pars demain. \u00bb                \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 2",
          "\u200eIl a r\u00e9v\u00e9l\u00e9 qu'il partait le",
          "\u200elendemain.\u200e",
          "\u200e   = \u0643\u0634\u0641 \u0623\u0646\u0647 \u0633\u064a\u063a\u0627\u062f\u0631 \u0641\u064a \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u062a\u0627\u0644\u064a",
          "\u0648\u0627\u0644\u062e\u0628\u0631 \u0627\u0644\u0639\u0631\u0628\u064a \u064a\u0642\u0648\u0644 \u0639\u0627\u062f\u0629 \u00ab\u0641\u064a \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u062a\u0627\u0644\u064a\u00bb.",
          "",
          "\u200e\u200f\u0623\u0641\u0639\u0627\u0644 \u0627\u0644\u0642\u0648\u0644 \u0641\u064a \u0627\u0644\u0623\u062e\u0628\u0627\u0631:\u200f\u200e            \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 3",
          "\u200eil a r\u00e9v\u00e9l\u00e9, elle a affirm\u00e9,",
          "\u200ela source a rapport\u00e9",
          "\u0648\u064a\u0642\u062a\u0631\u0646 \u0630\u0644\u0643 \u0628\u062a\u0642\u062f\u064a\u0645 \u0627\u0644\u0641\u0639\u0644 \u0639\u0644\u0649 \u0627\u0644\u0636\u0645\u064a\u0631 (\u0627\u0644\u062f\u0631\u0633 25)\u060c",
          "\u0641\u0646\u0642\u0644 \u0627\u0644\u0623\u0642\u0648\u0627\u0644 \u0635\u0644\u0628 \u0644\u063a\u0629 \u0627\u0644\u0623\u062e\u0628\u0627\u0631 \u0645\u0646 \u0627\u0644\u0622\u0646 \u0641\u0635\u0627\u0639\u062f\u0627."
        ],
        "pronunciation_mappings": {
          "1": "aujourd'hui, ce jour-l\u00e0, hier, la veille, demain, le lendemain",
          "2": "je pars demain, il a r\u00e9v\u00e9l\u00e9 qu'il partait le lendemain",
          "3": "il a r\u00e9v\u00e9l\u00e9, elle a affirm\u00e9, la source a rapport\u00e9"
        }
      }
    ]
  }
]
