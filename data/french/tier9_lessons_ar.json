[
  {
    "lesson_id": "026",
    "trigger_word": "raconter",
    "trigger_card_number": 1601,
    "title": "\u0627\u0644\u062f\u0631\u0633 26: \u0627\u0644\u0645\u0627\u0636\u064a \u0627\u0644\u0628\u0633\u064a\u0637 (\u0644\u0644\u0642\u0631\u0627\u0621\u0629)",
    "header_color": "green",
    "pages": [
      {
        "page": 1,
        "total_pages": 2,
        "content": [
          "\u0627\u0644\u0645\u0627\u0636\u064a \u0627\u0644\u0628\u0633\u064a\u0637 (pass\u00e9 simple) \u0632\u0645\u0646 \u0627\u0644\u0645\u0627\u0636\u064a",
          "\u0627\u0644\u0623\u062f\u0628\u064a \u0641\u064a \u0627\u0644\u0633\u0631\u062f \u0627\u0644\u0645\u0643\u062a\u0648\u0628: \u0627\u0644\u0631\u0648\u0627\u064a\u0627\u062a",
          "\u0648\u0627\u0644\u062d\u0643\u0627\u064a\u0627\u062a \u0627\u0644\u062e\u0631\u0627\u0641\u064a\u0629 \u0648\u0643\u062a\u0628 \u0627\u0644\u062a\u0627\u0631\u064a\u062e.",
          "",
          "\u0644\u0644\u062a\u0639\u0631\u0641 \u0639\u0644\u064a\u0647 \u0641\u0642\u0637: \u0644\u0627 \u062d\u0627\u062c\u0629 \u0625\u0644\u0649 \u0643\u062a\u0627\u0628\u062a\u0647 \u0623\u0648",
          "\u0627\u0644\u0646\u0637\u0642 \u0628\u0647\u060c \u0628\u0644 \u064a\u0643\u0641\u064a \u062a\u0645\u064a\u064a\u0632\u0647 \u0639\u0646\u062f \u0627\u0644\u0642\u0631\u0627\u0621\u0629.",
          "",
          "\u200e\u200f\u064a\u062d\u0644 \u0645\u062d\u0644 \u0627\u0644\u0645\u0627\u0636\u064a \u0627\u0644\u0645\u0631\u0643\u0628 \u0641\u064a \u0627\u0644\u0633\u0631\u062f\u200f\u200e     \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 1",
          "\u0628\u0627\u0644\u0645\u0639\u0646\u0649 \u0646\u0641\u0633\u0647:",
          "\u200eIl raconta son histoire.",
          "\u200e= Il a racont\u00e9 son histoire.",
          "\u200e   = \u0631\u0648\u0649 \u0642\u0635\u062a\u0647",
          "",
          "\u200e-er: il/elle parla, ils parl\u00e8rent  \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 2",
          "\u200e   = \u062a\u0643\u0644\u0645/\u062a\u0643\u0644\u0645\u062a\u060c \u062a\u0643\u0644\u0645\u0648\u0627",
          "",
          "\u200e-ir/-re: il finit, il vendit;      \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 3",
          "\u200eils finirent, ils vendirent."
        ],
        "pronunciation": "Le\u00e7on vingt-six",
        "pronunciation_mappings": {
          "1": "il raconta son histoire",
          "2": "il parla, ils parl\u00e8rent",
          "3": "il finit, il vendit, ils finirent, ils vendirent"
        }
      },
      {
        "page": 2,
        "total_pages": 2,
        "content": [
          "\u062c\u0630\u0648\u0631 \u063a\u064a\u0631 \u0642\u064a\u0627\u0633\u064a\u0629 \u0641\u064a \u0627\u0644\u0645\u0627\u0636\u064a \u0627\u0644\u0628\u0633\u064a\u0637\u060c",
          "\u064a\u062d\u0633\u0646 \u0627\u0644\u062a\u0639\u0631\u0641 \u0639\u0644\u064a\u0647\u0627 \u0645\u0646 \u0627\u0644\u0646\u0638\u0631\u0629 \u0627\u0644\u0623\u0648\u0644\u0649:",
          "",
          "\u200e\u00eatre \u2192 il fut, ils furent          \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 1",
          "\u200eavoir \u2192 il eut, ils eurent",
          "",
          "\u200efaire \u2192 il fit, ils firent         \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 2",
          "\u200evoir \u2192 il vit, ils virent",
          "",
          "\u200evenir \u2192 il vint, ils vinrent       \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 3",
          "\u200eprendre \u2192 il prit, ils prirent",
          "",
          "\u200eIl entra, il vit, il comprit.      \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 4",
          "\u200e   = \u062f\u062e\u0644\u060c \u0641\u0631\u0623\u0649\u060c \u0641\u0641\u0647\u0645",
          "\u0648\u0647\u0648 \u0625\u064a\u0642\u0627\u0639 \u0627\u0644\u0633\u0631\u062f \u0627\u0644\u0645\u0639\u0647\u0648\u062f\u060c \u0643\u062a\u062a\u0627\u0628\u0639 \u0627\u0644\u0623\u0641\u0639\u0627\u0644",
          "\u0627\u0644\u0645\u0627\u0636\u064a\u0629 \u0641\u064a \u0627\u0644\u0642\u0635\u0635 \u0627\u0644\u0639\u0631\u0628\u064a\u0629.",
          "\u064a\u0643\u0641\u064a \u062a\u0645\u064a\u064a\u0632 \u0627\u0644\u0646\u0645\u0637 \u0628\u0644\u0627 \u062a\u0645\u0627\u0631\u064a\u0646 \u062d\u0641\u0638\u060c",
          "\u0641\u0627\u0644\u063a\u0627\u064a\u0629 \u0647\u0646\u0627 \u0637\u0644\u0627\u0642\u0629 \u0627\u0644\u0642\u0631\u0627\u0621\u0629 \u0648\u062d\u062f\u0647\u0627."
        ],
        "pronunciation_mappings": {
          "1": "il fut, ils furent, il eut, ils eurent",
          "2": "il fit, ils firent, il vit, ils virent",
          "3": "il vint, ils vinrent, il prit, ils prirent",
          "4": "il entra, il vit, il comprit"
        }
      }
    ]
  },
  {
    "lesson_id": "027",
    "trigger_word": "auparavant",
    "trigger_card_number": 1604,
    "title": "\u0627\u0644\u062f\u0631\u0633 27: \u0627\u0644\u0645\u0627\u0636\u064a \u0627\u0644\u0623\u0633\u0628\u0642",
    "header_color": "green",
    "pages": [
      {
        "page": 1,
        "total_pages": 2,
        "content": [
          "\u0627\u0644\u0645\u0627\u0636\u064a \u0627\u0644\u0623\u0633\u0628\u0642 (plus-que-parfait) \u062e\u0637\u0648\u0629 \u0623\u0628\u0639\u062f",
          "\u0641\u064a \u0627\u0644\u0645\u0627\u0636\u064a \u0645\u0646 \u0627\u0644\u0645\u0627\u0636\u064a \u0627\u0644\u0645\u0631\u0643\u0628: \u0627\u0644\u062d\u062f\u062b \u0627\u0644\u0630\u064a",
          "\u0648\u0642\u0639 \u0642\u0628\u0644 \u062d\u062f\u062b \u0622\u062e\u0631\u060c \u0648\u064a\u0642\u0627\u0628\u0644\u0647 \u062a\u0642\u0631\u064a\u0628\u0627 \u00ab\u0643\u0627\u0646 \u0642\u062f \u0641\u0639\u0644\u00bb.",
          "",
          "\u200e\u200f\u0627\u0644\u062a\u0643\u0648\u064a\u0646:\u200f\u200e                           \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 1",
          "\u062a\u0635\u0631\u064a\u0641 avoir \u0623\u0648 \u00eatre \u0641\u064a \u0627\u0644\u0645\u0627\u0636\u064a \u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631\u064a\u060c",
          "\u062b\u0645 \u0627\u0633\u0645 \u0627\u0644\u0645\u0641\u0639\u0648\u0644:",
          "\u200ej'avais fini = \u0643\u0646\u062a \u0642\u062f \u0623\u0646\u0647\u064a\u062a",
          "\u200eelle \u00e9tait partie = \u0643\u0627\u0646\u062a \u0642\u062f \u063a\u0627\u062f\u0631\u062a",
          "\u200eIl avait d\u00e9j\u00e0 racont\u00e9 cette        \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 2",
          "\u200ehistoire auparavant.",
          "\u200e   = \u0643\u0627\u0646 \u0642\u062f \u0631\u0648\u0649 \u0647\u0630\u0647 \u0627\u0644\u0642\u0635\u0629 \u0645\u0646 \u0642\u0628\u0644",
          "",
          "\u0648\u0627\u0644\u0627\u062e\u062a\u064a\u0627\u0631 \u0628\u064a\u0646 avoir \u0648 \u00eatre \u0647\u0648 \u0646\u0641\u0633\u0647 \u0641\u064a",
          "\u0627\u0644\u0645\u0627\u0636\u064a \u0627\u0644\u0645\u0631\u0643\u0628 (\u0627\u0644\u0645\u0631\u062d\u0644\u0629 3 \u0645\u0646 Core)\u060c \u0648\u0623\u0633\u0645\u0627\u0621",
          "\u0627\u0644\u0645\u0641\u0639\u0648\u0644 \u0647\u064a \u0646\u0641\u0633\u0647\u0627."
        ],
        "pronunciation": "Le\u00e7on vingt-sept",
        "pronunciation_mappings": {
          "1": "j'avais fini, elle \u00e9tait partie",
          "2": "il avait d\u00e9j\u00e0 racont\u00e9 cette histoire auparavant"
        }
      },
      {
        "page": 2,
        "total_pages": 2,
        "content": [
          "\u062a\u0631\u062a\u064a\u0628 \u0627\u0644\u0623\u0632\u0645\u0646\u0629 \u0641\u064a \u0627\u0644\u0633\u0631\u062f:",
          "",
          "\u200e\u200f\u0627\u0644\u0645\u0627\u0636\u064a \u0627\u0644\u0623\u0633\u0628\u0642 \u064a\u0631\u0633\u0645 \u0645\u0627 \u0633\u0628\u0642\u200f\u200e          \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 1",
          "\u0627\u0644\u062d\u062f\u062b \u0627\u0644\u0631\u0626\u064a\u0633\u064a \u0641\u064a \u0627\u0644\u0642\u0635\u0629:",
          "",
          "\u200eElle avait souffert, puis elle pardonna.",
          "\u200e   = \u0643\u0627\u0646\u062a \u0642\u062f \u0639\u0627\u0646\u062a\u060c \u062b\u0645 \u0635\u0641\u062d\u062a",
          "",
          "\u0627\u0644\u0645\u0627\u0636\u064a \u0627\u0644\u0623\u0633\u0628\u0642 \u0644\u0644\u062e\u0644\u0641\u064a\u0629\u060c \u062b\u0645 \u0627\u0644\u0645\u0627\u0636\u064a \u0627\u0644\u0628\u0633\u064a\u0637",
          "\u0644\u0644\u062a\u062d\u0648\u0644 \u0641\u064a \u0627\u0644\u0642\u0635\u0629.",
          "",
          "\u200e\u200f\u0648\u0641\u064a \u0627\u0644\u0643\u0644\u0627\u0645 \u064a\u0623\u062a\u064a \u0627\u0644\u0645\u0627\u0636\u064a \u0627\u0644\u0645\u0631\u0643\u0628\u200f\u200e      \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 2",
          "\u0641\u064a \u0627\u0644\u0641\u0639\u0644 \u0627\u0644\u062b\u0627\u0646\u064a\u060c \u0648\u0627\u0644\u0645\u0639\u0646\u0649 \u0648\u0627\u062d\u062f:",
          "\u200eElle avait souffert, puis elle a pardonn\u00e9.",
          "",
          "\u0648\u0643\u0644\u0645\u0627\u062a \u0645\u062b\u0644 auparavant \u0648 avant \u0648 d\u00e9j\u00e0",
          "\u0643\u062b\u064a\u0631\u0627 \u0645\u0627 \u062a\u062f\u0644 \u0639\u0644\u0649 \u0627\u0644\u0645\u0627\u0636\u064a \u0627\u0644\u0623\u0633\u0628\u0642."
        ],
        "pronunciation_mappings": {
          "1": "elle avait souffert, puis elle pardonna",
          "2": "elle avait souffert, puis elle a pardonn\u00e9"
        }
      }
    ]
  }
]
