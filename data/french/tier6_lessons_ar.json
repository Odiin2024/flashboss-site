[
  {
    "lesson_id": "021",
    "trigger_word": "r\u00e9nover",
    "trigger_card_number": 1001,
    "title": "\u0627\u0644\u062f\u0631\u0633 21: \u0627\u0644\u0645\u0646\u0637\u0648\u0642 \u0648\u0627\u0644\u0645\u0643\u062a\u0648\u0628",
    "header_color": "green",
    "pages": [
      {
        "page": 1,
        "total_pages": 2,
        "content": [
          "\u0627\u0644\u0641\u0631\u0646\u0633\u064a\u0629 \u0627\u0644\u0645\u0646\u0637\u0648\u0642\u0629 \u062a\u0633\u0642\u0637 \u0643\u0644\u0645\u0627\u062a \u062a\u0628\u0642\u0649 \u0641\u064a",
          "\u0627\u0644\u0645\u0643\u062a\u0648\u0628\u0629\u060c \u0648\u0647\u0630\u0627 \u0642\u0631\u064a\u0628 \u0645\u0646 \u0627\u0644\u0641\u0631\u0642 \u0628\u064a\u0646 \u0644\u063a\u0629 \u0627\u0644\u0643\u062a\u0627\u0628\u0629",
          "\u0648\u0644\u063a\u0629 \u0627\u0644\u062d\u062f\u064a\u062b \u0639\u0646\u062f\u0646\u0627. \u0648\u0623\u0634\u064a\u0639 \u0630\u0644\u0643 \u0633\u0642\u0648\u0637 ne \u0641\u064a",
          "\u0627\u0644\u0643\u0644\u0627\u0645 \u0627\u0644\u0633\u0631\u064a\u0639\u060c \u0641\u062a\u0628\u0642\u0649 pas \u0648\u062d\u062f\u0647\u0627 \u0644\u0644\u0646\u0641\u064a:",
          "\u200eJe sais pas.                       \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 1",
          "\u200e   = \u0644\u0627 \u0623\u0639\u0631\u0641",
          "\u0648\u0641\u064a \u0627\u0644\u0643\u062a\u0627\u0628\u0629: Je ne sais pas.\u200e",
          "",
          "\u200eJ'ai pas le temps.                 \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 2",
          "\u200e   = \u0644\u064a\u0633 \u0644\u062f\u064a \u0648\u0642\u062a",
          "",
          "\u200eC'est pas grave.                   \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 3",
          "\u200e   = \u0644\u0627 \u0628\u0623\u0633",
          "",
          "\u0623\u0645\u0627 \u0641\u064a \u0627\u0644\u0643\u062a\u0627\u0628\u0629 \u0641\u062a\u0643\u062a\u0628 ne...pas \u0643\u0627\u0645\u0644\u0629 \u062f\u0627\u0626\u0645\u0627\u060c",
          "\u0648\u0645\u0627 \u0633\u0628\u0642 \u0645\u0647\u0627\u0631\u0629 \u0627\u0633\u062a\u0645\u0627\u0639: \u0627\u0644\u062a\u0639\u0631\u0641 \u0639\u0644\u0649 \u0647\u0630\u0627 \u0627\u0644\u062d\u0630\u0641",
          "\u0639\u0646\u062f \u0633\u0645\u0627\u0639 \u0627\u0644\u0641\u0631\u0646\u0633\u064a\u0629 \u0639\u0644\u0649 \u0637\u0628\u064a\u0639\u062a\u0647\u0627."
        ],
        "pronunciation": "Le\u00e7on vingt et un",
        "pronunciation_mappings": {
          "1": "je sais pas",
          "2": "j'ai pas le temps",
          "3": "c'est pas grave"
        }
      },
      {
        "page": 2,
        "total_pages": 2,
        "content": [
          "\u0648\u0641\u064a \u0627\u0644\u0643\u0644\u0627\u0645 \u062a\u062d\u0644 on \u0645\u062d\u0644 nous \u0628\u0627\u0644\u0645\u0639\u0646\u0649 \u0646\u0641\u0633\u0647\u060c",
          "\u0644\u0643\u0646 \u0627\u0644\u0641\u0639\u0644 \u064a\u0635\u0631\u0641 \u0645\u0639\u0647\u0627 \u0643\u0645\u0627 \u0645\u0639 il/elle:",
          "",
          "\u200eNous allons au march\u00e9.             \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 1",
          "\u200e   = \u0646\u0630\u0647\u0628 \u0625\u0644\u0649 \u0627\u0644\u0633\u0648\u0642 (\u0627\u0644\u0645\u0643\u062a\u0648\u0628 \u0648\u0627\u0644\u0631\u0633\u0645\u064a)",
          "\u200eOn va au march\u00e9.",
          "\u200e   = \u0627\u0644\u0645\u0639\u0646\u0649 \u0646\u0641\u0633\u0647 \u0641\u064a \u0627\u0644\u0643\u0644\u0627\u0645",
          "",
          "\u200eOn est pr\u00eats ?\u200e                     \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 2",
          "\u200e   = \u0647\u0644 \u0646\u062d\u0646 \u0645\u0633\u062a\u0639\u062f\u0648\u0646\u061f (\u0641\u064a \u0627\u0644\u0643\u0644\u0627\u0645)",
          "\u0648\u062c\u0627\u0621\u062a pr\u00eats \u0628\u0627\u0644\u062c\u0645\u0639 \u0644\u0623\u0646 on \u0647\u0646\u0627 \u0628\u0645\u0639\u0646\u0649 nous.",
          "",
          "\u0645\u0642\u0627\u0631\u0646\u0629 \u0627\u0644\u0633\u062c\u0644\u064a\u0646:",
          "\u0627\u0644\u0645\u0643\u062a\u0648\u0628 \u0648\u0627\u0644\u0631\u0633\u0645\u064a: nous\u060c \u0648ne...pas \u0643\u0627\u0645\u0644\u0629",
          "\u0627\u0644\u0645\u0646\u0637\u0648\u0642 \u0648\u063a\u064a\u0631 \u0627\u0644\u0631\u0633\u0645\u064a: on\u060c \u0648\u0633\u0642\u0648\u0637 ne \u0645\u0646 \u0627\u0644\u0646\u0641\u064a",
          "",
          "\u0648\u0627\u062e\u062a\u064a\u0627\u0631 tu \u0623\u0648 vous \u0645\u0646 Core \u064a\u0628\u0642\u0649 \u0642\u0627\u0626\u0645\u0627",
          "\u062a\u062d\u062a \u0627\u0644\u0633\u062c\u0644\u064a\u0646 \u0643\u0644\u064a\u0647\u0645\u0627."
        ],
        "pronunciation_mappings": {
          "1": "nous allons au march\u00e9",
          "2": "on va au march\u00e9, on est pr\u00eats"
        }
      }
    ]
  },
  {
    "lesson_id": "022",
    "trigger_word": "se d\u00e9tendre",
    "trigger_card_number": 1055,
    "title": "\u0627\u0644\u062f\u0631\u0633 22: \u0639\u0648\u062f\u0629 \u0635\u064a\u063a\u0629 subjonctif",
    "header_color": "green",
    "pages": [
      {
        "page": 1,
        "total_pages": 2,
        "content": [
          "\u0635\u064a\u063a\u0629 subjonctif (\u0635\u064a\u063a\u0629 \u0627\u0644\u0627\u062d\u062a\u0645\u0627\u0644) \u062a\u0639\u0648\u062f\u060c \u0648\u0642\u062f",
          "\u0645\u0631 \u0645\u0641\u062a\u0627\u062d\u0647\u0627 \u0627\u0644\u0623\u0633\u0627\u0633\u064a il faut que \u0641\u064a Core.",
          "\u0648\u0645\u0631\u0627\u062c\u0639\u0629 \u0633\u0631\u064a\u0639\u0629 \u0644\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062a\u0643\u0648\u064a\u0646:",
          "",
          "\u200e-e, -es, -e, -ions, -iez, -ent     \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 1",
          "\u0648\u062a\u0636\u0627\u0641 \u0625\u0644\u0649 \u0635\u064a\u063a\u0629 ils \u0641\u064a \u0627\u0644\u0645\u0636\u0627\u0631\u0639 \u0628\u0639\u062f \u062d\u0630\u0641 -ent\u060c",
          "\u0623\u0645\u0627 nous/vous \u0641\u0645\u0646 \u062c\u0630\u0639 nous: que nous prenions",
          "\u200ese d\u00e9tendre \u2192 ils se d\u00e9tendent \u2192",
          "\u200eil faut que tu te d\u00e9tendes.        \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 2",
          "\u200e   = \u064a\u062c\u0628 \u0623\u0646 \u062a\u0633\u062a\u0631\u062e\u064a",
          "",
          "\u200eil faut que tu te reposes.         \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 3",
          "\u200e   = \u064a\u062c\u0628 \u0623\u0646 \u062a\u0631\u062a\u0627\u062d",
          "\u0648\u0647\u0630\u0627 \u0642\u0631\u064a\u0628 \u0645\u0646 \u0646\u0635\u0628 \u0627\u0644\u0645\u0636\u0627\u0631\u0639 \u0628\u0639\u062f \u00ab\u0623\u0646\u00bb \u0641\u064a \u0627\u0644\u0639\u0631\u0628\u064a\u0629.",
          "",
          "\u0648\u0627\u0644\u0635\u064a\u063a \u063a\u064a\u0631 \u0627\u0644\u0642\u064a\u0627\u0633\u064a\u0629 \u0643\u0645\u0627 \u0641\u064a Core:",
          "\u200e\u00eatre \u2192 sois     avoir \u2192 aie",
          "\u200ealler \u2192 aille   faire \u2192 fasse"
        ],
        "pronunciation": "Le\u00e7on vingt-deux",
        "pronunciation_mappings": {
          "1": "-e, -es, -e, -ions, -iez, -ent",
          "2": "il faut que tu te d\u00e9tendes",
          "3": "il faut que tu te reposes"
        }
      },
      {
        "page": 2,
        "total_pages": 2,
        "content": [
          "\u0645\u0641\u0627\u062a\u064a\u062d \u0623\u062e\u0631\u0649 \u0644\u0635\u064a\u063a\u0629 subjonctif \u0644\u0644\u0645\u0631\u0627\u062c\u0639\u0629",
          "\u0645\u0639 il faut que\u060c \u0648\u0645\u0646\u0647\u0627:",
          "",
          "\u200esouhaiter que (\u064a\u062a\u0645\u0646\u0649 \u0623\u0646)\u200f\u200e           \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 1",
          "\u200eJe souhaite que tu ailles mieux.",
          "\u200e   = \u0623\u062a\u0645\u0646\u0649 \u0623\u0646 \u062a\u062a\u062d\u0633\u0646 \u0635\u062d\u062a\u0643",
          "",
          "\u200evouloir que (\u064a\u0631\u064a\u062f \u0623\u0646)\u200f\u200e              \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 2",
          "\u200eJe veux que tu te reposes.",
          "\u200e   = \u0623\u0631\u064a\u062f \u0623\u0646 \u062a\u0631\u062a\u0627\u062d",
          "\u200eavant que (\u0642\u0628\u0644 \u0623\u0646)\u200f\u200e                 \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 3",
          "\u200eRepose-toi avant que ce soit pire.",
          "\u200e   = \u0627\u0631\u062a\u062d \u0642\u0628\u0644 \u0623\u0646 \u064a\u0633\u0648\u0621 \u0627\u0644\u0623\u0645\u0631",
          "\u0648\u0627\u0644\u0645\u0641\u062a\u0627\u062d\u0627\u0646 \u0627\u0644\u0623\u062e\u064a\u0631\u0627\u0646 \u0645\u0646 Core\u060c \u0648\u0645\u0627 \u0632\u0627\u0644\u0627 \u0623\u0633\u0627\u0633\u064a\u064a\u0646.",
          "",
          "\u0648\u0633\u062a\u0636\u064a\u0641 Pareto 1 \u0645\u0641\u0627\u062a\u064a\u062d \u0643\u062b\u064a\u0631\u0629 \u0623\u062e\u0631\u0649\u060c",
          "\u0648\u0647\u0630\u0647 \u0645\u0631\u0627\u062c\u0639\u0629 \u0644\u0644\u062a\u0646\u0634\u064a\u0637."
        ],
        "pronunciation_mappings": {
          "1": "je souhaite que tu ailles mieux",
          "2": "je veux que tu te reposes",
          "3": "repose-toi avant que ce soit pire"
        }
      }
    ]
  }
]
