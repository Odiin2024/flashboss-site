  {
    "lesson_id": "028",
    "trigger_word": "pr\u00e9server",
    "trigger_card_number": 1830,
    "title": "\u0627\u0644\u062f\u0631\u0633 28: \u0635\u064a\u063a\u0629 \u0627\u0644\u0634\u0631\u0637 \u0627\u0644\u0645\u0627\u0636\u064a\u0629",
    "header_color": "green",
    "pages": [
      {
        "page": 1,
        "total_pages": 2,
        "content": [
          "\u0635\u064a\u063a\u0629 \u0627\u0644\u0634\u0631\u0637 \u0627\u0644\u0645\u0627\u0636\u064a\u0629 (conditionnel pass\u00e9)",
          "\u062a\u0642\u0627\u0628\u0644 \u062a\u0642\u0631\u064a\u0628\u0627 \u00ab\u0644\u0643\u0627\u0646 \u0642\u062f \u0641\u0639\u0644\u00bb\u060c \u0644\u0644\u0646\u062f\u0645 \u0648\u0627\u0644\u0639\u062a\u0627\u0628:",
          "\u0645\u0627 \u0643\u0627\u0646 \u064a\u0646\u0628\u063a\u064a \u0623\u0646 \u064a\u062d\u062f\u062b\u060c \u0648\u0644\u0645 \u064a\u062d\u062f\u062b.",
          "",
          "\u200e\u200f\u0627\u0644\u062a\u0643\u0648\u064a\u0646:\u200f\u200e                           \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 1",
          "\u062a\u0635\u0631\u064a\u0641 avoir \u0623\u0648 \u00eatre \u0641\u064a \u0635\u064a\u063a\u0629 \u0627\u0644\u0634\u0631\u0637\u060c",
          "\u062b\u0645 \u0627\u0633\u0645 \u0627\u0644\u0645\u0641\u0639\u0648\u0644:",
          "\u200ej'aurais aim\u00e9 = \u0643\u0646\u062a \u0623\u0648\u062f",
          "\u200eelle serait venue = \u0644\u0643\u0627\u0646\u062a \u0623\u062a\u062a",
          "",
          "\u200eOn aurait d\u00fb pr\u00e9server la for\u00eat.   \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 2",
          "\u200e   = \u0643\u0627\u0646 \u064a\u0646\u0628\u063a\u064a \u0623\u0646 \u0646\u062d\u0627\u0641\u0638 \u0639\u0644\u0649 \u0627\u0644\u063a\u0627\u0628\u0629",
          "",
          "\u0648\u0647\u0630\u0627 \u0647\u0648 \u062a\u0631\u0643\u064a\u0628 \u0627\u0644\u0639\u062a\u0627\u0628 \u0627\u0644\u0645\u0639\u0647\u0648\u062f:",
          "\u200eaurais/aurait d\u00fb = \u0643\u0627\u0646 \u064a\u0646\u0628\u063a\u064a\u200f\u200e       \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 3",
          "",
          "\u200eTu aurais d\u00fb me le dire.",
          "\u200e   = \u0643\u0627\u0646 \u0639\u0644\u064a\u0643 \u0625\u062e\u0628\u0627\u0631\u064a \u0628\u0630\u0644\u0643"
        ],
        "pronunciation": "Le\u00e7on vingt-huit",
        "pronunciation_mappings": {
          "1": "j'aurais aim\u00e9, elle serait venue",
          "2": "on aurait d\u00fb pr\u00e9server la for\u00eat",
          "3": "tu aurais d\u00fb me le dire"
        }
      },
      {
        "page": 2,
        "total_pages": 2,
        "content": [
          "\u0627\u0641\u062a\u0631\u0627\u0636 \u0645\u0627 \u0641\u0627\u062a: \u0627\u0644\u0634\u0631\u0637 \u0628\u0639\u062f si \u0641\u064a \u0627\u0644\u0645\u0627\u0636\u064a",
          "\u0627\u0644\u0623\u0633\u0628\u0642\u060c \u0648\u0627\u0644\u062c\u0648\u0627\u0628 \u0641\u064a \u0635\u064a\u063a\u0629 \u0627\u0644\u0634\u0631\u0637 \u0627\u0644\u0645\u0627\u0636\u064a\u0629\u060c",
          "\u0648\u064a\u0642\u0627\u0628\u0644\u0647 \u062a\u0642\u0631\u064a\u0628\u0627 \u00ab\u0644\u0648 ... \u0644\u0640\u00bb \u0641\u064a \u0627\u0644\u0639\u0631\u0628\u064a\u0629:",
          "",
          "\u200eSi j'avais su, j'aurais agi.       \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 1",
          "\u200e   = \u0644\u0648 \u0639\u0644\u0645\u062a \u0644\u062a\u0635\u0631\u0641\u062a",
          "\u0648\u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u062a\u0643\u062a\u0641\u064a \u0628\u0627\u0644\u0645\u0627\u0636\u064a \u0641\u064a \u0627\u0644\u0634\u0642\u064a\u0646\u060c \u0623\u0645\u0627",
          "\u0627\u0644\u0641\u0631\u0646\u0633\u064a\u0629 \u0641\u062a\u0644\u0632\u0645\u0647\u0627 \u0635\u064a\u063a\u062a\u0627\u0646 \u0645\u0631\u0643\u0628\u062a\u0627\u0646:",
          "\u200eSi on avait recycl\u00e9 plus t\u00f4t, on   \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 2",
          "\u200eaurait r\u00e9duit les d\u00e9chets.",
          "\u200e   = \u0644\u0648 \u0623\u0639\u062f\u0646\u0627 \u0627\u0644\u062a\u062f\u0648\u064a\u0631 \u0645\u0628\u0643\u0631\u0627",
          "\u200e     \u0644\u0642\u0644\u0644\u0646\u0627 \u0627\u0644\u0646\u0641\u0627\u064a\u0627\u062a",
          "",
          "\u0635\u064a\u063a\u0629 \u0627\u0644\u0634\u0631\u0637 \u0641\u064a Core \u0644\u0645\u0627 \u0642\u062f \u064a\u0643\u0648\u0646\u060c \u0648\u0627\u0644\u0635\u064a\u063a\u0629",
          "\u0627\u0644\u0645\u0627\u0636\u064a\u0629 \u0644\u0641\u0631\u0635\u0629 \u0641\u0627\u062a\u062a.",
          "",
          "\u200eJ'aurais pr\u00e9f\u00e9r\u00e9 ne pas savoir.    \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 3",
          "\u200e   = \u0644\u0643\u0646\u062a \u0641\u0636\u0644\u062a \u0623\u0644\u0627 \u0623\u0639\u0644\u0645"
        ],
        "pronunciation_mappings": {
          "1": "si j'avais su, j'aurais agi",
          "2": "si on avait recycl\u00e9 plus t\u00f4t, on aurait r\u00e9duit les d\u00e9chets",
          "3": "j'aurais pr\u00e9f\u00e9r\u00e9 ne pas savoir"
        }
      }
    ]
  },
  {
    "lesson_id": "029",
    "trigger_word": "celle-ci",
    "trigger_card_number": 2000,
    "title": "\u0627\u0644\u062f\u0631\u0633 29: \u0627\u0644\u0644\u063a\u0629 \u0635\u0627\u0631\u062a \u0644\u0643!",
    "header_color": "gold",
    "pages": [
      {
        "page": 1,
        "total_pages": 2,
        "content": [
          "\u0647\u0630\u0647 \u0622\u062e\u0631 \u0628\u0637\u0627\u0642\u0629 \u0641\u064a \u062d\u0632\u0645\u0629 French Pareto 1:",
          "\u0627\u0644\u0643\u0644\u0645\u0629 \u0631\u0642\u0645 2000!",
          "",
          "2,000 \u0643\u0644\u0645\u0629 \u064829 \u062f\u0631\u0633\u0627 \u0641\u064a \u0627\u0644\u0642\u0648\u0627\u0639\u062f \u0635\u0627\u0631\u062a",
          "\u0648\u0631\u0627\u0621\u0643: \u0623\u0644\u0641 \u0643\u0644\u0645\u0629 \u0645\u0646 Core\u060c \u0648\u0623\u0644\u0641 \u0623\u062e\u0631\u0649",
          "\u0645\u0646 \u0647\u0630\u0647 \u0627\u0644\u062d\u0632\u0645\u0629.",
          "",
          "\u0645\u0627 \u0635\u0627\u0631 \u0641\u064a \u0645\u062a\u0646\u0627\u0648\u0644\u0643 \u0627\u0644\u0622\u0646:",
          "",
          "\u2022 \u0641\u0647\u0645 \u0627\u0644\u0641\u0631\u0646\u0633\u064a\u0629 \u0627\u0644\u0645\u062d\u0643\u064a\u0629 \u0627\u0644\u0639\u0641\u0648\u064a\u0629: \u062d\u0630\u0641 ne\u060c",
          "  \u0648 on \u0628\u062f\u0644 nous\u060c \u0648\u062a\u0628\u062f\u0644 \u0627\u0644\u0623\u0633\u0627\u0644\u064a\u0628",
          "\u2022 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u0635\u064a\u063a\u0629 subjonctif \u0641\u064a \u0643\u0644 \u0645\u0648\u0627\u0636\u0639\u0647\u0627:",
          "  \u0627\u0644\u0634\u0643 \u0648\u0627\u0644\u0639\u0627\u0637\u0641\u0629 \u0648\u0627\u0644\u063a\u0627\u064a\u0629\u060c \u0648 bien que \u0648 pour que",
          "\u2022 \u0628\u0646\u0627\u0621 \u0627\u0644\u062c\u0645\u0644 \u0628\u0635\u064a\u063a\u0629 g\u00e9rondif (\u0635\u064a\u063a\u0629 \u0627\u0644\u062d\u0627\u0644)",
          "  \u0648\u062a\u0642\u062f\u064a\u0645 \u0627\u0644\u0641\u0639\u0644 \u0641\u064a \u0623\u0633\u0644\u0648\u0628 \u0627\u0644\u0635\u062d\u0627\u0641\u0629 \u0627\u0644\u0631\u0633\u0645\u064a",
          "\u2022 \u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u0645\u0627\u0636\u064a \u0627\u0644\u0628\u0633\u064a\u0637 \u0641\u064a \u0627\u0644\u0631\u0648\u0627\u064a\u0627\u062a\u060c \u0648\u0627\u0644\u062a\u0639\u0628\u064a\u0631",
          "  \u0639\u0646 \u0627\u0644\u0646\u062f\u0645 \u0628\u0635\u064a\u063a\u0629 \u0627\u0644\u0634\u0631\u0637 \u0627\u0644\u0645\u0627\u0636\u064a\u0629"
        ],
        "pronunciation": "F\u00e9licitations !",
        "pronunciation_mappings": {}
      },
      {
        "page": 2,
        "total_pages": 2,
        "content": [
          "\u0627\u0644\u062e\u0637\u0648\u0629 \u0627\u0644\u062a\u0627\u0644\u064a\u0629:",
          "",
          "\u062a\u0636\u064a\u0641 \u062d\u0632\u0645\u0629 Pareto 2 \u0627\u0644\u0623\u0644\u0641 \u0627\u0644\u062a\u0627\u0644\u064a\u0629 \u0645\u0646",
          "\u0627\u0644\u0643\u0644\u0645\u0627\u062a\u060c \u0628\u0646\u0627\u0621 \u0639\u0644\u0649 \u0643\u0644 \u0645\u0627 \u062a\u0639\u0644\u0645\u062a\u0647.",
          "",
          "\u0648\u0642\u062f \u0627\u0643\u062a\u0633\u0628\u062a \u0623\u064a\u0636\u0627 \u0645\u0647\u0627\u0631\u0627\u062a \u062a\u062a\u064a\u062d:",
          "",
          "\u2022 \u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u0623\u062e\u0628\u0627\u0631 \u0648\u0627\u0644\u0631\u0648\u0627\u064a\u0627\u062a \u0648\u0645\u0642\u0627\u0644\u0627\u062a \u0627\u0644\u0631\u0623\u064a",
          "  \u0628\u0627\u0644\u0641\u0631\u0646\u0633\u064a\u0629 \u0628\u0645\u0633\u062a\u0648\u0649 B1/B2",
          "\u2022 \u0645\u062a\u0627\u0628\u0639\u0629 \u0627\u0644\u0645\u0642\u0627\u0628\u0644\u0627\u062a \u0648\u0627\u0644\u0645\u0646\u0627\u0638\u0631\u0627\u062a \u0648\u0627\u0644\u0625\u0639\u0644\u0627\u0645 \u0627\u0644\u0631\u0633\u0645\u064a",
          "\u2022 \u0627\u0644\u0643\u062a\u0627\u0628\u0629 \u0627\u0644\u0631\u0633\u0645\u064a\u0629: \u0627\u0644\u0631\u0633\u0627\u0626\u0644 \u0648\u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631\u060c",
          "  \u0648\u0623\u0633\u0644\u0648\u0628 \u0627\u0644\u0634\u0624\u0648\u0646 \u0627\u0644\u0645\u062f\u0646\u064a\u0629 \u0648\u0627\u0644\u0642\u0627\u0646\u0648\u0646\u064a\u0629",
          "\u2022 \u062a\u0628\u062f\u064a\u0644 \u0627\u0644\u0623\u0633\u0644\u0648\u0628 \u0639\u0646 \u0642\u0635\u062f: tu \u0623\u0648 vous\u060c",
          "  \u0643\u0644\u0627\u0645\u0627 \u0623\u0648 \u0643\u062a\u0627\u0628\u0629",
          "",
          "\u0627\u0644\u0644\u063a\u0629 \u0635\u0627\u0631\u062a \u0644\u0643 \u0627\u0644\u0622\u0646: \u0642\u0631\u0627\u0621\u0629 \u0648\u0645\u0634\u0627\u0647\u062f\u0629 \u0648\u062d\u062f\u064a\u062b\u0627.",
          "\u0628\u0627\u0644\u062a\u0648\u0641\u064a\u0642 \u0641\u064a\u0645\u0627 \u064a\u0623\u062a\u064a: Bonne continuation !\u200e"
        ],
        "pronunciation_mappings": {}
      }
    ]
  }
