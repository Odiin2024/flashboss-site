          "EST — eine Schreibung, ZWEI verschiedene",
          "Wörter, und sie KLINGEN sogar",
          "verschieden:",
          "",
          "il est (Verb 'sein') = [ɛ]          Drücke 1",
          "— das End-st ist STUMM",
          "   Il est ici. (Er ist hier.)",
          "",
          "l'est (Substantiv, 'Osten') = [ɛst] Drücke 2",
          "— das End-st WIRD gesprochen",
          "   Il habite à l'est.",
          "   (Er wohnt im Osten.)",
          "",
          "Der Kontext trennt sie immer — das",
          "Substantiv steht nie hinter einem",
          "Subjektpronomen, das Verb schon."
        ],
        "pronunciation": "Leçon quatorze",
        "pronunciation_mappings": {
          "1": "il est ici",
          "2": "il habite à l'est"
        }
      }
