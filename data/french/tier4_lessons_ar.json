[
  {
    "lesson_id": "015",
    "trigger_word": "bureau",
    "trigger_card_number": 601,
    "title": "\u0627\u0644\u062f\u0631\u0633 15: \u0627\u0644\u0645\u0627\u0636\u064a \u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631\u064a",
    "header_color": "green",
    "pages": [
      {
        "page": 1,
        "total_pages": 2,
        "content": [
          "\u0627\u0644\u0645\u0627\u0636\u064a \u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631\u064a (imparfait) \u0632\u0645\u0646 \u0645\u0627\u0636 \u0622\u062e\u0631\u060c",
          "\u0644\u0644\u062e\u0644\u0641\u064a\u0629 \u0648\u0627\u0644\u0648\u0635\u0641 \u0648\u0627\u0644\u0639\u0627\u062f\u0629: \u0643\u064a\u0641 \u0643\u0627\u0646\u062a \u0627\u0644\u0623\u0634\u064a\u0627\u0621\u060c",
          "\u0644\u0627 \u0627\u0644\u0623\u062d\u062f\u0627\u062b \u0627\u0644\u0645\u0641\u0631\u062f\u0629 \u0627\u0644\u0645\u0646\u062a\u0647\u064a\u0629. \u0648\u064a\u0642\u0627\u0628\u0644 \u062a\u0642\u0631\u064a\u0628\u0627",
          "\u00ab\u0643\u0627\u0646 \u064a\u0641\u0639\u0644\u00bb \u0641\u064a \u0627\u0644\u0639\u0631\u0628\u064a\u0629.",
          "",
          "\u0627\u0644\u062a\u0643\u0648\u064a\u0646: \u0645\u0646 \u0635\u064a\u063a\u0629 nous \u0641\u064a \u0627\u0644\u0645\u0636\u0627\u0631\u0639 \u062a\u062d\u0630\u0641",
          "\u0627\u0644\u0646\u0647\u0627\u064a\u0629 -ons\u060c \u062b\u0645 \u062a\u0636\u0627\u0641 \u0627\u0644\u0646\u0647\u0627\u064a\u0627\u062a:",
          "",
          "\u200eje travaill-ais    = \u0643\u0646\u062a \u0623\u0639\u0645\u0644\u200f\u200e    \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 1",
          "\u200etu travaillais     = \u0643\u0646\u062a \u062a\u0639\u0645\u0644",
          "\u200eil/elle travaillait = \u0643\u0627\u0646 \u064a\u0639\u0645\u0644/\u0643\u0627\u0646\u062a \u062a\u0639\u0645\u0644",
          "\u200enous travaillions   = \u0643\u0646\u0627 \u0646\u0639\u0645\u0644",
          "\u200evous travailliez    = \u0643\u0646\u062a\u0645 \u062a\u0639\u0645\u0644\u0648\u0646",
          "\u200eils travaillaient   = \u0643\u0627\u0646\u0648\u0627 \u064a\u0639\u0645\u0644\u0648\u0646",
          "",
          "\u0627\u0633\u062a\u062b\u0646\u0627\u0621 \u0648\u0627\u062d\u062f: \u0644\u0644\u0641\u0639\u0644 \u00eatre \u062c\u0630\u0631 \u063a\u064a\u0631 \u0642\u064a\u0627\u0633\u064a:",
          "\u200e\u00e9t-: j'\u00e9tais, tu \u00e9tais, il \u00e9tait."
        ],
        "pronunciation": "Le\u00e7on quinze",
        "pronunciation_mappings": {
          "1": "je travaillais, tu travaillais, il travaillait, nous travaillions, ils travaillaient"
        }
      },
      {
        "page": 2,
        "total_pages": 2,
        "content": [
          "\u200eimparfait: \u0627\u0644\u062e\u0644\u0641\u064a\u0629 \u0648\u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631\u200f\u200e     \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 1",
          "\u200eJe travaillais dans une entreprise.",
          "\u200e   = \u0643\u0646\u062a \u0623\u0639\u0645\u0644 \u0641\u064a \u0634\u0631\u0643\u0629",
          "\u064a\u0631\u0633\u0645 \u0627\u0644\u0645\u0634\u0647\u062f\u060c \u0628\u0644\u0627 \u0646\u0642\u0637\u0629 \u0646\u0647\u0627\u064a\u0629 \u0648\u0627\u0636\u062d\u0629.",
          "",
          "\u200epass\u00e9 compos\u00e9: \u0627\u0644\u062d\u062f\u062b \u0646\u0641\u0633\u0647\u200f\u200e         \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 2",
          "\u200eJ'ai chang\u00e9 d'entreprise en mars.",
          "\u200e   = \u0627\u0646\u062a\u0642\u0644\u062a \u0625\u0644\u0649 \u0634\u0631\u0643\u0629 \u0623\u062e\u0631\u0649 \u0641\u064a \u0645\u0627\u0631\u0633 (\u0622\u0630\u0627\u0631)",
          "\u062d\u062f\u062b \u0648\u0627\u062d\u062f \u062a\u0645 \u0648\u0627\u0646\u062a\u0647\u0649.",
          "",
          "\u200e\u200f\u0627\u0644\u0627\u062b\u0646\u0627\u0646 \u0641\u064a \u062c\u0645\u0644\u0629 \u0648\u0627\u062d\u062f\u0629:\u200f\u200e            \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 3",
          "\u200eJe travaillais quand le t\u00e9l\u00e9phone a sonn\u00e9.",
          "\u200e   = \u0643\u0646\u062a \u0623\u0639\u0645\u0644 \u062d\u064a\u0646 \u0631\u0646 \u0627\u0644\u0647\u0627\u062a\u0641",
          "\u0627\u0644\u0645\u0627\u0636\u064a \u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631\u064a \u064a\u0631\u0633\u0645 \u0627\u0644\u0645\u0634\u0647\u062f\u060c \u0648\u0627\u0644\u0645\u0627\u0636\u064a",
          "\u0627\u0644\u0645\u0631\u0643\u0628 \u064a\u0642\u0637\u0639\u0647\u060c \u0648\u0647\u0630\u0627 \u0642\u0631\u064a\u0628 \u0645\u0645\u0627 \u0641\u064a \u0627\u0644\u0639\u0631\u0628\u064a\u0629:",
          "\u00ab\u0643\u0646\u062a \u0623\u0639\u0645\u0644\u00bb \u062e\u0644\u0641\u064a\u0629\u060c \u0648\u00ab\u0631\u0646\u00bb \u062d\u062f\u062b."
        ],
        "pronunciation_mappings": {
          "1": "je travaillais dans une entreprise",
          "2": "j'ai chang\u00e9 d'entreprise en mars",
          "3": "je travaillais quand le t\u00e9l\u00e9phone a sonn\u00e9"
        }
      }
    ]
  },
  {
    "lesson_id": "016",
    "trigger_word": "directeur",
    "trigger_card_number": 614,
    "title": "\u0627\u0644\u062f\u0631\u0633 16: \u0635\u064a\u063a\u0629 \u0627\u0644\u0634\u0631\u0637",
    "header_color": "green",
    "pages": [
      {
        "page": 1,
        "total_pages": 2,
        "content": [
          "\u0635\u064a\u063a\u0629 \u0627\u0644\u0634\u0631\u0637 (conditionnel) \u062a\u0642\u0627\u0628\u0644 \u062a\u0642\u0631\u064a\u0628\u0627",
          "\u00ab\u0644\u0641\u0639\u0644\u062a\u00bb \u0623\u0648 \u00ab\u0643\u0646\u062a \u0633\u0623\u0641\u0639\u0644\u00bb. \u0648\u0627\u0644\u062e\u0628\u0631 \u0627\u0644\u0633\u0627\u0631:",
          "\u0646\u0647\u0627\u064a\u0627\u062a\u0647\u0627 \u0646\u0647\u0627\u064a\u0627\u062a imparfait\u060c \u0628\u062c\u0630\u0631 \u0645\u062e\u062a\u0644\u0641.",
          "",
          "\u0627\u0644\u062c\u0630\u0631 \u0647\u0648 \u0627\u0644\u0645\u0635\u062f\u0631 \u0646\u0641\u0633\u0647\u060c \u0648\u062a\u062d\u0630\u0641 e \u0627\u0644\u0623\u062e\u064a\u0631\u0629",
          "\u0645\u0646 \u0627\u0644\u0623\u0641\u0639\u0627\u0644 \u0627\u0644\u0645\u0646\u062a\u0647\u064a\u0629 \u0628\u0640 -re:",
          "",
          "\u200eje penser-ais   = \u0643\u0646\u062a \u0633\u0623\u0641\u0643\u0631\u200f\u200e       \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 1",
          "\u200etu penserais    = \u0643\u0646\u062a \u0633\u062a\u0641\u0643\u0631",
          "\u200eil/elle penserait = \u0643\u0627\u0646 \u0633\u064a\u0641\u0643\u0631/\u0643\u0627\u0646\u062a \u0633\u062a\u0641\u0643\u0631",
          "\u200enous penserions = \u0643\u0646\u0627 \u0633\u0646\u0641\u0643\u0631",
          "\u200eils penseraient = \u0643\u0627\u0646\u0648\u0627 \u0633\u064a\u0641\u0643\u0631\u0648\u0646",
          "",
          "\u200e\u200f\u062c\u0630\u0648\u0631 \u063a\u064a\u0631 \u0642\u064a\u0627\u0633\u064a\u0629 \u0644\u0644\u062d\u0641\u0638:\u200f\u200e            \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 2",
          "\u200e\u00eatre: ser-     avoir: aur-    aller: ir-",
          "\u200efaire: fer-    vouloir: voudr-",
          "\u200epouvoir: pourr-   devoir: devr-"
        ],
        "pronunciation": "Le\u00e7on seize",
        "pronunciation_mappings": {
          "1": "je penserais, tu penserais, il penserait, nous penserions, ils penseraient",
          "2": "je serais, j'aurais, j'irais, je ferais, je voudrais, je pourrais, je devrais"
        }
      },
      {
        "page": 2,
        "total_pages": 2,
        "content": [
          "\u0627\u0633\u062a\u0639\u0645\u0627\u0644\u0627\u062a \u0635\u064a\u063a\u0629 \u0627\u0644\u0634\u0631\u0637:",
          "",
          "\u200e\u200f\u0627\u0644\u0637\u0644\u0628 \u0627\u0644\u0645\u0647\u0630\u0628:\u200f\u200e                     \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 1",
          "\u200eJe voudrais un caf\u00e9 = \u0623\u0648\u062f \u0641\u0646\u062c\u0627\u0646 \u0642\u0647\u0648\u0629",
          "\u200ePourriez-vous m'aider ?\u200e",
          "\u200e   = \u0647\u0644 \u064a\u0645\u0643\u0646\u0643\u0645 \u0645\u0633\u0627\u0639\u062f\u062a\u064a\u061f",
          "",
          "\u200e\u200f\u0627\u0644\u0631\u0623\u064a \u0627\u0644\u0645\u062a\u062d\u0641\u0638:\u200f\u200e                    \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 2",
          "\u200eJe penserais que c'est vrai.",
          "\u200e   = \u0623\u0645\u064a\u0644 \u0625\u0644\u0649 \u0627\u0644\u0638\u0646 \u0623\u0646 \u0647\u0630\u0627 \u0635\u062d\u064a\u062d",
          "\u200eCe serait mieux = \u0644\u0643\u0627\u0646 \u0630\u0644\u0643 \u0623\u0641\u0636\u0644",
          "",
          "",
          "\u0648\u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636 \u0628\u0640 si \u0645\u0639 imparfait\u060c \u0648\u0647\u0648 \u0646\u0645\u0637",
          "\u064a\u0623\u062a\u064a \u062a\u0641\u0635\u064a\u0644\u0647 \u0641\u064a Pareto:",
          "\u200eSi j'avais le temps, je viendrais.",
          "\u200e   = \u0644\u0648 \u0643\u0627\u0646 \u0644\u062f\u064a \u0648\u0642\u062a \u0644\u0623\u062a\u064a\u062a",
          "\u0648\u064a\u0642\u0627\u0628\u0644\u0647 \u062a\u0642\u0631\u064a\u0628\u0627 \u062a\u0631\u0643\u064a\u0628 \u00ab\u0644\u0648 ... \u0644\u0640\u00bb \u0641\u064a \u0627\u0644\u0639\u0631\u0628\u064a\u0629."
        ],
        "pronunciation_mappings": {
          "1": "je voudrais un caf\u00e9, pourriez-vous m'aider",
          "2": "je penserais que c'est vrai, ce serait mieux"
        }
      }
    ]
  }
]
