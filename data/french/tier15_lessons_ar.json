[
  {
    "lesson_id": "035",
    "trigger_word": "soudainement",
    "trigger_card_number": 2851,
    "title": "\u0627\u0644\u062f\u0631\u0633 35: \u062e\u0644\u0627\u0635\u0629 \u0627\u0644\u0645\u0642\u0627\u0645\u0627\u062a",
    "header_color": "green",
    "pages": [
      {
        "page": 1,
        "total_pages": 2,
        "content": [
          "\u062e\u0644\u0627\u0635\u0629 \u0627\u0644\u0645\u0642\u0627\u0645\u0627\u062a: \u0627\u0644\u0645\u0639\u0646\u0649 \u0646\u0641\u0633\u0647 \u0641\u064a \u062b\u0644\u0627\u062b \u062d\u0644\u0644\u060c",
          "\u0645\u0646 \u0627\u0644\u0643\u0644\u0627\u0645 \u0627\u0644\u0639\u0641\u0648\u064a \u0625\u0644\u0649 \u0627\u0644\u0643\u062a\u0627\u0628\u0629 \u0627\u0644\u0631\u0633\u0645\u064a\u0629.",
          "\u0648\u0647\u0630\u0647 \u0623\u0632\u0648\u0627\u062c \u0645\u0631\u062a \u0641\u064a \u0627\u0644\u062d\u0632\u0645\u0629 \u0643\u0644\u0647\u0627:",
          "",
          "\u200esoudain(ement) / subitement        \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 1",
          "\u0627\u0644\u0623\u0648\u0644 \u0639\u0641\u0648\u064a \u0648\u0627\u0644\u062b\u0627\u0646\u064a \u0645\u062d\u0627\u064a\u062f\u060c \u0648 soudain \u0647\u0648",
          "\u0627\u0644\u0627\u062e\u062a\u064a\u0627\u0631 \u0627\u0644\u0645\u0639\u062a\u0627\u062f \u0641\u064a \u0627\u0644\u0643\u0644\u0627\u0645 \u0627\u0644\u064a\u0648\u0645\u064a.",
          "",
          "\u200equand m\u00eame \u2192 n\u00e9anmoins, toutefois  \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 2",
          "\u0627\u0633\u062a\u062f\u0631\u0627\u0643 (\u00ab\u0648\u0645\u0639 \u0630\u0644\u0643\u00bb)\u060c \u0645\u0646 \u0627\u0644\u0643\u0644\u0627\u0645 \u0625\u0644\u0649 \u0627\u0644\u0643\u062a\u0627\u0628\u0629",
          "",
          "\u200edu coup \u2192 par cons\u00e9quent,          \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 3",
          "\u200ed\u00e8s lors",
          "\u0646\u062a\u064a\u062c\u0629 (\u00ab\u0644\u0630\u0644\u0643\u00bb)\u060c \u0645\u0646 \u0627\u0644\u0643\u0644\u0627\u0645 \u0625\u0644\u0649 \u0627\u0644\u0643\u062a\u0627\u0628\u0629",
          "",
          "\u0644\u0627 \u0634\u064a\u0621 \u0647\u0646\u0627 \u00ab\u0623\u0635\u062d\u00bb \u0645\u0646 \u063a\u064a\u0631\u0647\u060c \u0641\u0644\u0643\u0644 \u0645\u0642\u0627\u0645 \u0645\u0642\u0627\u0644:",
          "\u0643\u0644\u0645\u0629 n\u00e9anmoins \u0641\u064a \u0631\u0633\u0627\u0644\u0629 \u0646\u0635\u064a\u0629 \u063a\u0631\u064a\u0628\u0629",
          "\u0643\u063a\u0631\u0627\u0628\u0629 quand m\u00eame \u0641\u064a \u062a\u0642\u0631\u064a\u0631 \u0631\u0633\u0645\u064a."
        ],
        "pronunciation": "Le\u00e7on trente-cinq",
        "pronunciation_mappings": {
          "1": "soudain, soudainement, subitement",
          "2": "quand m\u00eame, n\u00e9anmoins, toutefois",
          "3": "du coup, par cons\u00e9quent, d\u00e8s lors"
        }
      },
      {
        "page": 2,
        "total_pages": 2,
        "content": [
          "\u0635\u064a\u0627\u063a\u0629 \u0623\u062e\u064a\u0631\u0629 \u0644\u0644\u062e\u0628\u0631 \u0646\u0641\u0633\u0647 \u0641\u064a \u062b\u0644\u0627\u062b\u0629 \u0645\u0642\u0627\u0645\u0627\u062a:",
          "",
          "\u200eTU: Le patron a dit qu'il          \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 1",
          "\u200epartait, tu te rends compte ?\u200e",
          "",
          "\u200eVOUS: Le directeur a annonc\u00e9       \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 2",
          "\u200equ'il partait ; vous imaginez ?\u200e",
          "",
          "\u200eSOUTENU: La direction a annonc\u00e9    \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 3",
          "\u200eson d\u00e9part, suscitant une vive",
          "\u200esurprise.",
          "\u200e   = \u0623\u0639\u0644\u0646\u062a \u0627\u0644\u0625\u062f\u0627\u0631\u0629 \u0631\u062d\u064a\u0644\u0647\u060c \u0645\u0645\u0627 \u0623\u062b\u0627\u0631 \u062f\u0647\u0634\u0629 \u0639\u0627\u0645\u0629",
          "",
          "\u0648\u0627\u0644\u0623\u0633\u0644\u0648\u0628 \u0627\u0644\u0631\u0641\u064a\u0639 (soutenu) \u0643\u062b\u064a\u0631\u0627 \u0645\u0627 \u064a\u0636\u0639",
          "\u0645\u0643\u0627\u0646 \u0627\u0644\u062c\u0645\u0644\u0629 \u0627\u0644\u0645\u0646\u0642\u0648\u0644\u0629 \u0627\u0633\u0645\u0627 \u0645\u0635\u0648\u063a\u0627 \u0645\u0646 \u0627\u0644\u0641\u0639\u0644\u060c",
          "\u0645\u062b\u0644 d\u00e9part \u0648 surprise\u060c \u0648\u0647\u064a \u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062f\u0631\u0633 32",
          "(\u0635\u064a\u0627\u063a\u0629 \u0627\u0644\u0627\u0633\u0645 \u0645\u0646 \u0627\u0644\u0641\u0639\u0644) \u062f\u0627\u062e\u0644 \u062c\u0645\u0644\u0629 \u0643\u0627\u0645\u0644\u0629."
        ],
        "pronunciation_mappings": {
          "1": "le patron a dit qu'il partait, tu te rends compte",
          "2": "le directeur a annonc\u00e9 qu'il partait ; vous imaginez",
          "3": "la direction a annonc\u00e9 son d\u00e9part, suscitant une vive surprise"
        }
      }
    ]
  },
  {
    "lesson_id": "036",
    "trigger_word": "chapitre",
    "trigger_card_number": 2926,
    "title": "\u0627\u0644\u062f\u0631\u0633 36: \u0643\u062a\u0627\u0628\u0629 \u0627\u0644\u0645\u0627\u0636\u064a \u0627\u0644\u0628\u0633\u064a\u0637",
    "header_color": "green",
    "pages": [
      {
        "page": 1,
        "total_pages": 2,
        "content": [
          "\u0627\u0644\u0645\u0627\u0636\u064a \u0627\u0644\u0628\u0633\u064a\u0637 (pass\u00e9 simple) \u0644\u0644\u0643\u062a\u0627\u0628\u0629 \u0647\u0630\u0647",
          "\u0627\u0644\u0645\u0631\u0629: \u0625\u0646\u062a\u0627\u062c \u062e\u0641\u064a\u0641 \u0645\u0648\u062c\u0647\u060c \u0644\u0643\u062a\u0627\u0628\u0629 \u0641\u0635\u0644 \u0642\u0635\u064a\u0631",
          "\u0645\u0646 \u0642\u0635\u0629.",
          "",
          "\u200e-ER: -a, -\u00e8rent                    \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 1",
          "\u062d\u0630\u0641 -er\u060c \u062b\u0645 \u0632\u064a\u0627\u062f\u0629 -a \u0644\u0644\u063a\u0627\u0626\u0628\u060c \u0648 -\u00e8rent \u0644\u062c\u0645\u0639\u0647:",
          "\u200eil entra, elle ferma, ils arriv\u00e8rent",
          "\u0648\u0627\u0644\u062d\u0631\u0648\u0641 -ent \u0627\u0644\u0623\u062e\u064a\u0631\u0629 \u0644\u0627 \u062a\u0646\u0637\u0642.",
          "",
          "\u200e-IR / -RE: -it, -irent             \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 2",
          "حذف -ir/-re وزيادة -it للغائب، و -irent لجمعه:",
          "\u200eil comprit, elle partit, ils sortirent",
          "هذا في المنتظمة، أما prendre فغير قياسي: prit",
          "\u200eIl entra dans le premier           \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 3",
          "\u200echapitre sans savoir ce qui",
          "\u200el'attendait.",
          "\u200e   = \u062f\u062e\u0644 \u0627\u0644\u0641\u0635\u0644 \u0627\u0644\u0623\u0648\u0644 \u062f\u0648\u0646 \u0623\u0646 \u064a\u0639\u0644\u0645 \u0645\u0627 \u064a\u0646\u062a\u0638\u0631\u0647"
        ],
        "pronunciation": "Le\u00e7on trente-six",
        "pronunciation_mappings": {
          "1": "il entra, elle ferma, ils arriv\u00e8rent",
          "2": "il comprit, elle partit, ils sortirent",
          "3": "il entra dans le premier chapitre sans savoir ce qui l'attendait"
        }
      },
      {
        "page": 2,
        "total_pages": 2,
        "content": [
          "\u0644\u0646\u0643\u062a\u0628 \u0627\u0644\u0622\u0646 \u0639\u0644\u0649 \u0625\u064a\u0642\u0627\u0639 \u0627\u0644\u0633\u0631\u062f \u0627\u0644\u0643\u0644\u0627\u0633\u064a\u0643\u064a:",
          "\u062b\u0644\u0627\u062b\u0629 \u0623\u0641\u0639\u0627\u0644 \u0645\u062a\u062a\u0627\u0628\u0639\u0629.",
          "",
          "\u200eil entra, il vit, il comprit       \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 1",
          "\u200e   = \u062f\u062e\u0644\u060c \u0641\u0631\u0623\u0649\u060c \u0641\u0641\u0647\u0645",
          "",
          "\u200eelle ouvrit la porte, elle         \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 2",
          "\u200eregarda, elle sourit.",
          "\u200e   = \u0641\u062a\u062d\u062a \u0627\u0644\u0628\u0627\u0628\u060c \u0648\u0646\u0638\u0631\u062a\u060c \u0648\u0627\u0628\u062a\u0633\u0645\u062a",
          "",
          "\u200e\u200f\u0627\u0644\u062c\u0630\u0648\u0631 \u063a\u064a\u0631 \u0627\u0644\u0642\u064a\u0627\u0633\u064a\u0629 (\u0627\u0644\u062f\u0631\u0633 26)\u200f\u200e     \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 3",
          "\u200e\u00eatre \u2192 il fut, avoir \u2192 il eut,",
          "\u200efaire \u2192 il fit",
          "\u0648\u0645\u0646 \u063a\u064a\u0631 \u0627\u0644\u0642\u064a\u0627\u0633\u064a: prendre \u2192 prit\u060c venir \u2192 vint.",
          "\u0648\u0627\u0644\u0641\u0631\u0646\u0633\u064a\u0629 \u062a\u0639\u064a\u062f \u0627\u0644\u0636\u0645\u064a\u0631 \u0647\u0646\u0627 \u0645\u0639 \u0643\u0644 \u0641\u0639\u0644\u060c \u0623\u0645\u0627",
          "\u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0641\u0636\u0645\u064a\u0631\u0647\u0627 \u0645\u0633\u062a\u062a\u0631\u060c \u0648\u0627\u0644\u0648\u0635\u0644 \u0628\u0627\u0644\u0641\u0627\u0621 \u0623\u0648 \u0627\u0644\u0648\u0627\u0648.",
          "\u0648\u0627\u0644\u0645\u0647\u0645 \u0641\u064a \u0627\u0644\u0643\u062a\u0627\u0628\u0629 \u0627\u0644\u062e\u0641\u064a\u0641\u0629 \u0647\u064a\u0643\u0644 \u0627\u0644\u062c\u0645\u0644\u0629\u060c",
          "\u0644\u0627 \u062d\u0641\u0638 \u0643\u0644 \u0627\u0644\u0623\u0641\u0639\u0627\u0644 \u063a\u064a\u0631 \u0627\u0644\u0642\u064a\u0627\u0633\u064a\u0629."
        ],
        "pronunciation_mappings": {
          "1": "il entra, il vit, il comprit",
          "2": "elle ouvrit la porte, elle regarda, elle sourit",
          "3": "il fut, il eut, il fit"
        }
      }
    ]
  },
  {
    "lesson_id": "037",
    "trigger_word": "dessert",
    "trigger_card_number": 3000,
    "title": "\u0627\u0644\u062f\u0631\u0633 37: \u0627\u0644\u0645\u0646\u0638\u0648\u0645\u0629 \u0643\u0627\u0645\u0644\u0629",
    "header_color": "gold",
    "pages": [
      {
        "page": 1,
        "total_pages": 2,
        "content": [
          "\u0647\u0630\u0647 \u0622\u062e\u0631 \u0628\u0637\u0627\u0642\u0629 \u0641\u064a \u0645\u0646\u0638\u0648\u0645\u0629 \u0627\u0644\u0641\u0631\u0646\u0633\u064a\u0629 \u0643\u0627\u0645\u0644\u0629:",
          "\u0627\u0644\u0643\u0644\u0645\u0629 \u0631\u0642\u0645 3000!",
          "",
          "3,000 \u0643\u0644\u0645\u0629\u060c \u064837 \u062f\u0631\u0633\u0627 \u0641\u064a \u0627\u0644\u0642\u0648\u0627\u0639\u062f\u060c \u064815 \u0645\u0631\u062d\u0644\u0629.",
          "\u062d\u0632\u0645 Core \u0648 Pareto 1 \u0648 Pareto 2 \u0643\u0644\u0647\u0627 \u0635\u0627\u0631\u062a",
          "\u0648\u0631\u0627\u0621\u0643 \u0627\u0644\u0622\u0646.",
          "",
          "\u0645\u0627 \u0635\u0627\u0631 \u0641\u064a \u0645\u062a\u0646\u0627\u0648\u0644\u0643 \u0627\u0644\u0622\u0646:",
          "",
          "\u2022 \u0642\u0631\u0627\u0621\u0629 \u0631\u0648\u0627\u064a\u0629 \u0623\u0648 \u0635\u062d\u064a\u0641\u0629 \u0623\u0648 \u0645\u0642\u0627\u0644 \u0623\u0643\u0627\u062f\u064a\u0645\u064a",
          "  \u0628\u0627\u0644\u0641\u0631\u0646\u0633\u064a\u0629 \u062f\u0648\u0646 \u0645\u0633\u0627\u0639\u062f\u0629",
          "\u2022 \u0645\u062a\u0627\u0628\u0639\u0629 \u0627\u0644\u0645\u0646\u0627\u0638\u0631\u0627\u062a \u0648\u0627\u0644\u0645\u0642\u0627\u0628\u0644\u0627\u062a \u0648\u0627\u0644\u0625\u0639\u0644\u0627\u0645",
          "  \u0627\u0644\u0641\u0631\u0646\u0633\u064a \u0627\u0644\u0631\u0633\u0645\u064a",
          "\u2022 \u062a\u0628\u062f\u064a\u0644 \u0627\u0644\u0645\u0642\u0627\u0645 \u0639\u0646 \u0642\u0635\u062f: tu \u0623\u0648 vous \u0623\u0648 soutenu",
          "\u2022 \u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u0645\u0627\u0636\u064a \u0627\u0644\u0628\u0633\u064a\u0637 \u0648\u0643\u062a\u0627\u0628\u062a\u0647 \u0641\u064a \u0627\u0644\u0633\u0631\u062f\u060c",
          "  \u0648\u062a\u0645\u064a\u064a\u0632 \u0635\u064a\u063a\u0629 subjonctif imparfait",
          "\u2022 \u0646\u0642\u0644 \u0643\u0644\u0627\u0645 \u0627\u0644\u0622\u062e\u0631\u064a\u0646 \u0628\u062a\u0648\u0627\u0641\u0642 \u0627\u0644\u0623\u0632\u0645\u0646\u0629 \u0627\u0644\u0635\u062d\u064a\u062d"
        ],
        "pronunciation": "F\u00e9licitations !",
        "pronunciation_mappings": {}
      },
      {
        "page": 2,
        "total_pages": 2,
        "content": [
          "\u0627\u0644\u062e\u0637\u0648\u0629 \u0627\u0644\u062a\u0627\u0644\u064a\u0629:",
          "",
          "\u0644\u0627 \u062a\u0648\u062c\u062f \u062d\u0632\u0645\u0629 Pareto 3: \u0641\u0647\u0630\u0647 \u0647\u064a \u0627\u0644\u0645\u0646\u0638\u0648\u0645\u0629",
          "\u0643\u0627\u0645\u0644\u0629\u060c \u0648\u0645\u0627 \u0628\u0642\u064a \u0647\u0648 \u0627\u0644\u0644\u063a\u0629 \u0646\u0641\u0633\u0647\u0627:",
          "",
          "\u2022 \u0642\u0631\u0627\u0621\u0629 \u0645\u0627 \u064a\u0633\u062a\u0647\u0648\u064a \u0627\u0644\u0642\u0627\u0631\u0626 \u0641\u0639\u0644\u0627: \u0631\u0648\u0627\u064a\u0629\u060c",
          "  \u0623\u0648 \u0627\u0644\u0623\u062e\u0628\u0627\u0631\u060c \u0623\u0648 \u0648\u0635\u0641\u0629 \u0637\u0628\u062e",
          "\u2022 \u0645\u0634\u0627\u0647\u062f\u0629 \u0627\u0644\u0623\u0641\u0644\u0627\u0645 \u0648\u0627\u0644\u0645\u0633\u0644\u0633\u0644\u0627\u062a \u0627\u0644\u0641\u0631\u0646\u0633\u064a\u0629",
          "  \u062f\u0648\u0646 \u062a\u0631\u062c\u0645\u0629",
          "\u2022 \u0645\u062d\u0627\u062f\u062b\u0629 \u0627\u0644\u0646\u0627\u0633 \u0628\u0627\u0644\u0641\u0631\u0646\u0633\u064a\u0629\u060c \u0648\u062c\u0647\u0627 \u0644\u0648\u062c\u0647",
          "  \u0623\u0648 \u0639\u0628\u0631 \u0627\u0644\u0625\u0646\u062a\u0631\u0646\u062a",
          "\u2022 \u0627\u0644\u0643\u062a\u0627\u0628\u0629: \u064a\u0648\u0645\u064a\u0627\u062a\u060c \u0623\u0648 \u0631\u0633\u0627\u0644\u0629 \u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629\u060c",
          "  \u0623\u0648 \u0631\u0633\u0627\u0644\u0629 \u0628\u0627\u0644\u0623\u0633\u0644\u0648\u0628 \u0627\u0644\u0631\u0641\u064a\u0639 (soutenu) \u0644\u0644\u0645\u062a\u0639\u0629",
          "",
          "\u0644\u0645 \u062a\u0643\u0646 3,000 \u0643\u0644\u0645\u0629 \u063a\u0627\u064a\u0629\u060c \u0628\u0644 \u0643\u0627\u0646\u062a \u0627\u0644\u0645\u0641\u062a\u0627\u062d.",
