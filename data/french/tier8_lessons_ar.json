[
  {
    "lesson_id": "024",
    "trigger_word": "diversit\u00e9",
    "trigger_card_number": 1402,
    "title": "\u0627\u0644\u062f\u0631\u0633 24: \u0635\u064a\u063a\u0629 subjonctif \u0643\u0627\u0645\u0644\u0629",
    "header_color": "green",
    "pages": [
      {
        "page": 1,
        "total_pages": 3,
        "content": [
          "\u0635\u064a\u063a\u0629 subjonctif (\u0635\u064a\u063a\u0629 \u0627\u0644\u0627\u062d\u062a\u0645\u0627\u0644) \u0628\u0627\u0644\u062a\u0641\u0635\u064a\u0644:",
          "\u0643\u0644 \u0645\u0627 \u064a\u0633\u062a\u062f\u0639\u064a\u0647\u0627\u060c \u0648\u0643\u0644 \u0627\u0644\u0623\u0645\u062b\u0644\u0629 \u0641\u064a \u0627\u0644\u0645\u0636\u0627\u0631\u0639:",
          "",
          "\u200e\u200f\u0627\u0644\u0631\u0623\u064a \u0627\u0644\u0645\u0646\u0641\u064a \u064a\u0633\u062a\u062f\u0639\u064a\u0647\u0627:\u200f\u200e             \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 1",
          "\u200eJe ne pense pas que ce soit juste.",
          "\u200e   = \u0644\u0627 \u0623\u0638\u0646 \u0623\u0646 \u0647\u0630\u0627 \u0645\u0646\u0635\u0641",
          "",
          "\u200e\u200f\u0648\u0627\u0644\u0634\u0643 \u0643\u0630\u0644\u0643:\u200f\u200e                        \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 2",
          "\u200eJe doute qu'il ait raison.",
          "\u200e   = \u0623\u0634\u0643 \u0641\u064a \u0623\u0646\u0647 \u0645\u062d\u0642",
          "",
          "\u0648\u0644\u0644\u0645\u0642\u0627\u0631\u0646\u0629: \u0627\u0644\u0631\u0623\u064a \u0627\u0644\u0645\u062b\u0628\u062a \u0644\u0627 \u064a\u0633\u062a\u062f\u0639\u064a\u0647\u0627\u060c \u0628\u0644",
          "\u064a\u0623\u062a\u064a \u0628\u0639\u062f\u0647 \u0635\u064a\u063a\u0629 indicatif (\u0635\u064a\u063a\u0629 \u0627\u0644\u0625\u062e\u0628\u0627\u0631):",
          "\u200eJe pense que c'est juste.          \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 3",
          "\u200e   = \u0623\u0638\u0646 \u0623\u0646 \u0647\u0630\u0627 \u0645\u0646\u0635\u0641",
          "",
          "\u0641\u0627\u0644\u0645\u0641\u062a\u0627\u062d \u0642\u0628\u0644 que \u064a\u062d\u062f\u062f \u0627\u0644\u0635\u064a\u063a\u0629\u060c \u0644\u0627 \u0627\u0644\u0645\u0639\u0646\u0649 \u0648\u062d\u062f\u0647.",
          "\u0648\u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u062a\u0642\u0648\u0644 \u00ab\u0623\u0638\u0646 \u0623\u0646\u00bb \u0648\u00ab\u0644\u0627 \u0623\u0638\u0646 \u0623\u0646\u00bb \u0628\u0644\u0627 \u0641\u0631\u0642."
        ],
        "pronunciation": "Le\u00e7on vingt-quatre",
        "pronunciation_mappings": {
          "1": "je ne pense pas que ce soit juste",
          "2": "je doute qu'il ait raison",
          "3": "je pense que c'est juste"
        }
      },
      {
        "page": 2,
        "total_pages": 3,
        "content": [
          "\u0648\u0627\u0644\u0639\u0627\u0637\u0641\u0629 \u062a\u0633\u062a\u062f\u0639\u064a\u0647\u0627 \u0623\u064a\u0636\u0627:",
          "",
          "\u200eJe suis content que la maison      \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 1",
          "\u200esoit plus calme.",
          "\u200e   = \u064a\u0633\u0631\u0646\u064a \u0623\u0646 \u0627\u0644\u0628\u064a\u062a \u0635\u0627\u0631 \u0623\u0647\u062f\u0623",
          "",
          "\u200eJ'ai peur qu'il n'y ait pas assez  \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 2",
          "\u200ede temps.",
          "\u200e   = \u0623\u062e\u0634\u0649 \u0623\u0644\u0627 \u064a\u0643\u0641\u064a \u0627\u0644\u0648\u0642\u062a",
          "",
          "\u0648\u0628\u0639\u062f \u0645\u0627 \u0645\u0639\u0646\u0627\u0647 \u00ab\u0645\u0639 \u0623\u0646\u00bb \u062a\u0623\u062a\u064a \u062f\u0627\u0626\u0645\u0627:",
          "\u200ebien que / quoique = \u0645\u0639 \u0623\u0646\u200f\u200e         \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 3",
          "",
          "\u200eBien que ce soit difficile, il",
          "\u200efaut agir.",
          "\u200e   = \u0645\u0639 \u0623\u0646 \u0627\u0644\u0623\u0645\u0631 \u0635\u0639\u0628\u060c \u0644\u0627 \u0628\u062f \u0645\u0646 \u0627\u0644\u062a\u062d\u0631\u0643"
        ],
        "pronunciation_mappings": {
          "1": "je suis content que la maison soit plus calme",
          "2": "j'ai peur qu'il n'y ait pas assez de temps",
          "3": "bien que ce soit difficile, il faut agir"
        }
      },
      {
        "page": 3,
        "total_pages": 3,
        "content": [
          "\u0648\u0627\u0644\u063a\u0627\u064a\u0629 \u062a\u0633\u062a\u062f\u0639\u064a\u0647\u0627:",
          "",
          "\u200epour que / afin que = \u0644\u0643\u064a\u200f\u200e          \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 1",
          "\u200ePour que chacun ait sa place,",
          "\u200eon ajoute des chaises.",
          "\u200e   = \u0644\u0643\u064a \u064a\u062c\u062f \u0643\u0644 \u0641\u0631\u062f \u0645\u0642\u0639\u062f\u0627\u060c \u0646\u0636\u064a\u0641 \u0643\u0631\u0627\u0633\u064a",
          "",
          "\u0648\u062d\u062f\u0648\u062f \u0627\u0644\u0632\u0645\u0646 \u062a\u0633\u062a\u062f\u0639\u064a\u0647\u0627 \u0643\u0630\u0644\u0643\u060c \u0648\u0623\u0648\u0644\u0647\u0627",
          "\u0645\u0641\u062a\u0627\u062d \u0645\u0646 Core\u060c \u0648\u0645\u0627 \u0632\u0627\u0644 \u0645\u0647\u0645\u0627:",
          "\u200eavant que = \u0642\u0628\u0644 \u0623\u0646\u200f\u200e                 \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 2",
          "\u200eAvant qu'il soit trop tard,",
          "\u200eagissons.",
          "\u200e   = \u0644\u0646\u062a\u062d\u0631\u0643 \u0642\u0628\u0644 \u0641\u0648\u0627\u062a \u0627\u0644\u0623\u0648\u0627\u0646",
          "",
          "\u200ejusqu'\u00e0 ce que = \u062d\u062a\u0649\u200f\u200e               \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 3",
          "\u200eOn se bat jusqu'\u00e0 ce que ce soit r\u00e9gl\u00e9.",
          "\u200e   = \u0646\u0648\u0627\u0635\u0644 \u0627\u0644\u0643\u0641\u0627\u062d \u062d\u062a\u0649 \u062a\u062d\u0633\u0645 \u0627\u0644\u0645\u0633\u0623\u0644\u0629",
          "\u0648\u0647\u0630\u0627 \u064a\u0634\u0628\u0647 \u0646\u0635\u0628 \u0627\u0644\u0645\u0636\u0627\u0631\u0639 \u0628\u0639\u062f \u0643\u064a \u0648\u062d\u062a\u0649 \u0648\u0623\u0646."
        ],
        "pronunciation_mappings": {
          "1": "pour que chacun ait sa place, on ajoute des chaises",
          "2": "avant qu'il soit trop tard, agissons",
          "3": "on se bat jusqu'\u00e0 ce que ce soit r\u00e9gl\u00e9"
        }
      }
    ]
  },
  {
    "lesson_id": "025",
    "trigger_word": "interview",
    "trigger_card_number": 1462,
    "title": "\u0627\u0644\u062f\u0631\u0633 25: \u062a\u0642\u062f\u064a\u0645 \u0627\u0644\u0641\u0639\u0644 \u0639\u0644\u0649 \u0627\u0644\u0636\u0645\u064a\u0631",
    "header_color": "green",
    "pages": [
      {
        "page": 1,
        "total_pages": 2,
        "content": [
          "\u062a\u0642\u062f\u064a\u0645 \u0627\u0644\u0641\u0639\u0644 \u0639\u0644\u0649 \u0627\u0644\u0636\u0645\u064a\u0631: \u0641\u064a \u0627\u0644\u0635\u062d\u0627\u0641\u0629 \u0648\u0627\u0644\u0643\u062a\u0627\u0628\u0629",
          "\u0627\u0644\u0631\u0633\u0645\u064a\u0629 \u064a\u062a\u0642\u062f\u0645 \u0627\u0644\u0641\u0639\u0644 \u0639\u0644\u0649 \u0641\u0627\u0639\u0644\u0647 \u0641\u064a \u0627\u0644\u0633\u0624\u0627\u0644",
          "\u0628\u062f\u0644\u0627 \u0645\u0646 est-ce que\u060c \u0648\u0647\u064a \u062a\u0634\u0628\u0647 \u00ab\u0647\u0644\u00bb \u0627\u0644\u0639\u0631\u0628\u064a\u0629:",
          "",
          "\u200eest-ce que: \u064a\u0648\u0645\u064a\u0629\u060c \u0644\u0643\u0644 \u0627\u0644\u0645\u0642\u0627\u0645\u0627\u062a\u200f\u200e    \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 1",
          "\u200eEst-ce que vous \u00eates s\u00fbr ?\u200e",
          "",
          "\u200e\u200f\u0627\u0644\u062a\u0642\u062f\u064a\u0645: \u0631\u0633\u0645\u064a\u060c \u0645\u0643\u062a\u0648\u0628\u060c \u0625\u0639\u0644\u0627\u0645\u064a\u200f\u200e       \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 2",
          "\u200e\u00cates-vous s\u00fbr ?\u200e",
          "\u200e   = \u0647\u0644 \u0623\u0646\u062a \u0645\u062a\u0623\u0643\u062f\u061f",
          "",
          "\u200eQue pensez-vous de cette           \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 3",
          "\u200er\u00e9forme ?\u200e",
          "\u200e   = \u0645\u0627 \u0631\u0623\u064a\u0643 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0625\u0635\u0644\u0627\u062d\u061f",
          "\u200ePourquoi la source est-elle        \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 4",
          "\u200efiable ?\u200e",
          "\u200e   = \u0644\u0645\u0627\u0630\u0627 \u0627\u0644\u0645\u0635\u062f\u0631 \u0645\u0648\u062b\u0648\u0642\u061f"
        ],
        "pronunciation": "Le\u00e7on vingt-cinq",
        "pronunciation_mappings": {
          "1": "est-ce que vous \u00eates s\u00fbr",
          "2": "\u00eates-vous s\u00fbr",
          "3": "que pensez-vous de cette r\u00e9forme",
          "4": "pourquoi la source est-elle fiable"
        }
      },
      {
        "page": 2,
        "total_pages": 2,
        "content": [
          "\u0627\u0644\u0648\u0635\u0644 (liaison) \u0628\u062d\u0631\u0641 -t-: \u0625\u0630\u0627 \u0627\u0646\u062a\u0647\u0649 \u0627\u0644\u0641\u0639\u0644",
          "\u0628\u062d\u0631\u0641 \u0639\u0644\u0629 \u0648\u062c\u0627\u0621 \u0628\u0639\u062f\u0647 il \u0623\u0648 elle \u0623\u0648 on\u060c",
          "\u0641\u064a\u0641\u0635\u0644 \u0628\u064a\u0646\u0647\u0645\u0627 \u062d\u0631\u0641 -t- \u062a\u0633\u0647\u064a\u0644\u0627 \u0644\u0644\u0646\u0637\u0642:",
          "",
          "\u200eparle \u2192 parle-t-il ?\u200e               \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 1",
          "\u200e   = \u0647\u0644 \u064a\u062a\u0643\u0644\u0645\u061f",
          "\u200ea \u2192 a-t-elle ?\u200e",
          "\u200e   = \u0647\u0644 \u0644\u062f\u064a\u0647\u0627\u061f",
          "",
          "\u0648\u0625\u0630\u0627 \u0643\u0627\u0646 \u0627\u0644\u0641\u0627\u0639\u0644 \u0627\u0633\u0645\u0627 \u0628\u0642\u064a \u0641\u064a \u0645\u0643\u0627\u0646\u0647\u060c \u0648\u062c\u0627\u0621",
          "\u0628\u0639\u062f \u0627\u0644\u0641\u0639\u0644 \u0636\u0645\u064a\u0631 \u064a\u0637\u0627\u0628\u0642\u0647:",
          "",
          "\u200eLe journaliste a-t-il v\u00e9rifi\u00e9      \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 2",
          "\u200ela source ?\u200e",
          "\u200e   = \u0647\u0644 \u062a\u062d\u0642\u0642 \u0627\u0644\u0635\u062d\u0641\u064a \u0645\u0646 \u0627\u0644\u0645\u0635\u062f\u0631\u061f",
          "\u0648\u062a\u0642\u062f\u064a\u0645 \u0627\u0644\u0641\u0639\u0644 \u0641\u064a \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0623\u0645\u0631 \u0639\u0627\u062f\u064a\u060c \u0623\u0645\u0627 \u0641\u064a",
          "\u0627\u0644\u0641\u0631\u0646\u0633\u064a\u0629 \u0641\u0639\u0644\u0627\u0645\u0629 \u0639\u0644\u0649 \u0627\u0644\u0623\u0633\u0644\u0648\u0628 \u0627\u0644\u0631\u0633\u0645\u064a\u060c",
          "\u0648\u0627\u0644\u0643\u0644\u0627\u0645 \u0627\u0644\u064a\u0648\u0645\u064a \u064a\u0643\u062a\u0641\u064a \u0628\u0640 est-ce que."
        ],
        "pronunciation_mappings": {
          "1": "parle-t-il, a-t-elle",
          "2": "le journaliste a-t-il v\u00e9rifi\u00e9 la source"
        }
      }
    ]
  },
  {
    "lesson_id": "038",
    "trigger_word": "\u00e9tranger",
    "trigger_card_number": 1421,
    "title": "\u0627\u0644\u062f\u0631\u0633 38: \u0641\u0631\u0646\u0633\u0627 \u0639\u0644\u0649 \u0627\u0644\u062e\u0631\u064a\u0637\u0629",
    "header_color": "cyan",
    "pages": [
      {
        "page": 1,
        "total_pages": 3,
        "content": [
          "\u0641\u0631\u0646\u0633\u0627 \u0648\u0645\u062f\u0646\u0647\u0627 \u0648\u0645\u0639\u0627\u0644\u0645\u0647\u0627 \u0643\u0645\u0627 \u064a\u0646\u0637\u0642\u0647\u0627 \u0627\u0644\u0641\u0631\u0646\u0633\u064a\u0648\u0646.",
          "\u0627\u0644\u0645\u0641\u062a\u0627\u062d \u0627\u0644\u0648\u0627\u062d\u062f \u064a\u0646\u0637\u0642 \u0633\u0637\u0631\u064a\u0646:",
          "\u200e\u0641\u0631\u0646\u0633\u0627           France             \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 1",
          "\u200e\u0628\u0627\u0631\u064a\u0633           Paris",
          "\u200e\u0645\u0631\u0633\u064a\u0644\u064a\u0627         Marseille          \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 2",
          "\u200e\u0644\u064a\u0648\u0646            Lyon",
          "\u200e\u062a\u0648\u0644\u0648\u0632           Toulouse           \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 3",
          "\u200e\u0646\u064a\u0633             Nice",
          "\u200e\u0628\u0648\u0631\u062f\u0648           Bordeaux           \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 4",
          "\u200e\u0633\u062a\u0631\u0627\u0633\u0628\u0648\u0631\u063a       Strasbourg",
          "\u200e\u0628\u0631\u0648\u0641\u0627\u0646\u0633         la Provence        \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 5",
          "\u200e\u0628\u0631\u064a\u062a\u0627\u0646\u064a         la Bretagne",
          "\u200e\u0646\u0648\u0631\u0645\u0627\u0646\u062f\u064a        la Normandie       \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 6",
          "\u200e\u0643\u0648\u0631\u0633\u064a\u0643\u0627         la Corse",
          "\u200e\u0628\u0631\u062c \u0625\u064a\u0641\u0644        la tour Eiffel     \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 8",
          "\u200e\u0645\u062a\u062d\u0641 \u0627\u0644\u0644\u0648\u0641\u0631     le Louvre",
          "\u200e\u062c\u0628\u0644 \u0645\u0648\u0646 \u0628\u0644\u0627\u0646    le mont Blanc      \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 x",
          "\u200e\u0646\u0647\u0631 \u0627\u0644\u0644\u0648\u0627\u0631      la Loire"
        ],
        "pronunciation_mappings": {
          "1": "France. Paris.",
          "2": "Marseille. Lyon.",
          "3": "Toulouse. Nice.",
          "4": "Bordeaux. Strasbourg.",
          "5": "La Provence. La Bretagne.",
          "6": "La Normandie. La Corse.",
          "8": "La tour Eiffel. Le Louvre.",
          "x": "Le mont Blanc. La Loire."
        }
      },
      {
        "page": 2,
        "total_pages": 3,
        "content": [
          "\u0627\u0644\u0628\u0644\u062f \u062b\u0645 \u0639\u0627\u0635\u0645\u062a\u0647\u060c \u0628\u0627\u0644\u0641\u0631\u0646\u0633\u064a\u0629.",
          "\u0627\u0644\u0645\u0641\u062a\u0627\u062d \u0627\u0644\u0648\u0627\u062d\u062f \u064a\u0646\u0637\u0642 \u0633\u0637\u0631\u064a\u0646:",
          "\u200e\u0623\u0644\u0645\u0627\u0646\u064a\u0627    Allemagne   Berlin      \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 1",
          "\u200e\u0641\u0631\u0646\u0633\u0627      France      Paris",
          "\u200e\u0625\u064a\u0637\u0627\u0644\u064a\u0627    Italie      Rome        \u0644\u0644\u0627\u0633\u062a\u0645\u0627\u0639 2",
