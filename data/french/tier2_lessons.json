    "header_color": "green",
    "pages": [
      {
        "page": 1,
        "total_pages": 1,
        "content": [
          "MORE ÉLISION PRACTICE — h-muet words",
          "elide completely normally, just",
          "like vowels:",
          "",
          "le école → l'école                   Press 1",
          "(the h is silent, so école 'starts'",
          "with a vowel sound for élision)",
          "",
          "le hôpital → l'hôpital               Press 2",
          "le hôtel → l'hôtel                   Press 3",
          "",
          "LIAISON too: aux hôtels              Press 4",
          "→ aux_hôtels [z] — the silent x of",
          "aux is pronounced [z] before the",
          "vowel sound of hôtel."
        ],
        "pronunciation": "Leçon huit",
        "pronunciation_mappings": {
          "1": "l'école",
          "2": "l'hôpital",
          "3": "l'hôtel",
          "4": "aux hôtels"
        }
      }
    ]
  },
