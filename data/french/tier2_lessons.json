    "header_color": "green",
    "pages": [
      {
        "page": 1,
        "total_pages": 1,
        "content": [
          "FUTUR PROCHE — the easiest way to",
          "talk about the future, just like",
          "English 'going to':",
          "",
          "aller (present) + infinitive:",
          "",
          "Je vais commander.                   Press 1",
          "(I'm going to order.)",
          "Tu vas payer.                        Press 2",
          "(You're going to pay.)",
          "Nous allons acheter des légumes.     Press 3",
          "(We're going to buy vegetables.)",
          "",
          "NEGATIVE — ne...pas wraps around",
          "just 'aller':",
          "Je ne vais pas commander.            Press 4",
          "(I'm not going to order.)"
        ],
        "pronunciation": "Leçon neuf",
        "pronunciation_mappings": {
          "1": "je vais commander",
          "2": "tu vas payer",
          "3": "nous allons acheter des légumes",
          "4": "je ne vais pas commander"
        }
      }
    ]
  },
