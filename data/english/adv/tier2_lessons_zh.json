    "lesson_id": "006",
    "trigger_word": "regards",
    "trigger_card_number": 104,
    "title": "第6课：语气得体",
    "header_color": "green",
    "pages": [
      {
        "page": 1,
        "total_pages": 1,
        "content": [
          "问候语要与结束语相匹配。",
          "",
          "正式场合（不知对方姓名）：",
          "  To whom it may concern,",
          "  Dear Sir or Madam,",
          "  → Sincerely, Respectfully,",
          "",
          "正式场合（已知对方姓名）：",
          "  Dear Mr./Ms. [Surname],",
          "  → Sincerely, or Kind regards,",
          "",
          "友好场合：",
          "  Hello/Dear [First name],",
          "  → Best wishes, Love from,",
          "",
          "随意场合：",
          "  Hi/Hey [Name],",
          "  → Cheers, Thanks, Speak soon,"
        ],
        "pronunciation": "Lesson six"
      }
    ]
  },
