[
  {
    "lesson_id": "058",
    "trigger_word": "session",
    "trigger_card_number": 212,
    "title": "LEKTION 58: DER IT-SPALTSATZ",
    "header_color": "cyan",
    "pages": [
      {
        "page": 1,
        "total_pages": 2,
        "content": [
          "Englisch rückt einen Satzteil ins Licht,",
          "indem es den Satz zweiteilt.",
          "",
          "Schlicht: \"The session changed",
          "everything.\"",
          "",
          "Das Subjekt hervorheben:",
          "\"It was the session that changed",
          "everything.\"",
          "= Es war die Sitzung, die alles änderte."
        ]
      },
      {
        "page": 2,
        "total_pages": 2,
        "content": [
          "Der Rahmen bleibt immer gleich:",
          "it + be + der Teil + that / who.",
          "",
          "\"It was in June that they met.\"",
          "= Erst im Juni trafen sie sich.",
          "\"It was John who paid.\"",
          "= Bezahlt hat John.",
          "",
          "Auch zum Richtigstellen:",
          "\"It wasn't me who told her.\"",
          "",
          "Deutsch hat denselben Bau ('Es war ...,",
          "der ...') und kann sonst einfach",
          "umstellen. Englisch kann das kaum und",
          "greift deshalb öfter zum Spaltsatz."
        ]
      }
    ]
  },
  {
    "lesson_id": "059",
    "trigger_word": "stubborn",
    "trigger_card_number": 280,
    "title": "LEKTION 59: WHAT I NEED IS",
    "header_color": "cyan",
    "pages": [
      {
        "page": 1,
        "total_pages": 2,
        "content": [
          "Ein zweiter Scheinwerfer, diesmal nach",
          "vorn gerichtet:",
          "",
          "what + Nebensatz + is/was + die Sache.",
          "\"What I need is a week off.\"",
          "= Was ich brauche, ist eine Woche frei.",
          "\"What annoys me is the noise.\"",
          "\"What he did was sell the whole lot.\"",
          "",
          "Das Neue steht am ENDE."
        ]
      },
      {
        "page": 2,
        "total_pages": 2,
        "content": [
          "Fronting rückt einen Teil stattdessen",
          "zum Kontrast nach VORN:",
          "\"That I can believe.\"",
          "\"Stubborn he certainly is.\"",
          "\"The rest we can discuss later.\"",
          "",
          "Die Werkzeuge ziehen gegenläufig: der",
          "what-Satz hebt die Neuigkeit bis zuletzt",
          "auf, das Fronting wirft den Kontrast",
          "nach vorn.",
          "",
          "Deutsch stellt dank der Endungen frei um.",
          "Englisch hat kaum Endungen und baut sich",
          "diese Rahmen stattdessen."
        ]
      }
    ]
  },
  {
    "lesson_id": "060",
    "trigger_word": "brief",
    "trigger_card_number": 345,
    "title": "LEKTION 60: NEVER HAD I SEEN",
    "header_color": "cyan",
    "pages": [
      {
        "page": 1,
        "total_pages": 2,
        "content": [
          "Steht ein negatives Wort zuerst, dreht",
          "der Satz um wie eine Frage.",
          "",
          "\"Never had I seen anything like it.\"",
          "nicht \"Never I had seen ...\"",
          "",
          "\"Not only was the report brief, it was",
          "wrong.\"",
          "\"No sooner had she left than it rang.\""
        ]
      },
      {
        "page": 2,
        "total_pages": 2,
        "content": [
          "Das Muster: negatives Adverb, dann",
          "Hilfsverb, dann Subjekt.",
          "",
          "\"Little did she know.\"",
          "\"Under no circumstances should you sign.\"",
          "\"Rarely do we see such weather.\"",
          "",
          "Fehlt ein Hilfsverb, springt do ein.",
          "",
          "Das ist förmlich und nachdrücklich —",
          "etwas für Texte und Reden, nicht fürs",
          "Gespräch.",
          "",
          "Deutsch stellt nach einem vorangestellten",
          "Glied ohnehin um ('Nie hatte ich ...').",
          "Im Englischen ist das die Ausnahme und",
          "wirkt gerade deshalb so stark."
        ]
      }
    ]
  }
]
