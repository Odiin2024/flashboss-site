    "header_color": "cyan",
    "pages": [
      {
        "page": 1,
        "total_pages": 2,
        "content": [
          "بعض الأفعال تقبل المسارين معا، لكن",
          "المسار يغير المعنى.",
          "",
          "STOP:",
          "\"She stopped talking.\"",
          "= توقفت عن الكلام وأنهته.",
          "\"She stopped to talk.\"",
          "= توقفت عما كانت فيه من أجل الكلام.",
          "REMEMBER:",
          "\"I remember locking it.\"",
          "= أتذكر أني أقفلته؛ فعل مضى.",
          "\"Remember to lock it.\"",
          "= عدم نسيان الإقفال؛ مهمة قادمة."
        ]
      },
      {
        "page": 2,
        "total_pages": 2,
        "content": [
          "TRY:",
          "\"Try asking her.\"",
          "= تجربة السؤال لمعرفة ما سيحدث.",
          "\"Try to ask her.\"",
          "= بذل الجهد من أجل السؤال.",
          "وبعض الأفعال تقبل المسارين بلا أي فرق،",
          "ومنها PREFER:",
          "\"I prefer walking\" = \"I prefer to walk.\"",
          "وكلاهما صحيح.",
          "",
          "والعربية تغير هنا حرف الجر:",
          "«توقفت عن الكلام» مقابل «توقفت للكلام».",
          "أما الإنجليزية فتحمل المعنى في شكل",
          "الفعل الثاني نفسه."
