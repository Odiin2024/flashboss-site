    "header_color": "magenta",
    "pages": [
      {
        "page": 1,
        "total_pages": 2,
        "content": [
          "نفي الماضي: سوابق النفي المعروفة،",
          "ومعها خرزة «متى» -ku-.",
          "وحرف العلة الأخير يبقى -a.",
          "",
          "   nilinunua   ->  sikununua",
          "   alikwenda   ->  hakwenda",
          "   tulilipa    ->  hatukulipa",
          "",
          "   Sikununua kitu ofisini.",
          "\u200e   = لم أشتر شيئا في المكتب",
          "",
          "\u200e\u200fالأفعال الثلاثة:\u200f\u200e                للاستماع 1",
          "",
          "الخرزة -li- للماضي الذي وقع، و -ku-",
          "للماضي الذي لم يقع.",
          "وفي العربية ما يقاربه: «اشتريت» تصير",
          "في النفي «لم أشتر»، بصيغة أخرى للفعل."
        ],
        "pronunciation_mappings": {
          "1": "Sikununua. Hakwenda. Hatukulipa."
        }
      },
      {
        "page": 2,
        "total_pages": 2,
        "content": [
          "نفي التمام: -ja- بمعنى «لم ... بعد».",
          "",
          "   nimemaliza  ->  sijamaliza",
          "   amefika     ->  hajafika",
          "",
          "   Barua haijafika bado.",
          "\u200e   = لم تصل الرسالة بعد",
          "",
          "\u200e\u200fالمثالان:\u200f\u200e                       للاستماع 1",
          "",
          "وهنا موطن bado الحقيقي، كما وعد الدرس 15:",
          "الخرزة -ja- تقول «لم يتم بعد»، و bado تؤكده.",
          "و bado من «بعد»، وتأتي هنا في الآخر مثلها.",
          "والأزمنة المنفية الأربعة تتقابل أزواجا:",
          "\u200e  -na- / (تسقط)     -li- / -ku-",
          "  -ta- / -ta-        -me- / -ja-"
        ],
        "pronunciation_mappings": {
          "1": "Sijamaliza. Barua haijafika bado."
        }
      }
    ]
