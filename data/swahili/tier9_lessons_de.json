    "pages": [
      {
        "page": 1,
        "total_pages": 2,
        "pronunciation_mappings": {
          "1": "Mvua ikinyesha, tunakaa ndani. Ukienda sasa, utafika mapema."
        },
        "content": [
          "Das Wetter lehrt Konditionalsätze. Die",
          "-ki--Perle ist das kama aus Lektion 19,",
          "komprimiert ins Verb:",
          "",
          "   Mvua ikinyesha, tunakaa ndani.",
          "   Wenn es regnet, bleiben wir drinnen.",
          "",
          "   Ukienda sasa, utafika mapema.",
          "   Wenn du jetzt gehst, kommst du früh an.",
          "",
          "Hör sie dir an:                   Drücke 1",
          "",
          "WER + ki + STAMM — keine eigene Zeit;",
          "der Hauptsatz trägt die Zeitform."
        ]
      },
      {
        "page": 2,
        "total_pages": 2,
        "pronunciation_mappings": {
          "1": "Niliwaona watoto wakicheza. Tulikaa tukisubiri mvua."
        },
        "content": [
          "Dasselbe Perlenstück malt auch eine",
          "Handlung, die gleichzeitig abläuft:",
          "",
          "   Niliwaona watoto wakicheza.",
          "   Ich sah die Kinder spielen.",
          "",
          "   Tulikaa tukisubiri mvua.",
          "   Wir saßen und warteten auf Regen.",
          "",
          "Hör sie dir an:                   Drücke 1",
          "",
          "Wenn-Sein und Während-Sein in einer",
          "Perle: beides liest sich als »die",
          "Situation sei so«. Der Kontext — wie",
          "immer im Suaheli — erledigt den Rest."
        ]
      }
