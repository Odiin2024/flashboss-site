          "   u-  -> hu-      m-  -> ham-",
          "   a-  -> ha-      wa- -> hawa-",
          "",
          "   ninapenda  ->  sipendi",
          "   anajua     ->  hajui",
          "   tunakwenda ->  hatuendi",
          "",
          "Hear the flip:                     Press 1",
          "",
          "Note: the -na- bead DISAPPEARS in the",
          "negative present. Two changes, one no."
        ],
        "pronunciation_mappings": {
          "1": "Sipendi. Hajui. Hatuendi."
        }
