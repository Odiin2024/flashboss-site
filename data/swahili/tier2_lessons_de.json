    "pages": [
      {
        "page": 1,
        "total_pages": 2,
        "pronunciation_mappings": {
          "1": "Sana. Kazi. Kitu. Mji. Sababu. Bora. Hata."
        },
        "content": [
          "Ab hier verwenden Beispielsätze eine Handvoll",
          "kleiner Wörter, deren eigene Karten später",
          "kommen. Lerne sie jetzt kennen — erkennen,",
          "nicht auswendig. Die ersten sieben:",
          "",
          "   sana    sehr, viel",
          "   kazi    Arbeit",
          "   kitu    ein Ding",
          "   mji     eine Stadt",
          "   sababu  ein Grund",
          "   bora    besser, ausgezeichnet",
          "   hata    sogar",
          "",
          "Hör sie:                          Drücke 1"
        ]
      },
      {
        "page": 2,
        "total_pages": 2,
        "pronunciation_mappings": {
          "1": "Tena. Pia. Bado. Kidogo. Zaidi. Vizuri. Nje."
        },
        "content": [
          "Und die anderen sieben:",
          "",
          "   tena    wieder",
          "   pia     auch",
          "   bado    noch, noch nicht",
          "   kidogo  ein bisschen",
          "   zaidi   mehr",
          "   vizuri  gut",
          "   nje     draußen",
          "",
          "Hör sie:                          Drücke 1",
          "",
          "Wenn eines davon in einem Satz auftaucht,",
          "kennst du es schon. Wenn seine Karte",
          "endlich kommt, fühlt es sich an wie",
          "ein alter Freund."
        ]
      }
    ]
