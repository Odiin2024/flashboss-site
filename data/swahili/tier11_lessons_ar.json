          "",
          "وهي قريبة من وزن «أفعل» للتعدية في",
          "العربية: من «جلس» يأتي «أجلس»."
        ],
        "pronunciation_mappings": {
          "1": "Kuanzisha. Kusomesha. Kulisha."
