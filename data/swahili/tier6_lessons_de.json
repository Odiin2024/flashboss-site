          "",
          "   ni- -> si-      tu- -> hatu-",
          "   u-  -> hu-      m-  -> ham-",
          "   a-  -> ha-      wa- -> hawa-",
          "",
          "   ninapenda  ->  sipendi",
          "   anajua     ->  hajui",
          "   tunakwenda ->  hatuendi",
          "",
          "Hör die Wende:                    Drücke 1",
          "",
          "MERKE: Die Perle -na- VERSCHWINDET im",
          "verneinten Präsens. Zwei Änd., ein Nein."
        ]
      },
      {
        "page": 2,
        "total_pages": 2,
        "pronunciation_mappings": {
          "1": "Sina hela. Hawana deni. Hii si benki."
        },
        "content": [
          "Die „haben-nicht“-Reihe aus Lektion 10:",
          "",
          "   sina    ich habe nicht",
          "   huna    du hast nicht",
          "   hana    sie hat nicht",
          "   hatuna  wir haben nicht",
          "   hamna   ihr habt nicht",
          "   hawana  sie haben nicht",
          "",
          "   Sina hela.        Ich habe kein Geld.",
          "   Hawana deni. Sie haben keine Schulden.",
          "",
          "Hör sie:                          Drücke 1",
          "",
          "Und „ist nicht“ kennst du seit Lektion 4:",
