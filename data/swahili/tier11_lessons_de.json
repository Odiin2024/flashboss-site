    "pages": [
      {
        "page": 1,
        "total_pages": 2,
        "pronunciation_mappings": {
          "1": "Kukutana. Kupendana. Tunasaidiana kila siku."
        },
        "content": [
          "Die -an--Perle verwandelt Tun in",
          "Tun-miteinander:",
          "",
          "   kukuta    auf etwas stoßen",
          "   kukutana  sich treffen",
          "",
          "   kupenda   lieben",
          "   kupendana einander lieben",
          "",
          "   kusaidia  helfen",
          "   kusaidiana einander helfen",
          "",
          "   Tunasaidiana kila siku.",
          "   Wir helfen einander jeden Tag.",
          "",
          "Hör sie:                          Drücke 1"
        ]
      },
      {
        "page": 2,
        "total_pages": 2,
        "pronunciation_mappings": {
          "1": "Viongozi walikutana jana. Mataifa yanafahamiana."
        },
        "content": [
          "Das Subjekt ist natürlich plural —",
          "Miteinander braucht Gesellschaft:",
          "",
          "   Viongozi walikutana jana.",
          "   Die Anführer trafen sich gestern.",
          "",
          "   Mataifa yanafahamiana.",
          "   Die Nationen kennen einander.",
          "",
          "Hör sie:                          Drücke 1",
          "",
          "Einige -ana-Verben haben ihre Rechenregel",
          "hinter sich gelassen: kukutana heißt einfach",
          "„sich treffen“, kupatana „sich einigen“. Die",
          "Perle bleibt sichtbar; die Bedeutung wohnt",
          "nun für sich."
        ]
      }
    ]
