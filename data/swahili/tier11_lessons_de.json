    "pages": [
      {
        "page": 1,
        "total_pages": 2,
        "pronunciation_mappings": {
          "1": "Kuvunjika. Kikombe kimevunjika. Kuharibika."
        },
        "content": [
          "Dinge verändern sich, verderben, gehen kaputt",
          "— oft ohne Schuld. Das Stativ -ik-/-ek- sagt,",
          "dass es von selbst geschah oder GESCHEHEN",
          "KANN:",
          "",
          "   kuvunja    (etwas) zerbrechen",
          "   kuvunjika  zerbrechen, kaputt sein",
          "",
          "   Kikombe kimevunjika.",
          "   Der Becher ist kaputt. (Lektion 15",
          "   hatte Imevunjika, jetzt erklärt.)",
          "",
          "   kuharibika   verderben, schlecht werden",
          "   kubadilika   sich (von selbst) ändern",
          "",
          "Hör sie:                          Drücke 1"
        ]
      },
      {
        "page": 2,
        "total_pages": 2,
        "pronunciation_mappings": {
          "1": "Kilivunjwa. Kilivunjika."
        },
        "content": [
          "Stativ gegen Passiv — das Paar,",
          "das das System beweist:",
          "",
          "   Kikombe kilivunjWA.",
          "   Der Becher wurde zerbrochen",
          "   (von jemandem – Handlung und Täter).",
          "",
          "   Kikombe kilivunjIKA.",
          "   Der Becher brach (Zustand; kein",
          "   Schuldiger, niemand genannt).",
          "",
          "Hör das Paar:                     Drücke 1",
          "",
          "Suaheli-Sprecher greifen ständig",
          "zu -ika — es ist die höfliche",
          "Physik des Alltags: Dinge",
          "geschehen einfach."
        ]
      }
    ]
