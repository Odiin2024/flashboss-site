    "header_color": "red",
    "pages": [
      {
        "page": 1,
        "total_pages": 2,
        "content": [
          "الأمر المجرد هو الجذر وحده:",
          "",
          "\u200e   Simama!\u200e    = قف!\u200f",
          "\u200e   Njoo!\u200e      = تعال! (غير قياسي)\u200f",
          "\u200e   Nenda!\u200e     = اذهب! (غير قياسي)\u200f",
          "",
          "وللجماعة تضاف -eni، قريبا من «قفوا»:",
          "",
          "\u200e   Simameni!\u200e  = قفوا جميعا!\u200f",
          "",
          "والنهي: u-si- للواحد و m-si- للجماعة،",
          "وحرف العلة الأخير يصير -e:",
          "",
          "\u200e   Usiibe!\u200e    = لا تسرق!\u200f",
          "\u200e   Msiibe!\u200e    = لا تسرقوا!\u200f",
          "",
          "\u200e\u200fالأوامر:\u200f\u200e                        للاستماع 1",
          "والنهي قريب من «لا» الناهية مع المجزوم."
        ],
        "pronunciation_mappings": {
          "1": "Simama! Simameni! Usiibe!"
        }
      },
      {
        "page": 2,
        "total_pages": 2,
        "content": [
          "والأمر إذا لان صار طلبا، وهذه صيغة الاحتمال:",
          "يصير -a الأخير -e، ولا خرزة «متى» أبدا.",
          "",
          "\u200e   Twende!\u200e         = لنذهب!\u200f",
          "\u200e   Uende sasa.\u200e     = ينبغي أن تذهب الآن",
          "\u200e   Polisi waje.\u200e    = لتأت الشرطة",
          "",
          "وهي قريبة من لام الأمر في «لنذهب» و«لتأت».",
          "",
          "\u200e\u200fالأمثلة:\u200f\u200e                        للاستماع 1",
          "",
          "وصيغة -e تحمل الطلب والاقتراح والغاية،",
          "و ili من الدرس 19 تأتي معها كثيرا:",
          "   Ninafanya kazi ili watoto wale.",
          "\u200e   = أعمل كي يأكل الأطفال",
          "وهذا قريب من نصب الفعل بعد «كي»."
        ],
        "pronunciation_mappings": {
          "1": "Twende! Uende sasa. Polisi waje."
        }
      }
    ]
