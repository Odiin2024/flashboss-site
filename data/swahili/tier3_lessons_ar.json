          "عمل حرف الجر في العربية:",
          "",
          "‎   mji     ->  mjini      في البلدة",
          "‎   nyumba  ->  nyumbani   في البيت",
          "‎   shule   ->  shuleni    في المدرسة",
          "‎   soko    ->  sokoni     في السوق",
          "",
          "‎‏الأماكن‏‎                         للاستماع 1",
          "",
          "لاحقة واحدة تقوم مقام ثلاثة حروف جر،",
          "والفعل يحدد المعنى: في المكان، أو عنده،",
          "أو إليه."
        ],
        "pronunciation_mappings": {
          "1": "Mjini. Nyumbani. Shuleni. Sokoni."
        }
      },
      {
        "page": 2,
        "total_pages": 2,
        "content": [
          "وهذه اللاحقة مع أفعال معروفة:",
          "",
          "   Ninakwenda mjini.",
          "‎   = أذهب إلى البلدة",
          "",
          "   Anakaa nyumbani leo.",
          "‎   = تبقى في البيت اليوم",
          "",
          "   Wanajifunza shuleni.",
          "‎   = يتعلمون في المدرسة",
          "",
          "‎‏ثلاث جمل‏‎                        للاستماع 1",
          "",
          "وأسماء الأعلام ترفض اللاحقة: يقال Dodoma،",
          "ولا يقال Dodomani أبدا. فالمكان الذي هو",
          "مكان أصلا لا يحتاج إلى هذه الشارة."
        ],
        "pronunciation_mappings": {
          "1": "Ninakwenda mjini. Anakaa nyumbani leo. Wanajifunza shuleni."
        }
      }
    ]
  },
