        "content": [
          "Paperwork demands pointing. Swahili",
          "points three ways:",
          "",
          "   hati hii    this document (here)",
          "   hati hiyo   that one (near you /",
          "               just mentioned)",
          "   hati ile    that one (over there)",
          "",
          "Hear the three:                    Press 1",
          "",
          "Three distances: by me, by you,",
          "by neither of us. The middle one,",
          "-o, also points back at whatever",
          "was last spoken of."
        ],
        "pronunciation_mappings": {
          "1": "Hati hii. Hati hiyo. Hati ile."
        }
