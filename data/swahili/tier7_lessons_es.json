          "   ji/ma  hili   hilo   lile",
          "          haya   hayo   yale",
          "   n/n    hii    hiyo   ile",
          "          hizi   hizo   zile",
          "   u-     huu    huo    ule",
          "",
          "Escúchalos:                     Presiona 1",
