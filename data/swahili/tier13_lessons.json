    "header_color": "cyan",
    "pages": [
      {
        "page": 1,
        "total_pages": 2,
        "content": [
          "Office prose runs on which-clauses",
          "too long for Lesson 24's infix. For",
          "these Swahili keeps a carrier word:",
          "amba- plus the class bead.",
          "",
          "   jalada ambalo nililisoma jana",
          "   the file which I read yesterday",
          "",
          "   watu ambao hawajalipa",
          "   the people who have not yet paid",
          "",
          "Hear them:                         Press 1",
          "",
          "ambaye, ambao, ambalo, ambacho,",
          "ambayo, ambazo — the -o endings of",
          "Lesson 24, riding a fixed stem."
        ],
        "pronunciation_mappings": {
          "1": "Jalada ambalo nililisoma jana. Watu ambao hawajalipa."
        }
      },
      {
        "page": 2,
        "total_pages": 2,
        "content": [
          "When to reach for which:",
          "",
          "   INFIX (-ye-/-o-): short, present",
          "   or simple past, affirmative —",
          "   mtu anayekuja.",
          "",
          "   AMBA-: negatives, perfects,",
          "   compound tenses, or when the verb",
          "   is already carrying beads —",
          "   hati ambayo haijasainiwa,",
          "   the document that has not been",
          "   signed.",
          "",
          "Hear the contrast:                 Press 1",
          "",
          "Newspaper Swahili leans amba-;",
          "street Swahili leans the infix.",
          "Read both, write either."
        ],
        "pronunciation_mappings": {
          "1": "Mtu anayekuja. Hati ambayo haijasainiwa."
        }
      }
    ]
  }
