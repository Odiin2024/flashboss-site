    "header_color": "cyan",
    "pages": [
      {
        "page": 1,
        "total_pages": 1,
        "content": [
          "Not all prefixes are separable!",
          "",
          "INSEPARABLE PREFIXES (never separate):",
          "be-, emp-, ent-, er-, ge-, miss-, ver-, zer-",
          "",
          "bekommen → Ich bekomme einen Brief.",
          "verstehen → Ich verstehe das nicht.",
          "erzählen → Sie erzählt eine Geschichte.",
          "",
          "HOW TO TELL THEM APART:               Press 1",
          "SEPARABLE: stress on PREFIX",
          "INSEPARABLE: stress on STEM",
          "",
          "PERFECT TENSE:",
          "SEPARABLE: auf|stehen → aufgestanden",
          "INSEPARABLE: verstehen → verstanden (no ge-!)",
          "",
          "Listen for stress to know which type!"
        ],
        "pronunciation": "Lektion siebenundzwanzig",
        "pronunciation_mappings": {
          "1": "Aufstehen. Verstehen."
        }
      }
    ]
