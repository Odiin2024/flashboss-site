    "header_color": "cyan",
    "pages": [
      {
        "page": 1,
        "total_pages": 1,
        "content": [
          "Plusquamperfekt: lo anterior a un hecho pasado.",
          "",
          "ESTRUCTURA: hatte/war + participio",
          "(Como el pluscuamperfecto: había + participio)",
          "",
          "Mismas reglas haben/sein que el Perfekt:",
          "Movimiento/cambio → war; el resto → hatte",
          "",
          "Ich hatte gegessen. (Yo había comido)",
          "Er war gegangen. (Él se había ido)",
          "",
          "CON 'NACHDEM' (después de que):",
          "Nachdem ich gegessen hatte, ging ich spazieren.",
          "(Después de haber comido, salí a caminar)",
          "Nachdem sie gegangen war, rief er an.",
          "(Después de que ella se había ido, él llamó)",
          "",
          "nachdem + Plusquamperfekt → principal en pasado"
        ],
        "pronunciation": "Lektion 53"
      }
    ]
  },
