    "header_color": "cyan",
    "pages": [
      {
        "page": 1,
        "total_pages": 1,
        "content": [
          "HIN = AWAY from speaker, HER = TOWARD speaker",
          "",
          "BASIC FORMS:",
          "hin = (to) there    her = (to) here",
          "Wo gehst du hin? (Where are you going?)",
          "Komm her! (Come here!)",
          "",
          "COMBINED WITH ADVERBS:",
          "hierhin = to this spot  hierher = over to me",
          "dorthin = to there      dorther = from there",
          "wohin = where to        woher = where from",
          "",
          "COMBINED WITH PREPOSITIONS:",
          "hinaus/heraus = out  hinein/herein = in",
          "hinauf/herauf = up   hinunter/herunter = down",
          "Spoken: rein, raus, rauf, runter (both ways)",
          "Komm herein! (Come in! - toward speaker)",
          "Geh hinaus! (Go out! - away from speaker)"
        ],
        "pronunciation": "Lektion 37"
      }
    ]
  }
