    "header_color": "cyan",
    "pages": [
      {
        "page": 1,
        "total_pages": 1,
        "content": [
          "Sin artículo: terminación fuerte = género+caso",
          "",
          "          Masc    Fem     Neut    Plural",
          "NOM:      -er     -e      -es     -e",
          "AKK:      -en     -e      -es     -e",
          "DAT:      -em     -er     -em     -en",
          "GEN:      -en     -er     -en     -er",
          "",
          "EJEMPLOS (nominativo):",
          "begabter Student (estudiante talentoso, masc)",
          "begabte Studentin (estudiante talentosa, fem)",
          "begabtes Kind (niño talentoso, neutro)",
          "",
          "CON CANTIDADES:",
          "viele begabte Studenten (muchos talentosos)",
          "wenig begabte Leute (poca gente talentosa)",
          "",
          "¡El adjetivo dice lo que diría el artículo!"
        ],
        "pronunciation": "Lektion 36"
      }
    ]
  },
