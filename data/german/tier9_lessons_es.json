    "pages": [
      {
        "page": 1,
        "total_pages": 1,
        "content": [
          "Muchos verbos reflexivos piden PREPOSICIÓN:",
          "",
          "sich gewöhnen AN + AKK = acostumbrarse a",
          "Ich gewöhne mich an das Wetter.",
          "(Me estoy acostumbrando al clima)",
          "",
          "sich freuen AUF + AKK = tener ganas de",
          "Ich freue mich auf das Wochenende.",
          "(Tengo ganas de que llegue el fin de semana)",
          "",
          "sich freuen ÜBER + AKK = alegrarse por",
          "Ich freue mich über das Geschenk.",
          "(Me alegra el regalo)",
          "",
          "MÁS PARES - memoriza verbo, preposición y caso:",
          "sich ärgern über + AKK (enojarse por)",
          "sich erinnern an + AKK (acordarse de)",
          "sich kümmern um + AKK (ocuparse de)"
        ],
        "pronunciation": "Lektion 51"
      }
    ]
