    "header_color": "cyan",
    "pages": [
      {
        "page": 1,
        "total_pages": 1,
        "content": [
          "Tres palabras para 'cuando', con usos propios:",
          "",
          "WANN (preguntas directas e indirectas):",
          "Wann kommst du? (¿Cuándo vienes?)",
          "Ich weiß nicht, wann er kommt.",
          "(No sé cuándo viene)",
          "",
          "ALS (hecho único en el pasado):",
          "Als ich Kind war... (Cuando era niño...)",
          "Als er ankam... (Cuando llegó...)",
          "",
          "WENN (hechos repetidos o futuro):",
          "Wenn ich Zeit habe... (Cuando tengo tiempo...)",
          "Wenn er kommt... (Cuando/Si viene...)",
          "",
          "Recuerda: WANN = pregunta, ALS = pasado único,",
          "WENN = repetido o futuro"
        ],
        "pronunciation": "Lektion 60"
      }
    ]
  }
