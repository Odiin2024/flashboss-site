    "header_color": "cyan",
    "pages": [
      {
        "page": 1,
        "total_pages": 1,
        "content": [
          "El alemán tiene DOS maneras de decir 'no':",
          "",
          "nicht = no (niega verbos y adjetivos)",
          "kein  = ningún/no un (niega sustantivos)",
          "",
          "NICHT - su posición varía:",
          "Ich verstehe nicht. (No entiendo)",
          "Das ist nicht gut. (Eso no está bien)",
          "",
          "KEIN - reemplaza al artículo:",
          "",
          "Ich habe einen Hund.",
          "→ Ich habe keinen Hund.",
          "(Tengo un perro → No tengo perro)",
          "",
          "REGLA: usa kein con SUSTANTIVOS,",
          "       usa nicht con todo lo demás."
        ],
        "pronunciation": "Lektion sieben"
      }
    ]
  }
