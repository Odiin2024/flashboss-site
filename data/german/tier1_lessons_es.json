    "header_color": "cyan",
    "pages": [
      {
        "page": 1,
        "total_pages": 1,
        "content": [
          "Las palabras de pregunta empiezan con W",
          "(que suena como una v labiodental):",
          "",
          "wer    = quién     was    = qué",
          "wann   = cuándo    wo     = dónde",
          "warum  = por qué   wie    = cómo",
          "welche = cuál",
          "",
          "ORDEN: interrogativa → VERBO → sujeto",
          "",
          "Was machst du heute?",
          "(¿Qué haces hoy?)",
          "",
          "PREGUNTAS DE SÍ/NO: ¡empieza por el verbo!",
          "Gehst du nach Hause?",
          "(¿Vas a casa?)"
        ],
        "pronunciation": "Lektion drei"
      }
    ]
  },
