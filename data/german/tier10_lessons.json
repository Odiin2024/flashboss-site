          "das geschriebene Buch (the written book)",
          "die gestohlene Tasche (the stolen bag)",
          "",
          "EXTENDED PARTICIPIAL PHRASES:",
          "Add modifiers between article and noun:",
          "",
          "das gestern geschriebene Buch",
          "(the book that was written yesterday)",
          "",
          "der oft diskutierte Plan",
          "(the plan that is often discussed)",
          "",
          "die neu eröffnete Bar",
          "(the newly opened bar)"
        ],
