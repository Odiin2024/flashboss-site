    "header_color": "cyan",
    "pages": [
      {
        "page": 1,
        "total_pages": 1,
        "content": [
          "El alemán usa el Perfekt para el pasado:",
          "ESTRUCTURA: haben/sein + participio",
          "",
          "VERBOS REGULARES: ge- + raíz + -t",
          "machen → Ich habe gemacht.",
          "kaufen → Ich habe gekauft.",
          "",
          "IRREGULARES: ge- + raíz (suele cambiar) + -en",
          "gehen → Ich bin gegangen.",
          "fahren → Ich bin gefahren.",
          "",
          "CUÁNDO USAR SEIN (y no haben):",
          "• Movimiento: gehen, fahren, kommen, fliegen",
          "• Cambio de estado: werden, sterben, aufwachen",
          "• Especiales: sein, bleiben",
          "",
          "Der Zug ist abgefahren. (El tren ya salió)",
          "Ich habe Deutsch gelernt. (Aprendí alemán)"
        ],
        "pronunciation": "Lektion siebzehn"
      }
    ]
  },
