        "content": [
          "Tres verbos alemanes para \"saber/conocer\":",
          "",
          "KENNEN = conocer (personas, lugares, cosas)",
          "Ich kenne Berlin. (Conozco Berlín)",
          "Ich kenne sie. (La conozco)",
          "Conjugación regular: kenne, kennst, kennt",
          "",
          "WISSEN = saber (hechos, información)",
          "Ich weiß das. (Sé eso)",
          "Ich weiß, dass... (Sé que...)",
          "Irregular: ich weiß, du weißt, er weiß",
          "",
          "KÖNNEN = saber hacer algo (habilidad)",
          "Ich kann Deutsch. (Sé alemán, lo hablo)",
          "Ich kann schwimmen. (Sé nadar)",
          "",
          "\"kennen\" = estar familiarizado con algo",
          "\"wissen\" = saber un dato"
        ],
        "pronunciation": "Lektion fünfundzwanzig"
      }
    ]
  }
