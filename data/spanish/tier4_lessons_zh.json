        "content": [
          "有些动词在变位时，词干中的元音会发生变化。",
          "词尾保持不变。",
          "",
          "e → ie：                              按 1",
          "querer：quiero, quieres, quiere,",
          "queremos, quieren",
          "另如：pensar, entender, preferir",
          "",
          "o → ue：                              按 2",
          "poder：puedo, puedes, puede,",
          "podemos, pueden",
          "另如：dormir, volver, costar",
          "",
          "e → i：                               按 3",
          "pedir：pido, pides, pide,",
          "pedimos, piden",
          "另如：seguir, repetir, conseguir"
        ],
        "pronunciation": "Lección diecisiete",
        "pronunciation_mappings": {
          "1": "quiero, quieres, quiere, queremos, quieren",
          "2": "puedo, puedes, puede, podemos, pueden",
          "3": "pido, pides, pide, pedimos, piden"
        }
      }
    ]
