    "header_color": "yellow",
    "pages": [
      {
        "page": 1,
        "total_pages": 1,
        "content": [
          "REAL (likely/possible):              Press 1",
          "Si + present → present/future",
          "Si llueve, me quedo en casa.",
          "(If it rains, I stay home.)",
          "",
          "HYPOTHETICAL (unlikely):             Press 2",
          "Si + imperfect subjunctive → conditional",
          "Si tuviera dinero, viajaría.",
          "(If I had money, I would travel.)",
          "",
          "PAST UNREAL (impossible):            Press 3",
          "",
          "Si + pluperfect subj → conditional perfect",
          "Si hubiera estudiado, habría aprobado.",
          "(If I had studied, I would have passed.)",
          "",
          "Note: NEVER si + present subjunctive.",
          "That's the most common mistake."
        ],
        "pronunciation": "Lección veintiocho",
        "pronunciation_mappings": {
          "1": "si llueve, me quedo en casa",
          "2": "si tuviera dinero, viajaría",
          "3": "si hubiera estudiado, habría aprobado"
        }
      }
    ]
  },
