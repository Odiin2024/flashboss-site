  {
    "lesson_id": "008",
    "trigger_word": "patrino",
    "title": "LESSON 23: FEMININE SUFFIX -IN-",
    "header_color": "green",
    "pages": [
      {
        "page": 1,
        "total_pages": 1,
        "content": [
          "To make a word specifically female, add",
          "-IN- after the root, before the ending.",
          "",
          "FAMILY MEMBERS:                       Press 1",
          "patro → patrino    = father → mother",
          "frato → fratino    = brother → sister",
          "filo  → filino     = son → daughter",
          "edzo  → edzino     = husband → wife",
          "",
          "STRUCTURE:",
          "patr-in-o  = mother (noun -o)",
          "patr-in-a  = motherly (adjective -a)",
          "",
          "WORKS WITH OTHER WORDS TOO:           Press 2",
          "knabo → knabino    = boy → girl",
          "hundo → hundino    = dog → female dog",
          "amiko → amikino    = friend → female friend",
          "(A girlfriend is a koramikino.)"
        ],
        "pronunciation": "Leciono ok",
        "pronunciation_mappings": {
          "1": "Patro. Patrino. Frato. Fratino. Filo. Filino. Edzo. Edzino.",
          "2": "Knabo. Knabino. Hundo. Hundino. Amiko. Amikino. Koramikino."
        }
      }
    ]
  },
