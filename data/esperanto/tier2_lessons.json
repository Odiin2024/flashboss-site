          "   parolanto    = speaker (paroli = speak)",
          "   komencanto   = beginner",
          "",
          "-UL- = a person who IS that way:      Press 3",
          "   junulo       = young person (juna)",
          "   maljunulo    = old person (maljuna)",
          "",
          "Mi estas komencanto.                  Press 4",
          "= I'm a beginner."
        ],
        "pronunciation_mappings": {
          "1": "Instruisto. Programisto. Esperantisto.",
          "2": "Lernanto. Parolanto. Komencanto.",
          "3": "Junulo. Maljunulo.",
          "4": "Mi estas komencanto."
        }
      }
