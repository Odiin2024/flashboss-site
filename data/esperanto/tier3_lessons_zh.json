                    "",
                    "动词 → 能被……的：                        按 1",
                    "aŭdi     → aŭdebla     = 听得见的",
                    "vidi     → videbla     = 看得见的",
                    "legi     → legebla     = 可读的",
                    "kompreni → komprenebla = 可理解的",
                    "manĝi    → manĝebla    = 可食用的",
                    "",
                    "前面加 NE-，表示不能：                   按 2",
                    "nevidebla   = 看不见的",
                    "nemanĝebla  = 不可食用的"
                ],
                "pronunciation": "Leciono dudek ses",
                "pronunciation_mappings": {
                    "1": "Aŭdi. Aŭdebla. Vidi. Videbla. Legi. Legebla. Kompreni. Komprenebla. Manĝi. Manĝebla.",
                    "2": "Nevidebla. Nemanĝebla."
                }
            },
            {
                "page": 2,
                "total_pages": 2,
                "content": [
                    "实际用法：                               按 1",
                    "Ĉu mi estas aŭdebla?",
