    "header_color": "green",
    "pages": [
      {
        "page": 1,
        "total_pages": 1,
        "content": [
          "El prefijo GE- significa 'ambos sexos",
          "juntos': el grupo mixto, la gente en conjunto.",
          "",
          "FAMILIA:",
          "patro    = padre",
          "patrino  = madre",
          "gepatroj = padres (papá y mamá)",
          "",
          "frato    = hermano",
          "fratino  = hermana",
          "gefratoj = hermanos (hermanos y hermanas)",
          "",
          "Tu plural 'padres' deja duda; ge- la elimina.",
          "",
          "MÁS EJEMPLOS:",
          "gesinjoroj  = damas y caballeros",
          "geedzoj     = matrimonio, pareja casada",
          "gelernantoj = alumnos y alumnas"
        ],
        "pronunciation": "Leciono dudek ok"
      }
    ]
  },
