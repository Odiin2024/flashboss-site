    "header_color": "green",
    "pages": [
      {
        "page": 1,
        "total_pages": 1,
        "content": [
          "BO- kennzeichnet Verwandte durch Heirat.",
          "",
          "ANGEHEIRATETE FAMILIE:",
          "patro   → bopatro     = Schwiegervater",
          "patrino → bopatrino   = Schwiegermutter",
          "frato   → bofrato     = Schwager",
          "fratino → bofratino   = Schwägerin",
          "filo    → bofilo      = Schwiegersohn",
          "filino  → bofilino    = Schwiegertochter",
          "",
          "MERKE:",
          "ge- = beide Geschlechter (gepatroj = Eltern)",
          "bo- = durch Heirat (bogepatroj)",
          "      = die Schwiegereltern",
          "",
          "IM GEBRAUCH:",
          "Mia bopatro estas tre afabla.",
          "(Mein Schwiegervater ist sehr nett.)"
        ],
        "pronunciation": "Leciono tridek kvar"
      }
    ]
  },
  {
