    "header_color": "green",
    "pages": [
      {
        "page": 1,
        "total_pages": 1,
        "content": [
          "Die Endung -ER- bedeutet „Einzelteil“",
          "oder „Teilchen“. Sie bildet Wörter für",
          "ein einzelnes Stück aus einer Menge.",
          "",
          "TEILCHEN UND TROPFEN:",
          "akvo    → akvero    = Wasser → Tropfen",
          "sablo   → sablero   = Sand → Sandkorn",
          "neĝo    → neĝero    = Schnee → Flocke",
          "fajro   → fajrero   = Feuer → Funke",
          "",
          "EINZELNE STÜCKE:",
          "mono    → monero    = Geld → Münze",
          "pano    → panero    = Brot → Krümel",
          "",
          "IM GEBRAUCH:",
          "Akvero falis sur mian nazon.",
          "(Ein Tropfen fiel auf meine Nase.)",
          "-ER- greift ein Stück aus der Masse!"
        ],
        "pronunciation": "Leciono tridek kvin"
      }
    ]
  },
