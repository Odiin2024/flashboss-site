    "title": "LEKTION 41: DAS PRÄFIX 'DIS-'",
    "header_color": "green",
    "pages": [
      {
        "page": 1,
        "total_pages": 2,
        "content": [
          "Das Präfix DIS- bedeutet AUSEINANDER: in",
          "alle Richtungen oder in Stücke.",
          "",
          "VERTEILEN:                           Drücke 1",
          "doni    → disdoni    = geben → verteilen",
          "sendi   → dissendi   = senden → versenden",
          "vastigi → disvastigi = weiten → verbreiten",
          "ĵeti    → disĵeti    = werfen → verstreuen",
          "",
          "AUSEINANDER:                         Drücke 2",
          "iri     → disiri     = gehen → auseinandergehen",
          "fali    → disfali    = fallen → zerfallen",
          "",
          "IM GEBRAUCH:                         Drücke 3",
          "Ni disdonis flugfoliojn en la urbo.",
          "= Wir haben in der Stadt Flyer verteilt.",
          "Ni disvastigu la novaĵon!",
          "= Verbreiten wir die Nachricht!"
        ],
        "pronunciation_mappings": {
          "1": "Doni. Disdoni. Sendi. Dissendi. Vastigi. Disvastigi. Ĵeti. Disĵeti.",
          "2": "Iri. Disiri. Fali. Disfali.",
          "3": "Ni disdonis flugfoliojn en la urbo. Ni disvastigu la novaĵon!"
        },
        "pronunciation": "Leciono tridek ses"
      },
      {
        "page": 2,
        "total_pages": 2,
        "content": [
          "DOPPELGÄNGER: Nicht jedes Wort, das mit",
          "dis- beginnt, hat das Präfix DIS-.",
          "",
          "DAS SIND EIGENE WURZELN:             Drücke 1",
          "diskuti  = diskutieren",
          "distri   = ablenken, unterhalten",
          "distro   = Ablenkung, Unterhaltung",
          "disponi  = verfügen über",
          "distanco = Abstand, Entfernung",
          "",
          "DER TEST: Nimm DIS- weg. Bleibt ein Wort",
          "mit DERSELBEN Idee, nur auseinander",
          "(dis-doni: doni = geben), ist es das",
          "Präfix. Sonst ist es eine einzige Wurzel."
        ],
        "pronunciation_mappings": {
          "1": "Diskuti. Distri. Distro. Disponi. Distanco."
        }
      }
    ]
  },
