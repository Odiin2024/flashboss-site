          "arbo    → arbaro     = Baum → Wald",
          "homo    → homaro     = Mensch → Menschheit",
          "vorto   → vortaro    = Wort → Wörterbuch",
          "ilo     → ilaro      = Werkzeug → Werkzeugsatz",
          "besto   → bestaro    = Tier → Tierwelt",
          "",
          "DAS MUSTER:",
          "Nimm ein einzelnes Ding, häng -ar- an,",
          "und du hast die Sammlung davon!",
          "",
          "Mi havas grandan vortaron.",
          "(Ich habe ein großes Wörterbuch.)"
        ],
        "pronunciation": "Leciono dudek"
      }
    ]
