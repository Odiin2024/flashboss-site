    "header_color": "green",
    "pages": [
      {
        "page": 1,
        "total_pages": 1,
        "content": [
          "Los participios activos describen al que HACE",
          "una acción en distintos tiempos. Tres formas:",
          "",
          "-ANT- = hace ahora (presente)",
          "legi → leganta = leyendo (ahora)",
          "parolanta = hablando (ahora)",
          "",
          "-INT- = ya hizo (pasado)",
          "legi → leginta = que ha leído",
          "parolinta = que ha hablado",
          "",
          "-ONT- = va a hacer (futuro)",
          "legi → legonta = que leerá",
          "parolonta = que hablará",
          "",
          "La leganta viro... = El hombre que lee...",
          "La leginta viro... = El hombre que leyó...",
          "La legonta viro... = El hombre que leerá..."
        ],
        "pronunciation": "Leciono kvardek du"
      }
    ]
  },
