    "header_color": "green",
    "pages": [
      {
        "page": 1,
        "total_pages": 1,
        "content": [
          "Los participios pasivos describen al RECEPTOR",
          "de una acción en distintos tiempos:",
          "",
          "-AT- = estar siendo hecho (presente)",
          "legi → legata = estar siendo leído",
          "la legata libro = el libro que se está leyendo",
          "",
          "-IT- = hecho/completado (pasado)",
          "legi → legita = leído/haber sido leído",
          "la legita libro = el libro leído",
          "",
          "-OT- = a punto de hacerse (futuro)",
          "legi → legota = a punto de ser leído",
          "la legota libro = el libro por leer",
          "",
          "ACTIVO VS PASIVO:",
          "leganta viro = un hombre que lee (él lee)",
          "legita libro = un libro leído (fue leído)"
        ],
        "pronunciation": "Leciono kvardek kvin"
      }
    ]
  },
