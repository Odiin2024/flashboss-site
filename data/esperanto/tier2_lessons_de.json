        "header_color": "green",
        "pages": [
            {
                "page": 1,
                "total_pages": 2,
                "content": [
                    "Zwei Suffixe drehen die GRÖSSE oder STÄRKE",
                    "eines Wortes hoch oder runter:",
                    "",
                    "-ET- = klein, schwach, ein wenig:    Drücke 1",
                    "   domo → dometo   = Haus → Häuschen",
                    "   ridi → rideti   = lachen → lächeln",
                    "   iom  → iomete   = etwas → ein bisschen",
                    "",
                    "-EG- = groß, stark, sehr:            Drücke 2",
                    "   domo → domego   = Haus → Riesenhaus",
                    "   bona → bonega   = gut → ausgezeichnet",
                    "   ridi → ridegi   = lachen → schallend lachen",
                    "",
                    "IM GEBRAUCH:                         Drücke 3",
                    "   Atendu iomete!  = Warte ein bisschen!",
                    "   Bonege!         = Toll! Ausgezeichnet!"
                ],
                "pronunciation_mappings": {
                    "1": "Domo. Dometo. Ridi. Rideti. Iom. Iomete.",
                    "2": "Domo. Domego. Bona. Bonega. Ridi. Ridegi.",
                    "3": "Atendu iomete! Bonege!"
                }
            },
            {
                "page": 2,
                "total_pages": 2,
                "content": [
                    "Zwei weitere Suffixe beschreiben eine",
                    "Neigung oder einen Wert:",
                    "",
                    "-EM- = neigt dazu, tut es gern:      Drücke 1",
                    "   helpi  → helpema   = helfen → hilfsbereit",
                    "   paroli → parolema  = reden → gesprächig",
                    "   Ŝi estas tre helpema. = Sie hilft sehr gern.",
                    "   (Bei Menschen. Ein nützliches Buch: utila.)",
                    "",
                    "-IND- = ist es wert, verdient es:    Drücke 2",
                    "   vidi → vidinda   = sehen → sehenswert",
                    "   legi → leginda   = lesen → lesenswert",
                    "   ridi → ridinda   = lachen → lächerlich!",
                    "",
                    "Achtung: ridinda heißt LÄCHERLICH, nicht",
                    "lustig. Lustig = amuza."
                ],
                "pronunciation_mappings": {
                    "1": "Helpi. Helpema. Paroli. Parolema. Ŝi estas tre helpema.",
                    "2": "Vidi. Vidinda. Legi. Leginda. Ridi. Ridinda."
                }
            }
