                    "edzo  → edzino     = Ehemann → Ehefrau",
                    "",
                    "AUFBAU:",
                    "patr-in-o  = Mutter (Substantiv -o)",
                    "patr-in-a  = mütterlich (Adjektiv -a)",
                    "",
                    "GEHT AUCH MIT ANDEREN WÖRTERN:       Drücke 2",
                    "knabo → knabino    = Junge → Mädchen",
                    "hundo → hundino    = Hund → Hündin",
                    "amiko → amikino    = Freund → Freundin",
                    "(Eine feste Freundin ist eine koramikino.)"
                ],
                "pronunciation": "Leciono ok",
                "pronunciation_mappings": {
                    "1": "Patro. Patrino. Frato. Fratino. Filo. Filino. Edzo. Edzino.",
                    "2": "Knabo. Knabino. Hundo. Hundino. Amiko. Amikino. Koramikino."
                }
            }
        ]
    },
