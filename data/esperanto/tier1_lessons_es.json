          "   espero, bela, tre",
          "",
          "'I' como en sí:               Presiona 3",
          "   iri, amiko, mi",
          "",
          "'O' como en todo:             Presiona 4",
          "   oro, nova, horo",
          "",
          "'U' como en luna:             Presiona 5",
          "   urbo, kultur, nu"
