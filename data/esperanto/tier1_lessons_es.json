                    "Después de DA va el sustantivo solo: sin LA",
                    "y nunca con -N.",
                    "",
                    "¿CUÁNTO? ¿CUÁNTOS? = KIOM DA:      Presiona 1",
                    "   Kiom da tempo vi havas?",
                    "   = ¿Cuánto tiempo tienes?",
                    "   Kiom da amikoj vi havas?",
                    "   = ¿Cuántos amigos tienes?",
                    "",
                    "CANTIDAD + DA + COSA:              Presiona 2",
                    "   taso da kafo     = una taza de café",
                    "   glaso da akvo    = un vaso de agua",
                    "   multe da tempo   = mucho tiempo",
                    "   iom da pano      = un poco de pan",
                    "   pli da teo       = más té"
                ],
                "pronunciation_mappings": {
                    "1": "Kiom da tempo vi havas? Kiom da amikoj vi havas?",
                    "2": "Taso da kafo. Glaso da akvo. Multe da tempo. Iom da pano. Pli da teo."
                }
            },
            {
                "page": 2,
                "total_pages": 2,
                "content": [
                    "LA -N VA EN LA CANTIDAD,",
                    "NUNCA EN LA PALABRA TRAS DA:       Presiona 1",
                    "   Mi trinkas tason da kafo.",
                    "   = Tomo una taza de café.",
                    "   Mi havas multe da amikoj.",
                    "   = Tengo muchos amigos. (multe: sin -n)",
                    "",
                    "SIN LA DESPUÉS DE DA:              Presiona 2",
                    "   iom da kafo      = un poco de café",
                    "   iom de la kafo   = un poco del café",
                    "   (¿Algo concreto? Usa DE + LA.)"
                ],
                "pronunciation_mappings": {
                    "1": "Mi trinkas tason da kafo. Mi havas multe da amikoj.",
                    "2": "Iom da kafo. Iom de la kafo."
                }
            }
        ]
    },
