          "",
          "РАБОТАЕТ С ЛЮБЫМ СЛОВОМ:",
          "knabo → knabino    = мальчик → девочка",
          "hundo → hundino    = собака → сука",
          "amiko → amikino    = друг → подруга"
        ]
      }
    ]
