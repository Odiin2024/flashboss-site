          "lernejo → lernejestro = escuela → director",
          "ŝipo    → ŝipestro    = barco → capitán",
          "ŝtato   → ŝtatestro   = estado → jefe de estado",
          "",
          "SOLO, Y CON -AR- Y -AN-:           Presiona 2",
          "estro     = líder, jefe",
          "estri     = dirigir, estar al mando",
          "estraro   = junta directiva",
          "estrarano = miembro de la junta",
          "",
          "EN USO:                            Presiona 3",
          "La estraro elektis novan prezidanton.",
          "= La junta eligió a un nuevo presidente."
        ],
        "pronunciation_mappings": {
          "1": "Urbo. Urbestro. Lernejo. Lernejestro. Ŝipo. Ŝipestro. Ŝtato. Ŝtatestro.",
          "2": "Estro. Estri. Estraro. Estrarano.",
          "3": "La estraro elektis novan prezidanton."
        },
        "pronunciation": "Leciono tridek naŭ"
      },
      {
        "page": 2,
        "total_pages": 2,
        "content": [
