          "urbo    → ĉefurbo    = ciudad → capital",
          "afiŝo   → ĉefafiŝo   = aviso → aviso principal",
          "punkto  → ĉefpunkto  = punto → punto principal",
          "ĉefa = principal     ĉefe = principalmente",
          "",
          "¿ĈEFO O -ESTRO?                    Presiona 2",
          "ĉefo   = el jefe (en el trabajo)",
          "-estro = la cabeza DE un lugar o grupo",
          "Mia ĉefo estas afabla.",
          "= Mi jefe es amable.",
          "",
          "EN USO:                            Presiona 3",
          "Berlino estas la ĉefurbo de Germanio.",
          "= Berlín es la capital de Alemania."
        ],
        "pronunciation_mappings": {
          "1": "Urbo. Ĉefurbo. Afiŝo. Ĉefafiŝo. Punkto. Ĉefpunkto. Ĉefa. Ĉefe.",
          "2": "Ĉefo. Urbestro. Mia ĉefo estas afabla.",
          "3": "Berlino estas la ĉefurbo de Germanio."
        }
      }
    ]
  },
