          "la legota libro = das zu lesende Buch",
          "",
          "AKTIV GEGEN PASSIV:",
          "leganta viro = ein Mann, der liest",
          "legita libro = ein Buch, das gelesen wurde"
        ],
        "pronunciation": "Leciono kvardek kvin"
      }
