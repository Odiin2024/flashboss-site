    "header_color": "green",
    "pages": [
      {
        "page": 1,
        "total_pages": 1,
        "content": [
          "Das Präfix PRA- bedeutet „alt“ oder „Ur-“",
          "(über Generationen). Es reicht weit zurück.",
          "",
          "ABSTAMMUNG (mehrere PRA- = mehr Generationen):",
          "avo     → praavo     = Opa → Urgroßvater",
          "avino   → praavino   = Oma → Urgroßmutter",
          "patro   → prapatro   = Vater → Ahne",
          "prapraavo = Ururgroßvater",
          "",
          "ALT:",
          "homo    → prahomo    = Mensch → Urmensch",
          "arbaro  → praarbaro  = Wald → Urwald",
          "",
          "IN VERWENDUNG:",
          "Mia praavo venis el Francio.",
          "(Mein Urgroßvater kam aus Frankreich.)",
          "",
          "PRA- reicht weit in die Vergangenheit!"
        ],
        "pronunciation": "Leciono kvardek kvar"
      }
    ]
  },
