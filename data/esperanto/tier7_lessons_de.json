    "header_color": "green",
    "pages": [
      {
        "page": 1,
        "total_pages": 1,
        "content": [
          "MIS- funktioniert wie im Englischen:",
          "falsch, irrtümlich oder fehlerhaft.",
          "",
          "kompreni → miskompreni (missverstehen)",
          "uzi      → misuzi      (missbrauchen)",
          "diri     → misdiri     (sich versprechen)",
          "",
          "Es gilt für jedes Verb. Füge einfach",
          "„mis-“ hinzu. Denk an englische Wörter:",
          "",
          "misplace, misjudge, mislead, misread,",
          "miscount, misquote, misfire, mislabel,",
          "misinform, mismanage, mistrust, mishear",
          "",
          "Gleicher Präfix, gleiche Logik,",
          "gleicher Instinkt. Wenn du „mis-“ in",
          "Esperanto siehst, weißt du bereits,",
          "was es bedeutet."
        ],
        "pronunciation": "Leciono kvardek ses"
      }
    ]
  }
