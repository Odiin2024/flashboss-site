    {
        "lesson_id": "002",
        "trigger_word": "estas",
        "title": "LEKTION 2: PRÄSENS",
        "header_color": "green",
        "pages": [
            {
                "page": 1,
                "total_pages": 1,
                "content": [
                    "Das Präsens ist im Esperanto einfach:",
                    "ALLE Verben enden auf -as, egal wer handelt.",
                    "",
                    "BEISPIELE MIT 'ESTI' (sein):         Drücke 1",
                    "",
                    "mi estas      = ich bin",
                    "vi estas      = du bist / ihr seid / Sie sind",
                    "li estas      = er ist",
                    "ŝi estas      = sie ist",
                    "ni estas      = wir sind",
                    "ili estas     = sie sind",
                    "",
                    "BEISPIELE MIT 'PAROLI' (sprechen):   Drücke 2",
                    "mi parolas    = ich spreche",
                    "vi parolas    = du sprichst",
                    "li parolas    = er spricht",
                    "",
                    "Das Verb ändert sich NIE! Eine Form für alle."
                ],
                "pronunciation": "Leciono du",
                "pronunciation_mappings": {
                    "1": "Mi estas. Vi estas. Li estas. Ŝi estas. Ni estas. Ili estas.",
                    "2": "Mi parolas. Vi parolas. Li parolas."
                }
            }
        ]
    },
    {
        "lesson_id": "004",
