    {
        "lesson_id": "005",
        "trigger_word": "kio",
        "title": "LEKTION 6: FRAGEWÖRTER (KI-)",
        "header_color": "green",
        "pages": [
            {
                "page": 1,
                "total_pages": 2,
                "content": [
                    "Die meisten Fragewörter im Esperanto",
                    "beginnen mit KI-. Sie gehören zu einem",
                    "schönen System (siehe nächste Seite).",
                    "",
                    "DIE FRAGEWÖRTER:                     Drücke 1",
                    "kio   = was (Ding)",
                    "kiu   = wer / welcher",
                    "kie   = wo (Ort)",
                    "kiam  = wann (Zeit)",
                    "kial  = warum (Grund)",
                    "kiel  = wie (Art und Weise)",
                    "kiom  = wie viel / wie viele",
                    "",
                    "BEISPIELE:                           Drücke 2",
                    "Kio estas tio?     = Was ist das?",
                    "Kiu vi estas?      = Wer bist du?",
                    "Kie vi loĝas?      = Wo wohnst du?",
                    "Kiam vi venas?     = Wann kommst du?"
                ],
                "pronunciation": "Leciono kvin",
                "pronunciation_mappings": {
                    "1": "Kio. Kiu. Kie. Kiam. Kial. Kiel. Kiom.",
                    "2": "Kio estas tio? Kiu vi estas? Kie vi loĝas? Kiam vi venas?"
                }
            },
            {
                "page": 2,
                "total_pages": 2,
                "content": [
                    "Tausch KI- gegen einen anderen Anfang,",
                    "und du hast die Antworten:           Drücke 1",
                    "",
                    "            Ding   einer  Ort    Zeit",
                    "KI-  was?   kio    kiu    kie    kiam",
                    "TI-  das    tio    tiu    tie    tiam",
                    "ĈI-  jede   ĉio    ĉiu    ĉie    ĉiam",
                    "NENI- kein  nenio  neniu  nenie  neniam",
                    "I-   irgend io     iu     ie     iam",
                    "",
                    "BEISPIELE:                           Drücke 2",
                    "Kie? Tie!          = Wo? Dort!",
                    "Ĉio estas bona.    = Alles ist gut.",
                    "Neniu scias.       = Niemand weiß es.",
                    "Iu venas.          = Jemand kommt.",
                    "",
                    "Mit ĈI wird tio (das) zu ĉi tio (dies)."
                ],
                "pronunciation_mappings": {
                    "1": "Kio. Tio. Ĉio. Nenio. Io. Kiam. Tiam. Ĉiam. Neniam. Iam.",
                    "2": "Kie? Tie! Ĉio estas bona. Neniu scias. Iu venas."
                }
            }
        ]
    },
