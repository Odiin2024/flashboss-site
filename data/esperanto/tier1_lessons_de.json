          "System - mehr dazu später!",
          "",
          "DIE FRAGEWÖRTER:",
          "kio   = was (Ding)",
          "kiu   = wer / welcher",
          "kie   = wo (Ort)",
          "kiam  = wann (Zeit)",
          "kial  = warum (Grund)",
          "kiel  = wie (Art)",
          "kiom  = wie viel / wie viele",
          "",
          "BEISPIELE:",
          "Kio estas tio?     = Was ist das?",
          "Kiu vi estas?      = Wer bist du?",
          "Kie vi loĝas?      = Wo wohnst du?",
          "Kiam vi venas?     = Wann kommst du?"
        ],
        "pronunciation": "Leciono kvin"
      }
    ]
  },
