    "header_color": "green",
    "pages": [
      {
        "page": 1,
        "total_pages": 1,
        "content": [
          "Um ein Wort ausdrücklich weiblich zu machen,",
          "setz -IN- hinter die Wurzel, vor die Endung.",
          "",
          "Genau wie das deutsche -in: Lehrer → Lehrerin!",
          "",
          "FAMILIE:",
          "patro → patrino    = Vater → Mutter",
          "frato → fratino    = Bruder → Schwester",
          "filo → filino      = Sohn → Tochter",
          "",
          "AUFBAU:",
          "patr-in-o  = Mutter (Substantiv -o)",
          "patr-in-a  = mütterlich (Adjektiv -a)",
          "",
          "GEHT MIT ALLEM:",
          "knabo → knabino    = Junge → Mädchen",
          "hundo → hundino    = Hund → Hündin",
          "amiko → amikino    = Freund → Freundin"
        ],
        "pronunciation": "Leciono ok"
      }
    ]
  },
