    "header_color": "green",
    "pages": [
      {
        "page": 1,
        "total_pages": 1,
        "content": [
          "Adverbien sagen, WIE etwas geschieht.",
          "Im Esperanto enden sie immer auf -e.",
          "Im Deutschen sehen Adjektiv und Adverb",
          "gleich aus - Esperanto trennt sie klar:",
          "",
          "bona → bone       = gut",
          "rapida → rapide   = schnell",
          "facila → facile   = leicht",
          "lenta → lente     = langsam",
          "",
          "DER UNTERSCHIED:",
          "Li estas bona.",
          "(Er ist gut. ← beschreibt IHN)",
          "",
          "Li kantas bone.",
          "(Er singt gut. ← beschreibt das WIE)",
          "",
          "Merke: -a fürs Substantiv, -e fürs Tun!"
        ],
        "pronunciation": "Leciono kvar"
      }
    ]
  },
