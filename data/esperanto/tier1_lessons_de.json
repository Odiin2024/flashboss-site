    {
        "lesson_id": "030",
        "trigger_word": "bonvolu",
        "title": "LEKTION 4: BEFEHLE UND BITTEN",
        "header_color": "green",
        "pages": [
            {
                "page": 1,
                "total_pages": 2,
                "content": [
                    "Die Endung -U macht aus einem Verb eine Bitte",
                    "oder einen Befehl. Eine Form für alle!",
                    "",
                    "Im Wörterbuch endet ein Verb auf -I.",
                    "Tausch das -I gegen -U:              Drücke 1",
                    "   veni    → Venu!     = Komm!",
                    "   atendi  → Atendu!   = Warte!",
                    "   helpi   → Helpu!    = Hilf!",
                    "   pardoni → Pardonu!  = Entschuldigung!",
                    "",
                    "BITTE = BONVOLU + die -I-Form:       Drücke 2",
                    "   Bonvolu ripeti!     = Bitte wiederholen!",
                    "   Bonvolu atendi!     = Bitte warten!",
                    "   (bonvolu = 'sei so gut und ...')"
                ],
                "pronunciation": "Leciono tridek",
                "pronunciation_mappings": {
                    "1": "Venu! Atendu! Helpu! Pardonu!",
                    "2": "Bonvolu ripeti! Bonvolu atendi!"
                }
            },
            {
                "page": 2,
                "total_pages": 2,
                "content": [
                    "LASST UNS ... = NI + -U:             Drücke 1",
                    "   Ni iru!             = Gehen wir!",
                    "   Ni komencu!         = Fangen wir an!",
                    "",
                    "... NICHT! = NE + -U:                Drücke 2",
                    "   Ne forgesu!         = Vergiss es nicht!",
                    "   Ne timu!            = Hab keine Angst!",
                    "",
                    "KLAPPT AUCH MIT ER UND SIE:          Drücke 3",
                    "   Li venu!            = Er soll kommen!",
                    "",
                    "HÖFLICHER: + MI PETAS (ich bitte):   Drücke 4",
                    "   Atendu, mi petas!   = Warte bitte!"
                ],
                "pronunciation_mappings": {
                    "1": "Ni iru! Ni komencu!",
                    "2": "Ne forgesu! Ne timu!",
                    "3": "Li venu!",
                    "4": "Atendu, mi petas!"
                }
            }
        ]
    },
