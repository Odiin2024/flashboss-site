          "Das Präfix RE- bedeutet WIEDER oder",
          "ZURÜCK: Die Handlung geschieht noch einmal",
          "oder geht dorthin zurück, woher sie kam.",
          "",
          "WIEDER:                              Drücke 1",
          "legi     → relegi     = lesen → wieder lesen",
          "fari     → refari     = machen → neu machen",
          "kontakti → rekontakti = erneut kontaktieren",
          "",
          "ZURÜCK:                              Drücke 2",
          "veni     → reveni     = kommen → zurückkommen",
          "doni     → redoni     = geben → zurückgeben",
          "sendi    → resendi    = senden → zurücksenden",
          "",
          "IM GEBRAUCH:                         Drücke 3",
          "Mi revenos al la temo morgaŭ.",
          "= Ich komme morgen auf das Thema zurück.",
          "Ĝis revido! = Auf Wiedersehen!"
        ],
        "pronunciation_mappings": {
          "1": "Legi. Relegi. Fari. Refari. Kontakti. Rekontakti.",
          "2": "Veni. Reveni. Doni. Redoni. Sendi. Resendi.",
          "3": "Mi revenos al la temo morgaŭ. Ĝis revido!"
        },
        "pronunciation": "Leciono kvindek du"
      }
    ]
  },
