          "‎edzo  → edzino     = زوج ← زوجة",
          "",
          "البنية:",
          "‎patr-in-o  = أم (اسم، النهاية -o)",
          "‎patr-in-a  = أمومي (صفة، النهاية -a)",
          "",
          "‎‏وتصلح مع كلمات أخرى أيضا:‏‎          للاستماع 2",
          "‎knabo → knabino    = فتى ← فتاة",
          "‎hundo → hundino    = كلب ← كلبة",
          "‎amiko → amikino    = صديق ← صديقة",
          "(والحبيبة koramikino، أي «صديقة القلب».)"
        ],
        "pronunciation": "Leciono ok",
        "pronunciation_mappings": {
          "1": "Patro. Patrino. Frato. Fratino. Filo. Filino. Edzo. Edzino.",
          "2": "Knabo. Knabino. Hundo. Hundino. Amiko. Amikino. Koramikino."
        }
      }
    ]
  },
