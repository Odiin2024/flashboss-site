          "belo    = красота (сущ. -o)",
          "beli    = быть красивым (глаг. -i)",
          "",
          "vera → vere → vero",
          "(истинный → поистине → истина)",
          "varma → varme → varmo",
          "(тёплый → тепло → теплота)",
          "МОЖНО ДОБАВИТЬ И АФФИКСЫ:",
          "belega   = великолепный (-eg- увел.)",
          "beligi   = делать красивым (-ig- кауз.)",
          "beleco   = красота (-ec- абстр. кач.)"
        ]
      }
    ]
