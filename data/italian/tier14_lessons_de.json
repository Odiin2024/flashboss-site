    "header_color": "cyan",
    "pages": [
      {
        "page": 1,
        "total_pages": 3,
        "content": [
          "Italienische Prosa, Presse und Fachtexte",
          "leben von KONNEKTOREN — dem Wortschatz",
          "der formalen Argumentation.",
          "",
          "URSACHE / WIRKUNG:",
          "   quindi     = daher",
          "   perciò     = deshalb",
          "   pertanto   = daher (gehoben)",
          "   poiché     = da, weil",
          "   giacché    = da (literarisch)",
          "   di conseguenza = folglich",
          "",
          "GEGENSATZ:",
          "   tuttavia      = jedoch",
          "   però          = aber, doch",
          "   nondimeno     = dennoch",
          "   ciononostante = trotzdem",
          "   invece        = stattdessen"
        ],
        "pronunciation": "Pertanto, procediamo."
      },
      {
        "page": 2,
        "total_pages": 3,
        "content": [
