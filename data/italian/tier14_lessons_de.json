          "   inoltre         = außerdem",
          "   altresì         = ebenfalls (gehoben)",
          "   nonché          = sowie",
          "   oltre a         = außer, neben",
          "",
          "AUFZÄHLUNG — Punkt für Punkt:",
          "   innanzitutto    = zuallererst",
          "   in primo luogo  = erstens",
          "   in secondo luogo = zweitens",
          "   infine          = schließlich",
          "   in conclusione  = abschließend",
          "",
          "SCHLUSSFOLGERUNG:",
          "   dunque          = also, daher",
          "   insomma         = kurzum",
          "   in definitiva   = letztlich",
          "   in sostanza     = im Wesentlichen"
        ]
