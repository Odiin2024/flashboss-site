          "e = 'eh' como en bet               Presiona 2",
          "   bene, sera, leggere",
          "",
          "i = 'ee' como en máquina           Presiona 3",
          "   sì, vita, libro",
          "",
          "o = 'oh' como en no                Presiona 4",
          "   sole, modo, otto",
          "",
          "u = 'oo' como en luna              Presiona 5",
          "   tu, uno, frutto"
