    "header_color": "green",
    "pages": [
      {
        "page": 1,
        "total_pages": 2,
        "content": [
          "Los artículos en italiano cambian",
          "según el sonido, no solo el género.",
          "",
          "MASCULINO SINGULAR:               Presiona 1",
          "   il = antes de consonantes",
          "      il libro, il padre, il cane",
          "   lo = antes de z, gn, ps, s+cons.",
          "      lo zio, lo gnocco, lo stato",
          "",
          "FEMENINO SINGULAR:                Presiona 2",
          "   la = antes de consonante",
          "      la casa, la madre, la zia",
          "",
          "PLURALES:                         Presiona 3",
          "   i, gli (masc.); le (fem.)",
          "      i libri, gli stati, le case"
        ],
        "pronunciation": "Lezione due",
        "pronunciation_mappings": {
          "1": "Il libro. Il padre. Il cane. Lo stato. Lo zio. Lo gnocco.",
          "2": "La casa. La madre. La zia.",
          "3": "I libri. Gli stati. Le case."
        }
      },
      {
        "page": 2,
        "total_pages": 2,
        "content": [
          "ELISIÓN — regla del apóstrofo:",
          "",
          "Antes de vocal, los artículos",
          "singulares pierden su letra final:    Presiona 1",
          "",
          "   il / la / lo + vocal → l'",
          "      l'amico (m), l'aria (f)",
          "      l'ora, l'uomo, l'occhio",
          "",
          "LOS PLURALES NO ELIDEN:               Presiona 2",
          "   gli amici (NO gl'amici)",
          "   le ore (NO l'ore)",
          "",
          "EL GÉNERO SIGUE IMPORTANDO:           Presiona 3",
          "   l'uomo (m) → un uomo, gli uomini",
          "   l'aria (f) → un'aria, le arie",
          "",
          "Las tarjetas muestran Elide: true."
        ],
        "pronunciation_mappings": {
          "1": "L'amico. L'aria. L'ora. L'uomo. L'occhio.",
          "2": "Gli amici. Le ore.",
          "3": "L'uomo. Un uomo. Gli uomini. L'aria. Un'aria. Le arie."
        }
      }
    ]
