          "4": "sole. modo. otto",
          "5": "tu. uno. frutto"
        }
      },
      {
        "page": 2,
        "total_pages": 5,
        "content": [
          "CONSONANTES distintas del inglés:",
          "",
          "   h = siempre MUDA                Presiona 1",
          "      hai, ho, hanno",
          "",
          "   c antes de a/o/u = 'k' dura     Presiona 2",
          "      casa, come, cucina",
          "",
          "   c antes de e/i = 'ch' suave     Presiona 3",
          "      cena, città, dolce",
          "",
          "   g antes de a/o/u = 'g' dura     Presiona 4",
          "      gatto, gusto, lago",
          "",
          "   g antes de e/i = 'j' suave      Presiona 5",
          "      gente, gelato, magia",
          "",
