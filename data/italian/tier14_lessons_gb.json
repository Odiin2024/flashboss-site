        "content": [
          "Italian prose, journalism, academic",
          "writing runs on CONNECTORS — the",
          "vocabulary of formal argument.",
          "",
          "CAUSE / EFFECT:",
          "   quindi     = therefore",
          "   perciò     = for this reason",
          "   pertanto   = therefore (formal)",
          "   poiché     = since, because",
          "   giacché    = since (literary)",
          "   di conseguenza = consequently",
          "",
          "CONTRAST:",
          "   tuttavia      = however",
          "   però          = but, yet",
          "   nondimeno     = nonetheless",
          "   ciononostante = despite this",
          "   invece        = instead"
        ],
        "pronunciation": "Pertanto, procediamo."
      },
      {
        "page": 2,
        "total_pages": 3,
        "content": [
          "ADDITION — stacking points:",
          "   inoltre         = furthermore",
          "   altresì         = also (formal)",
          "   nonché          = as well as",
          "   oltre a         = beyond, besides",
          "",
          "ENUMERATION — listing:",
          "   innanzitutto    = first of all",
          "   in primo luogo  = firstly",
          "   in secondo luogo = secondly",
          "   infine          = finally",
          "   in conclusione  = in conclusion",
          "",
          "CONCLUSION:",
          "   dunque          = therefore, so",
          "   insomma         = in sum",
          "   in definitiva   = ultimately",
          "   in sostanza     = essentially"
        ]
      },
