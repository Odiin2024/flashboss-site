          "   mi dica! = ¡dígame! ¿en qué le ayudo?"
        ],
        "pronunciation_mappings": {
          "1": "Non parlare! Non correre!",
          "2": "Non dimenticate! Non aspetti!",
          "3": "Scusami! Aspettami! Dimmi! Fammi vedere!",
          "4": "Mi scusi! Mi dica!"
