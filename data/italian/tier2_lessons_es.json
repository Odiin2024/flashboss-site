      {
        "page": 1,
        "total_pages": 3,
        "content": [
          "El IMPERATIVO sirve para órdenes,",
          "peticiones y consejos. Tiene cuatro formas:",
          "",
          "          parlare    prendere   sentire",
          "   tu     parla      prendi     senti",
          "   noi    parliamo   prendiamo  sentiamo",
          "   voi    parlate    prendete   sentite",
          "   Lei    parli      prenda     senta",
          "",
          "tu: -are → -a; -ere, -ire → -i        Presiona 1",
          "   guarda! aspetta! senti!",
          "noi = 'hablemos' (igual al presente)  Presiona 2",
          "   andiamo! = ¡vamos!",
          "voi: casi siempre como el presente    Presiona 3",
          "   entrate! = ¡pasen!",
          "Lei (usted): -are → -i; si no, -a     Presiona 4",
          "   scusi! = ¡disculpe!  senta! = ¡oiga!"
        ],
        "pronunciation": "Lezione dodici",
        "pronunciation_mappings": {
          "1": "Parla! Prendi! Senti! Guarda! Aspetta!",
          "2": "Parliamo! Prendiamo! Sentiamo! Andiamo!",
          "3": "Parlate! Prendete! Sentite! Entrate!",
          "4": "Parli! Prenda! Senta! Scusi!"
        }
      },
      {
        "page": 2,
        "total_pages": 3,
        "content": [
          "FORMAS CORTAS de tu — muy comunes:    Presiona 1",
          "              tu            Lei",
          "   andare     va' / vai     vada",
          "   dare       da' / dai     dia",
          "   fare       fa' / fai     faccia",
          "   stare      sta' / stai   stia",
          "   dire       di'           dica",
          "",
          "   stai zitto! = ¡cállate!            Presiona 2",
          "   (a una chica: zitta; a varios: state zitti)",
          "",
          "ESSERE y AVERE:                       Presiona 3",
          "   tu sii,   voi siate,   Lei sia",
          "   tu abbi,  voi abbiate, Lei abbia",
          "   sii gentile!   = ¡sé amable!",
          "   abbi pazienza! = ¡ten paciencia!"
        ],
        "pronunciation_mappings": {
          "1": "Va'! Vai! Vada! Da'! Dai! Dia! Fa'! Fai! Faccia! Sta'! Stai! Stia! Di'! Dica!",
