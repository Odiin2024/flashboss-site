    "pages": [
      {
        "page": 1,
        "total_pages": 5,
        "content": [
          "El CONGIUNTIVO (subjuntivo) expresa",
          "duda, deseo, opinión o emoción:",
          "cualquier cosa que no sea un hecho.",
          "",
          "INDICATIVO (hecho):",
          "   Marco parla italiano.",
          "   Marco habla italiano.",
          "",
          "SUBJUNTIVO (opinión/duda):",
          "   Penso che Marco parli italiano.",
          "   Pienso que Marco hable italiano.",
          "",
          "DISPARADORES: verbos que requieren 'che' +",
          "subjuntivo en la segunda cláusula:",
          "   pensare, credere, sperare,",
          "   temere, dubitare, volere,",
          "   preferire, sembrare, parere..."
        ],
        "pronunciation": "Penso che sia vero."
      },
      {
        "page": 2,
        "total_pages": 5,
        "content": [
          "SUBJUNTIVO PRESENTE — essere y avere:",
          "",
          "ESSERE:",
          "   che io       sia",
          "   che tu       sia",
          "   che lui/lei  sia",
          "   che noi      siamo",
          "   che voi      siate",
          "   che loro     siano",
          "",
          "AVERE:",
          "   che io       abbia",
          "   che tu       abbia",
          "   che lui/lei  abbia",
          "   che noi      abbiamo",
          "   che voi      abbiate",
          "   che loro     abbiano"
        ]
      },
      {
        "page": 3,
        "total_pages": 5,
        "content": [
          "SUBJUNTIVO PRESENTE — terminaciones regulares:",
          "",
          "        -ARE      -ERE      -IRE",
          "io      -i        -a        -a",
          "tu      -i        -a        -a",
          "lui     -i        -a        -a",
          "noi     -iamo     -iamo     -iamo",
          "voi     -iate     -iate     -iate",
          "loro    -ino      -ano      -ano",
          "",
          "EJEMPLOS:",
          "   Credo che parli bene.",
          "   Creo que hable bien.",
          "   Spero che scriva presto.",
          "   Espero que escriba pronto.",
          "   Voglio che partano domani.",
          "   Quiero que se vayan mañana."
        ]
      },
