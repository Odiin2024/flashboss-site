    "header_color": "magenta",
    "pages": [
      {
        "page": 1,
        "total_pages": 3,
        "content": [
          "DISCURSO INDIRECTO = referir lo que",
          "alguien dijo, sin citarlo textualmente.",
          "",
          "DIRECTO:",
          "   Ha detto: 'Vengo domani.'",
          "   Dijo: 'Vengo mañana.'",
          "",
          "INDIRECTO:",
          "   Ha detto che sarebbe venuto",
          "   il giorno dopo.",
          "   Dijo que vendría al día siguiente.",
          "",
          "QUÉ CAMBIA:",
          "   presente   → imperfetto",
          "   passato p. → trapassato prossimo",
          "   futuro     → condicional COMPUESTO",
          "   domani     → il giorno dopo",
          "   ieri       → il giorno prima"
        ],
        "pronunciation": "Ha detto che sarebbe venuto."
      },
      {
        "page": 2,
        "total_pages": 3,
        "content": [
          "LOS CAMBIOS DE TIEMPO en la práctica:",
          "",
          "   'Parto domani.'",
          "   → Ha detto che partiva il",
          "     giorno dopo.",
          "",
          "   'Ho visto Marco.'",
          "   → Ha detto che aveva visto Marco.",
          "",
          "SI LA AFIRMACIÓN SIGUE SIENDO CIERTA:",
          "   el cambio de tiempo es opcional.",
          "   'Roma è bella.'",
          "   → Ha detto che Roma è/era bella.",
          "",
          "SIN CAMBIO tras un verbo en PRESENTE:",
          "   Dice che viene domani.",
          "   = Dice que viene mañana."
        ]
      },
      {
        "page": 3,
        "total_pages": 3,
        "content": [
          "El FUTURO pasa a condicional COMPUESTO:",
          "",
          "   'Verrò alle tre.'                  Presiona 1",
          "   → Ha detto che sarebbe venuto",
          "     alle tre.",
          "   = Dijo que vendría a las tres.",
          "",
          "NO 'che verrebbe'. El español dice",
          "'vendría'; el italiano, 'habría venido'.",
          "",
          "CONDICIONAL COMPUESTO = avrei o sarei",
          "+ participio pasado:                  Presiona 2",
          "   avrei finito    = habría terminado",
          "   sarei venuto/a  = habría venido",
          "",
          "La misma regla para promesas y planes:",
          "   Ha detto che mi avrebbe chiamato.",
          "   = Dijo que me llamaría."
        ],
        "pronunciation_mappings": {
          "1": "Verrò alle tre. Ha detto che sarebbe venuto alle tre.",
          "2": "Avrei finito. Sarei venuto."
        }
      }
