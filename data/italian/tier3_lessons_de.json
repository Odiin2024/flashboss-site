          "",
          "BILDUNG:",
          "   Präsens von avere + Partizip Perfekt",
          "",
          "   ho parlato     = ich sprach/habe gesprochen",
          "   hai mangiato   = du aßt",
          "   ha visto       = er/sie sah",
          "   abbiamo letto  = wir lasen",
          "   avete fatto    = ihr habt getan",
          "   hanno detto    = sie sagten",
          "",
          "REGELMÄẞIGE PARTIZIPIEN:",
          "   -are → -ato    parlare → parlato",
          "   -ere → -uto    vedere → veduto (selten!)",
          "   -ire → -ito    finire → finito"
        ],
        "pronunciation": "Lezione dieci"
      },
      {
        "page": 2,
        "total_pages": 2,
