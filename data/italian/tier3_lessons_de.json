          "   sono andato/a    = ich ging (m/w)",
          "   sei venuto/a     = du kamst",
          "   è arrivato/a     = er/sie kam an",
          "   siamo partiti/e  = wir gingen (m/w pl)",
          "   siete usciti/e   = ihr gingt hinaus",
          "   sono nati/e      = sie wurden geboren",
          "",
          "WELCHE VERBEN VERWENDEN ESSERE?",
          "",
          "Meist Bewegungs- und Zustandsverben:",
          "   andare, venire, arrivare, partire,",
          "   uscire, entrare, salire, scendere,",
          "   tornare, stare, restare,",
          "   nascere, morire, diventare,",
          "   essere selbst: sono stato (ich war)"
        ],
        "pronunciation": "Lezione dodici"
      },
