          "",
          "   fare       → fatto       (getan/ gemacht)",
          "   dire       → detto       (gesagt)",
          "   vedere     → visto       (gesehen)",
          "   leggere    → letto       (gelesen)",
          "   scrivere   → scritto     (geschrieben)",
          "   prendere   → preso       (genommen)",
          "   mettere    → messo       (gestellt/ gelegt)",
          "   aprire     → aperto      (geöffnet)",
          "   chiudere   → chiuso      (geschlossen)",
