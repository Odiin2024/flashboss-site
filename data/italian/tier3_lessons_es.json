    "header_color": "green",
    "pages": [
      {
        "page": 1,
        "total_pages": 2,
        "content": [
          "VERBOS MODALES — seguidos de infinitivo.",
          "",
          "VOLERE (querer):",
          "   voglio  vuoi  vuole  vogliamo",
          "   volete  vogliono",
          "   voglio mangiare = quiero comer",
          "",
          "POTERE (poder / ser capaz):",
          "   posso  puoi  può  possiamo",
          "   potete  possono",
          "   posso uscire? = ¿puedo salir?",
          "",
          "DOVERE (deber / tener que):",
          "   devo  devi  deve  dobbiamo",
          "   dovete  devono",
          "   devo studiare = debo estudiar",
          "",
          "Los tres: [modal] + [infinitivo]."
        ],
        "pronunciation": "Lezione tredici"
      },
      {
        "page": 2,
        "total_pages": 2,
        "content": [
          "SAPERE (saber cómo / saber):",
          "",
          "   so      sappiamo",
          "   sai     sapete",
          "   sa      sanno",
          "",
          "   so nuotare = sé nadar (modal)",
          "   so la risposta = sé la respuesta",
          "",
          "SAPERE vs CONOSCERE:",
          "   sapere = hechos, info, cómo hacer",
          "   conoscere = personas, lugares",
          "   conosco Roma; so dov'è.",
          "",
          "PASADO PERFECTO de modales:",
          "   ho voluto, ho potuto, ho dovuto,",
          "   ho saputo. La mayoría usa avere.",
          "NEGACIÓN: 'non' antes del modal."
        ]
      }
    ]
  },
