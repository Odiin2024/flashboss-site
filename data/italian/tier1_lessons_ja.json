        "pronunciation": "Lezione uno",
        "pronunciation_mappings": {
          "1": "casa. mamma. gatto",
          "2": "bene. sera. leggere",
          "3": "sì. vita. libro",
          "4": "sole. modo. otto",
          "5": "tu. uno. frutto"
        }
      },
      {
        "page": 2,
        "total_pages": 5,
        "content": [
