          "",
          "a =「アー」father の a             1を押す",
          "   casa, mamma, gatto",
          "",
          "e =「エ」bet の e                  2を押す",
          "   bene, sera, leggere",
          "",
          "i =「イー」machine の i            3を押す",
          "   sì, vita, libro",
          "",
          "o =「オー」no の o                 4を押す",
          "   sole, modo, otto",
          "",
          "u =「ウー」moon の u               5を押す",
          "   tu, uno, frutto"
