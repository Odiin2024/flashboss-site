          "",
          "   h = 常に無音                    1を押す",
          "      hai, ho, hanno",
          "",
          "   c + a/o/u = 硬い「ク」          2を押す",
          "      casa, come, cucina",
          "",
          "   c + e/i = 柔らかい「チ」        3を押す",
          "      cena, città, dolce",
          "",
          "   g + a/o/u = 硬い「グ」          4を押す",
          "      gatto, gusto, lago",
          "",
          "   g + e/i = 柔らかい「ジ」        5を押す",
          "      gente, gelato, magia",
          "",
          "r は常に巻き舌または弾き音です。"
        ],
        "pronunciation_mappings": {
          "1": "hai. ho. hanno",
          "2": "casa. come. cucina",
          "3": "cena. città. dolce",
          "4": "gatto. gusto. lago",
          "5": "gente. gelato. magia"
        }
      },
      {
        "page": 3,
        "total_pages": 5,
        "content": [
          "二重字 — 2 文字で 1 つの音:",
          "",
          "   ch = e/i の前で硬い「ク」       1を押す",
          "      chiave, perché, anche",
          "",
          "   gh = e/i の前で硬い「グ」       2を押す",
          "      spaghetti, ghiaccio, lunghi",
          "",
          "   gli = million の lli の音       3を押す",
          "      famiglia, figlio, gli",
          "",
          "   gn = canyon の ny の音          4を押す",
          "      gnocchi, lasagna, ogni",
          "",
          "   sc + e/i =「シュ」              5を押す",
          "      sciare, pesce, scena",
          "",
          "それ以外の sc は「スク」: scuola, scopo。"
        ],
        "pronunciation_mappings": {
          "1": "chiave. perché. anche",
          "2": "spaghetti. ghiaccio. lunghi",
          "3": "famiglia. figlio. gli",
          "4": "gnocchi. lasagna. ogni",
          "5": "sciare. pesce. scena"
        }
      },
      {
        "page": 4,
