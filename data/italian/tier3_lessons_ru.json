          "PASSATO PROSSIMO = прошедшее время",
          "законченных действий (я сделал / уже сделал).",
          "",
          "ОБРАЗОВАНИЕ:",
          "   avere в настоящем + причастие прошедшее",
          "",
          "   ho parlato     = я говорил / поговорил",
          "   hai mangiato   = ты поел",
          "   ha visto       = он/она увидел(а)",
          "   abbiamo letto  = мы прочитали",
          "   avete fatto    = вы сделали",
          "   hanno detto    = они сказали",
          "",
          "ПРАВИЛЬНЫЕ ПРИЧАСТИЯ:",
          "   -are → -ato    parlare → parlato",
          "   -ere → -uto    vedere → veduto (редко!)",
          "   -ire → -ito    finire → finito"
        ]
      },
      {
        "page": 2,
        "total_pages": 2,
        "content": [
          "ЧАСТЫЕ НЕПРАВИЛЬНЫЕ ПРИЧАСТИЯ:",
          "",
          "   fare       → fatto       (сделал)",
          "   dire       → detto       (сказал)",
          "   vedere     → visto       (увидел)",
          "   leggere    → letto       (прочитал)",
          "   scrivere   → scritto     (написал)",
          "   prendere   → preso       (взял)",
          "   mettere    → messo       (положил)",
          "   aprire     → aperto      (открыл)",
          "   chiudere   → chiuso      (закрыл)",
          "   bere       → bevuto      (выпил)",
          "   chiedere   → chiesto     (спросил)",
          "   rispondere → risposto    (ответил)",
          "   vincere    → vinto       (победил)",
          "   perdere    → perso       (проиграл)",
          "   conoscere  → conosciuto  (узнал)"
        ]
      }
    ]
