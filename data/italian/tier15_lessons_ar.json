          "\u200e   vedere    vidi     vide      videro",
          "\u200e   venire    venni    venne     vennero",
          "\u200e   nascere   nacqui   nacque    nacquero",
          "\u200e   dare      diedi    diede     diedero",
          "\u200e   stare     stetti   stette    stettero",
          "",
